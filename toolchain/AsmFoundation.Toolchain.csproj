<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Packs AsmFoundation.Toolchain.<ToolchainRid> from artifacts/toolchain/<rid>/tools/, which
    toolchain/fetch.cs stages. One package per build machine OS/architecture:
        dotnet pack toolchain/AsmFoundation.Toolchain.csproj -p:ToolchainRid=win-x64
    Every package produces the same output (every RID AsmFoundation.Sdk builds: Windows, Linux
    and macOS, x64 and ARM64); the package's RID only says where the tools themselves run. The
    SDK downloads the matching one with a PackageDownload.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ToolchainRid Condition="'$(ToolchainRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</ToolchainRid>
    <PackageId>AsmFoundation.Toolchain.$(ToolchainRid)</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CS2008: nothing to compile (the package is files only). -->
    <NoWarn>$(NoWarn);NU5128;NU5100;CS2008</NoWarn>
    <!-- A build tool, not a dependency: never flows to consumers of a project that has it. -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageTags>assembly;nasm;llvm-mc;lld;llvm;toolchain;asmproj;arm64;x64</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The AsmFoundation A (src/icon.png), as on every package of this repository. A change here changes the
         package, so it reaches nuget.org only with the next packageVersion in versions.json: a release that
         keeps the version skips the toolchain packages as duplicates, icon or not. -->
    <PackageIcon>icon.png</PackageIcon>
    <_ToolchainVersionsJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)versions.json'))</_ToolchainVersionsJson>
    <!-- The toolchain's own version (versions.json "packageVersion"), not the SDK's. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(_ToolchainVersionsJson), '"packageVersion"\s*:\s*"([^"]+)"').Result('$1'))</Version>
    <_NasmVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ToolchainVersionsJson), '"nasm"\s*:\s*\{\s*"version"\s*:\s*"([^"]+)"').Result('$1'))</_NasmVersion>
    <_LlvmVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ToolchainVersionsJson), '"llvm"\s*:\s*\{\s*"version"\s*:\s*"([^"]+)"').Result('$1'))</_LlvmVersion>
    <Description>The assembler and linker AsmFoundation.Sdk runs on $(ToolchainRid) build machines: NASM $(_NasmVersion), plus llvm-mc, lld (ld.lld, lld-link and ld64.lld), llvm-ar and llvm-readobj from LLVM $(_LlvmVersion). Builds Windows, Linux and macOS output for x64 and ARM64 from any of these build machines. Downloaded automatically by AsmFoundation.Sdk; not meant to be referenced directly.</Description>
    <!-- Three licenses apply (NASM BSD-2-Clause, LLVM Apache-2.0 WITH LLVM-exception, the
         packaging Apache-2.0); an SPDX expression states them exactly. -->
    <PackageLicenseExpression>BSD-2-Clause AND Apache-2.0 WITH LLVM-exception AND Apache-2.0</PackageLicenseExpression>
    <_ToolsDirectory>$(MSBuildThisFileDirectory)../artifacts/toolchain/$(ToolchainRid)/tools/</_ToolsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(_ToolsDirectory)**" Pack="true" PackagePath="tools/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../src/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Fail with the fix instead of packing an empty toolchain. -->
  <Target Name="CheckStagedTools" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <Error Condition="!Exists('$(_ToolsDirectory)VERSIONS.txt')"
           Text="No staged toolchain in $(_ToolsDirectory). Run: dotnet run toolchain/fetch.cs -- --rid $(ToolchainRid)" />
  </Target>
</Project>
