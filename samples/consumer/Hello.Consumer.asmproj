<Project Sdk="AsmFoundation.Sdk">
  <!--
    Consumes Hello.Static as a NuGet package, by version, the way an asm library is meant to
    be shared: the package's build/netstandard1.0/Hello.Static.props (freestanding) adds its
    include/ folder and its native/linux-x64/freestanding/libhellostatic.a to this project.
    Kept out of Samples.slnx because the package must be packed (tests/run.py does it) before
    this project can restore. Builds bin/<Configuration>/freestanding/hello-consumer.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>hello-consumer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hello.Static" Version="1.0.0" />
  </ItemGroup>
</Project>
