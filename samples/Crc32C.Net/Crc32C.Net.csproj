<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Crc32C.Net: the C# face of libcrc32c. The ProjectReference builds the .asmproj for its seven
    RIDs first; a project that uses this one (the tests, the benchmark) gets every RID's library
    under runtimes/<rid>/native/ and listed in its deps.json, through AsmSdk's consumer targets
    (no assembly reference is added). Built with -r, it gets the one library for that RID.

    dotnet pack gives Samples.Crc32C.Net.1.0.0.nupkg: the managed assembly under lib/net10.0/,
    and a dependency on Samples.Crc32C 1.0.0, the package of the .asmproj, which carries the
    native library of each RID under runtimes/<rid>/native/. A .NET program that references
    Samples.Crc32C.Net by version gets both, as samples/consumers/Crc32C.App shows. This is the
    usual split for native code in NuGet (a managed package over a native one).
    Runs on Windows, Linux (glibc and musl) and macOS, x64 and ARM64.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>Samples.Crc32C.Net</AssemblyName>
    <RootNamespace>Samples.Hashing</RootNamespace>
    <PackageId>Samples.Crc32C.Net</PackageId>
    <Version>1.0.0</Version>
    <Authors>AsmFoundation samples</Authors>
    <Description>Sample: CRC-32C for .NET, computed by an x86-64 assembly library (Samples.Crc32C).</Description>
    <!-- This wrapper declares its imports itself: it calls crc32c_append two ways, without the GC
         transition up to 4 KiB and with it above, which one PROTO line per function cannot say.
         So the generated bindings, which the library's PROTO lines give every C# project that
         references it (the benchmark times them), are off here. -->
    <AsmGenerateBindings>false</AsmGenerateBindings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Crc32C/Crc32C.asmproj" />
  </ItemGroup>
</Project>
