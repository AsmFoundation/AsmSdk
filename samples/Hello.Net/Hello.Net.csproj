<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A .NET program that P/Invokes two assembly shared libraries built by AsmFoundation.Sdk.
    The ProjectReferences build the .asmproj projects first and copy libhello.so and
    libhellolibc.so next to Hello.Net.dll; no assembly reference is added. Runs on Linux x64.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hello.Library/Hello.Library.asmproj" />
    <ProjectReference Include="../Hello.LibcLibrary/Hello.LibcLibrary.asmproj" />
  </ItemGroup>
</Project>
