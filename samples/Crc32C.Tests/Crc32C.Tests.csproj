<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Crc32C.Tests: unit tests of an assembly library, written in C# with xunit v3. They call
    libcrc32c through Crc32C.Net and compare every path with a reference written in C#.

    xunit v3 test projects are executables (Microsoft.Testing.Platform): the tests run with
    "dotnet test" or by starting the built program, which needs only the .NET runtime, on any of
    the eight platforms: the portable output carries every platform's build of the library under
    runtimes/<rid>/native/, and the .NET host loads the one for the machine it runs on.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Samples.Hashing.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Crc32C.Net/Crc32C.Net.csproj" />
  </ItemGroup>
</Project>
