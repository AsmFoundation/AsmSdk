<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The SDK, the toolchain and the sample library come from the local feed that the
       end-to-end tests (tests/AsmSdk.Tests) fill; everything else from nuget.org. -->
  <packageSources>
    <clear />
    <add key="local" value="../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="AsmFoundation.*" />
      <package pattern="Hello.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
