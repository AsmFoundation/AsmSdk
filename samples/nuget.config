<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The SDK, the toolchain and the sample packages (Hello.Static, Samples.Crc32C and
       Samples.Crc32C.Net) come from the local feed that the end-to-end tests
       (tests/AsmSdk.Tests) fill; everything else from nuget.org. -->
  <packageSources>
    <clear />
    <add key="local" value="../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="AsmFoundation.*" />
      <package pattern="Hello.*" />
      <package pattern="Samples.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
