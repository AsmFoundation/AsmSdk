<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Crc32C.Bench: BenchmarkDotNet timings of libcrc32c's three paths against the CRC-32C a C#
    developer writes first (BitOperations.Crc32C over 8-byte words), at 64 B, 1 KiB, 64 KiB and
    1 MiB, with a GB/s column. Run it on any of the eight platforms in Release, from this folder: "dotnet run -c
    Release" (the docs' Crc32C example has the full commands; an XML comment cannot hold their
    double dashes). Before timing anything, it checks that every path returns the managed
    checksum; its check option does only that, for CI. Its cores option (Cores.cs) times the C#
    loop and the assembly on one core and on several at once, each thread pinned to a core of its
    own, which BenchmarkDotNet's one-thread jobs cannot do.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CallBenchmarks passes a null byte* to measure a call with nothing to do. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Samples.Hashing.Bench</RootNamespace>
    <!-- BenchmarkDotNet reads the PDB to name the benchmarks' source lines. -->
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Crc32C.Net/Crc32C.Net.csproj" />
  </ItemGroup>
</Project>
