// Crc32C from Go through cgo: samples/Crc32C's assembly library. No dependencies; README.md has
// the steps. cgo needs a C compiler (gcc or clang) on PATH. The code needs nothing newer than
// 1.21, the first release whose go command enforces this line as a minimum.
module github.com/AsmFoundation/AsmSdk/samples/callers/go

go 1.21
