<Project Sdk="AsmFoundation.Sdk">
  <!--
    Crc32C: CRC-32C (Castagnoli) in assembly, shipped the way a .NET team ships a hot routine
    in native code: a freestanding shared library, bin/<Configuration>/freestanding/libcrc32c.so,
    with no DT_NEEDED at all, so it loads into any Linux x64 process.

    What it shows:
      - ExportsFile (crc32c.map): five names leave the library, versioned CRC32C_1.0, and every
        other label stays local;
      - a LinkerArg item: -z defs fails the link if anything is left undefined;
      - run-time dispatch with cpuid, constants and a table computed by NASM's preprocessor,
        and a 3-way SSE4.2 + PCLMULQDQ kernel (crc32c.asm explains each);
      - packing for .NET: dotnet pack gives Samples.Crc32C.1.0.0.nupkg with the library under
        runtimes/linux-x64/native/, where .NET finds it; Crc32C.Net wraps it for C#.
  -->
  <PropertyGroup>
    <AssemblyName>crc32c</AssemblyName>
    <ExportsFile>crc32c.map</ExportsFile>
    <PackageId>Samples.Crc32C</PackageId>
    <Version>1.0.0</Version>
    <Authors>AsmFoundation samples</Authors>
    <Description>Sample: CRC-32C in x86-64 assembly (SSE4.2 + PCLMULQDQ), a freestanding shared library.</Description>
  </PropertyGroup>
  <ItemGroup>
    <LinkerArg Include="-z defs" />
  </ItemGroup>
</Project>
