<Project Sdk="AsmFoundation.Sdk">
  <!--
    Crc32C: CRC-32C (Castagnoli) in assembly, shipped the way a .NET team ships a hot routine
    in native code: a freestanding shared library for all eight native runtime identifiers
    AsmSdk builds, with no dependency at all (no DT_NEEDED, no DLL imports), so it loads into
    any process on Windows, Linux (glibc or musl) and macOS, x64 and ARM64:
      bin/<Configuration>/freestanding/<rid>/crc32c.dll, libcrc32c.so or libcrc32c.dylib
    and a WebAssembly module plus its static library for the two wasm RIDs (browser-wasm,
    wasi-wasm), which a .NET WebAssembly app links in (Crc32C.Browser):
      bin/<Configuration>/freestanding/<wasm rid>/crc32c.wasm and crc32c.a

    What it shows:
      - one project, three languages: crc32c.asm (NASM) builds the x64 RIDs through the SDK's
        asmsdk.inc (ARG1..ARG3 are rcx, rdx, r8 on Windows and rdi, rsi, rdx elsewhere),
        crc32c.s (GNU syntax, llvm-mc) builds the ARM64 RIDs through asmsdk-gnu.inc, and
        crc32c.wasm.s (llvm-mc's WebAssembly syntax) builds the wasm RIDs through
        asmsdk-wasm.inc: one table path there (slicing-by-8), since WebAssembly has neither a
        CRC instruction nor a carry-less multiply;
      - ExportsFile (crc32c.map): five names leave the library on every OS (versioned
        CRC32C_1.0 on Linux), and every other label stays local;
      - PROTO lines: each export's C prototype, above its FUNCTION in all three sources. The SDK
        checks them against the functions on every RID (the wasm RIDs against each function's
        wasm type), and a C# project that references the library, or its package, gets its
        bindings with nothing written: Crc32c.Crc32c.Crc32cAppend, with a span overload
        (Crc32C.Bench times it against Crc32C.Net's hand-written [LibraryImport]);
      - a LinkerArg item for one OS: -z defs fails a Linux link if anything is left undefined;
      - run-time dispatch (cpuid on x64; ID_AA64ISAR0_EL1 on Linux ARM64, kernel32's
        IsProcessorFeaturePresent on Windows ARM64, every Apple silicon Mac has the
        instructions), constants and a table computed at assembly time, and a 3-way kernel
        merged by carry-less multiplication (PCLMULQDQ on x64, PMULL on ARM64);
      - packing for .NET: dotnet pack gives Samples.Crc32C.1.0.0.nupkg with each RID's library
        under runtimes/<rid>/native/, where .NET finds it, and the wasm module and archive
        under native/<wasm rid>/freestanding/ (a wasm app links the archive at publish, it
        loads nothing at run time); Crc32C.Net wraps it for C#.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;browser-wasm;wasi-wasm</RuntimeIdentifiers>
    <AssemblyName>crc32c</AssemblyName>
    <ExportsFile>crc32c.map</ExportsFile>
    <PackageId>Samples.Crc32C</PackageId>
    <Version>1.0.0</Version>
    <Authors>AsmFoundation samples</Authors>
    <Description>Sample: CRC-32C in assembly (x64: SSE4.2 + PCLMULQDQ; ARM64: CRC32 + PMULL; WebAssembly: slicing-by-8), a freestanding shared library for Windows, Linux and macOS, and a WebAssembly module.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- ld.lld's syntax, so Linux only: lld-link and ld64.lld spell their options differently. -->
    <LinkerArg Include="-z defs" Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>
</Project>
