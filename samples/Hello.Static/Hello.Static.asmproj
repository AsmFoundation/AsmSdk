<Project Sdk="AsmFoundation.Sdk">
  <!--
    A static library with public include files, also packed as a NuGet package that
    Hello.Consumer references by version: bin/<Configuration>/libhellostatic.a, and with
    dotnet pack, Hello.Static.1.0.0.nupkg (include/, native/linux-x64/, build/).
  -->
  <PropertyGroup>
    <OutputType>StaticLibrary</OutputType>
    <AsmLibraryName>hellostatic</AsmLibraryName>
    <PackageId>Hello.Static</PackageId>
    <Version>1.0.0</Version>
    <Authors>AsmFoundation samples</Authors>
    <Description>Sample static assembly library for AsmFoundation.Sdk.</Description>
  </PropertyGroup>
</Project>
