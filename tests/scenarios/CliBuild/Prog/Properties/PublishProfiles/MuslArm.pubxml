<Project>
  <!--
    A publish profile, as Visual Studio writes them: dotnet publish -p:PublishProfile=MuslArm.
    Its RuntimeIdentifier must decide what is built (the SDK imports the profile before it picks
    the RIDs), and its PublishDir where the program goes.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>linux-musl-arm64</RuntimeIdentifier>
    <PublishDir>$(MSBuildProjectDirectory)/../out/profile/</PublishDir>
  </PropertyGroup>
</Project>
