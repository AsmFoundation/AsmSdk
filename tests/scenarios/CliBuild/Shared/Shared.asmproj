<Project Sdk="AsmFoundation.Sdk">
  <!--
    CliBuild's static library: mul_ints, from the asmstatic template (mul.asm for x64, mul.s for
    ARM64), declared for its users in include/Shared.inc. It names no RID: it is built for the
    RID of each program that links it, which reaches it from that program's build, whether the
    program got its RID from -r, from its own project (ProgMusl) or from a publish profile (Prog).
  -->
  <PropertyGroup>
    <OutputType>StaticLibrary</OutputType>
  </PropertyGroup>
</Project>
