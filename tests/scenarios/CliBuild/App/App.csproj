<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CliBuild's C# app: calls Lib's add_ints through the binding the SDK writes from its PROTO
    line (Lib.Add.AddInts). It must find the library wherever the switches put the build: bin/,
    an artifacts path, a build of the app alone with no dependencies built.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Lib/Lib.asmproj" />
  </ItemGroup>
</Project>
