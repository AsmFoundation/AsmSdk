<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CliSolution's C# app: calls Lib's add_ints through the generated binding. dotnet sln add puts
    it into a classic .sln beside the asm projects, dotnet reference list shows its reference to
    the .asmproj, and dotnet format checks its code while skipping the asm projects.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Lib/Lib.asmproj" />
  </ItemGroup>
</Project>
