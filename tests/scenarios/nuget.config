<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The SDK and the toolchain under test, and the packages a scenario packs itself
       (Scenario.*), come from the local feed that tests/AsmSdk.Tests fills; everything else
       (NumSharp, OptunaSharp, KvAsm.Client, xunit) from nuget.org. The path is relative to this
       file, which works both here and in the copy under artifacts/scenarios (same depth). -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="AsmFoundation.*" />
      <package pattern="Scenario.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
