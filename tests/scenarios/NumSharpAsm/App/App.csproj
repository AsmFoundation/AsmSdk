<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A NumSharp app whose arrays' memory goes to asm kernels (../Kernels): NumSharp from
    nuget.org (the version is central, in Directory.Packages.props) beside an asm
    ProjectReference, in one build, one run and one publish.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NumSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Kernels/Kernels.asmproj" />
  </ItemGroup>
</Project>
