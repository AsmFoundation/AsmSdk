<Project Sdk="AsmFoundation.Sdk">
  <!--
    CliPack's tool: the asm-echo program (echo.asm for x64, echo.s for ARM64) packed as a .NET
    tool for the eight native RIDs: the top-level package Scenario.CliPackTool and one
    Scenario.CliPackTool.<rid> per RID, each with its program. The scenario also packs it with
    -p:PackageId=Scenario.CliPackToolCli on the command line, where every RID package must still
    get its own id, and runs it through a local tool manifest and dotnet tool exec.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>libc</TargetFramework>
    <AssemblyName>asm-echo</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>asm-echo</ToolCommandName>
    <PackageId>Scenario.CliPackTool</PackageId>
    <Version>1.0.0</Version>
    <Authors>AsmFoundation tests</Authors>
    <Description>Scenario package: an assembly program as a .NET tool that prints its arguments.</Description>
  </PropertyGroup>
</Project>
