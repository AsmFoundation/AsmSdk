<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CliPack's C# app, with no reference of its own: the scenario adds Scenario.CliPackLib with
    dotnet package add, runs the app (the package's library and its C# bindings arrive with
    it), lists and explains the reference (dotnet package list, dotnet nuget why), then removes it.
    Its version comes from the scenarios' Directory.Packages.props, which the add writes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
