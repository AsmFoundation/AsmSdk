<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A console app that calls the asm library calc (../Calc) through [LibraryImport]. The
    ProjectReference is all it takes: a portable build gets every RID's library under
    runtimes/<rid>/native/ (listed in deps.json), a RID-specific build or publish the one
    library next to the app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Calc/Calc.asmproj" />
  </ItemGroup>
</Project>
