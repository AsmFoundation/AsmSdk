<Project Sdk="Microsoft.NET.Sdk">
  <!--
    An OptunaSharp study that minimizes a function computed in asm (../Objective). OptunaSharp
    comes from nuget.org with NumSharp and NumSharp.Interop.OpenBLAS, whose native OpenBLAS
    libraries sit under runtimes/ beside the asm library's: two native layouts in one app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OptunaSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Objective/Objective.asmproj" />
  </ItemGroup>
</Project>
