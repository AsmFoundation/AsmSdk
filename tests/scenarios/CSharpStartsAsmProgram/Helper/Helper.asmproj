<Project Sdk="AsmFoundation.Sdk">
  <!--
    asm-helper: a libc program for all eight RIDs that the C# app (App) delivers and starts as a
    helper process. main prints its last argument with puts and returns 40 + argc, so one
    argument gives exit status 42: proof that the arguments arrived.
  -->
  <PropertyGroup>
    <TargetFramework>libc</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>asm-helper</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
