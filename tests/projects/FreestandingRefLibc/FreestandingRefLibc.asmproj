<Project Sdk="AsmFoundation.Sdk">
  <!--
    Expected to FAIL at restore with NU1201: a freestanding program cannot link code built for
    libc, and NuGet says so because freestanding stands for netstandard1.0 and libc for
    netstandard2.0. Hello.LibcLibrary targets libc only.
  -->
  <PropertyGroup>
    <!-- Linux x64 code (System V calls, Linux system calls or glibc), checked as ELF. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../samples/Hello.LibcLibrary/Hello.LibcLibrary.asmproj" />
  </ItemGroup>
</Project>
