<Project Sdk="AsmFoundation.Sdk">
  <!--
    A second asm package with C# bindings (PackageBindingsTests), Test.BindingsPackageB 1.0.0:
    one function, mul_ints(a, b) in mul.asm / mul.s, so that a consumer of two packages (and an
    asm ProjectReference) shows one bindings generator for every library. The test packs it with
    -p:_AsmPackBindingsGeneratorVersion=9.9.9: its generator copy (the same file) then claims a
    newer version than every other one, and the shared pick must choose this package's copy.
  -->
  <PropertyGroup>
    <AssemblyName>bindpkgb</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PackageId>Test.BindingsPackageB</PackageId>
    <Version>1.0.0</Version>
    <Authors>AsmFoundation tests</Authors>
    <Description>Test package: a second assembly library with C# bindings, for eight runtime identifiers.</Description>
  </PropertyGroup>
</Project>
