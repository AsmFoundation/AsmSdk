<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ApiProto's baseline shaped by the project file alone (BindingsTests): no attribute anywhere,
    so the SDK writes the baseline (no generator), following the AsmBindings* properties (an
    environment variable of the same name would do the same) and the library's AsmBindings item:
      properties   ClassKind Instance, Visibility Public, Sealed true
      the item     Namespace Shapes.Native, Nesting Flat (every function in Shapes.Native.Api)
    The program prints what the baseline is: an instance call, and the class's shape.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AsmBindingsClassKind>Instance</AsmBindingsClassKind>
    <AsmBindingsVisibility>Public</AsmBindingsVisibility>
    <AsmBindingsSealed>true</AsmBindingsSealed>
  </PropertyGroup>
  <ItemGroup>
    <AsmBindings Include="apiproto" Namespace="Shapes.Native" Nesting="Flat" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ApiProto/ApiProto.asmproj" />
  </ItemGroup>
</Project>
