<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A .NET browser-wasm app that takes WasmLibrary as a PACKAGE (WebAssemblyTests): the test packs
    tests/projects/WasmLibrary into the local feed as Test.WasmLibrary 1.0.0 first. The package's
    generated props give a WebAssembly app its archive, native/browser-wasm/freestanding/wasmlib.a,
    as a NativeFileReference with the P/Invoke module "wasmlib": a package works without
    AsmFoundation.Sdk, which a .NET app does not get from a package. The archive also holds the
    static library WasmLibrary links privately (WasmStatic's ws_mul), which the package neither
    carries nor depends on. It prints
      "<RuntimeIdentifier> <wl_add(40, 2)> <wl_twice(21)> <wl_platform()> <wl_table_sum()> <wl_simd(21)> <ws_mul(6, 7)>"
    which the Release package answers "browser-wasm 42 42 111 42 42 42".
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>../WasmBrowserApp/main.mjs</WasmMainJSPath>
    <!-- A test program: tests/projects/Directory.Build.props sends packages to the local feed,
         which this one never is. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Test.WasmLibrary" Version="1.0.0" />
  </ItemGroup>
</Project>
