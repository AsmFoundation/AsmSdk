<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The interop tour (InteropTests), part 5 of 5: the self-checking console app. It references the asm projects only through Qa.Interop
    (a transitive asm reference), runs every technique against a C# reference, prints PASS/FAIL
    per check, and exits with the number of failures, so the same build serves every platform.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>asmqa</AssemblyName>
    <RootNamespace>AsmQa.App</RootNamespace>
    <!-- A test program: tests/projects/Directory.Build.props sends packages to the local
         feed, which this one never is. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Qa.Interop/Qa.Interop.csproj" />
  </ItemGroup>
</Project>
