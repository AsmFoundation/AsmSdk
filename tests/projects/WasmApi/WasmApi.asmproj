<Project Sdk="AsmFoundation.Sdk">
  <!--
    A library of native and WebAssembly RIDs with PROTO lines for the C# bindings
    (WebAssemblyTests): add.asm for linux-x64, add.wasm.s for browser-wasm, each with the same
    PROTO line, as one API for every RID requires (ASM0133, the owner's choice of 2026-11-24).
    The SDK reads the records of both RIDs' objects (the wasm ones from the object's "asmapi"
    custom section) and writes wasmapi.api.json in linux-x64/, in browser-wasm/ and, merged, in
    bin/Release/freestanding/. The module keeps the records: Node reads them back with
    WebAssembly.Module.customSections. WasmBindingsApp, a .NET browser-wasm app, calls the
    function through the bindings generated from browser-wasm's API file.
  -->
  <PropertyGroup>
    <AssemblyName>wasmapi</AssemblyName>
    <RuntimeIdentifiers>linux-x64;browser-wasm</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
