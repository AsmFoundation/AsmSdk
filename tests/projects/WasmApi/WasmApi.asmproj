<Project Sdk="AsmFoundation.Sdk">
  <!--
    A library of native and WebAssembly RIDs whose native sources carry PROTO lines for the C#
    bindings (WebAssemblyTests): add.asm for linux-x64, add.wasm.s for browser-wasm, which
    defines the same function and, as WebAssembly sources must for now, no PROTO line. The SDK
    reads the API records from linux-x64's objects only (it reads COFF, ELF and Mach-O, not
    wasm) and merges the API file from the RIDs that can declare: wasmapi.api.json in
    bin/Release/freestanding/ and in linux-x64/, none in browser-wasm/. Before the WebAssembly
    RIDs were left out, the browser-wasm build stopped reading its wasm objects (ASM0135), and
    the merge would have found every function missing there (ASM0133).
  -->
  <PropertyGroup>
    <AssemblyName>wasmapi</AssemblyName>
    <RuntimeIdentifiers>linux-x64;browser-wasm</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
