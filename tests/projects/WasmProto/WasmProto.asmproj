<Project Sdk="AsmFoundation.Sdk">
  <!--
    A PROTO line inside a function body (WebAssemblyTests). llvm-mc's wasm parser cannot return
    to the section it left, so a record written there would take the rest of the body with it
    (measured: the module linked, the function had lost its end). asmsdk-wasm.inc's guard stops
    it instead: "answer has no ENDFUNCTION yet", with the line in the "while in macro
    instantiation" note.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>browser-wasm</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
