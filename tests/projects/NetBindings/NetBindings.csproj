<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A C# program that calls the asm library ApiProto through its baseline alone (BindingsTests):
    no [LibraryImport] written by hand, and no AllowUnsafeBlocks either (the consumer targets set
    it when there are bindings). The baseline is the namespace Apiproto (the library's name), a
    class per .asm file, folders as namespaces (Apiproto.Simd.Sum); a function named like its file
    is Invoke. The SDK writes it (obj/.../AsmBindings/Apiproto.g.cs): this project never mentions
    the attribute, so no generator runs. It prints one line per function:
      add_ints 42 / answer 42 / halve 2.5 / name_length 5 / sum_bytes 10 / apply 42
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A test program: tests/projects/Directory.Build.props sends packages to the local feed,
         which this one never is. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ApiProto/ApiProto.asmproj" />
  </ItemGroup>
</Project>
