<Project Sdk="AsmFoundation.Sdk">
  <!--
    A libc shared library linked with NativeAOT's names for extra link input: ExportsFile (the
    version script) and a LinkerArg item. ProjectRuleTests (tests/AsmSdk.Tests) checks that
    only exported_fn is in the dynamic symbol table, versioned EXPORTS_1.0, that internal_fn is
    not, and that the LinkerArg -z nodelete set DF_1_NODELETE; IdeIntegrationTests reads its IDE items and
    replays an IDE's design-time build on it.
  -->
  <PropertyGroup>
    <!-- Linux x64 code (System V calls, Linux system calls or glibc), checked as ELF. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <TargetFramework>libc</TargetFramework>
    <AssemblyName>exports</AssemblyName>
    <ExportsFile>exports.map</ExportsFile>
  </PropertyGroup>
  <ItemGroup>
    <LinkerArg Include="-z nodelete" />
  </ItemGroup>
</Project>
