<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A .NET program that references the asm PROGRAM EverywhereProgram (ProgramTests): the helper
    process case. The reference delivers the program with the library it links, for every RID
    in a portable build (runtimes/<rid>/native/ by default) or the one RID of a RID-specific
    build (next to the app), placed by BinariesCopyPath on the reference (NetProgramFolder from
    the command line), and listed in deps.json. Program.cs finds it where the .NET host's native
    search folders say, starts it with one argument, and returns its exit status.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EverywhereProgram/EverywhereProgram.asmproj" BinariesCopyPath="$(NetProgramFolder)" />
  </ItemGroup>
</Project>
