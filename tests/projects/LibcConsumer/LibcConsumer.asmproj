<Project Sdk="AsmFoundation.Sdk">
  <!--
    A libc program that consumes the libc-only package Test.LibcOnly by version. The package
    has no static library, so the consumer links its shared library: ProjectRuleTests
    (tests/AsmSdk.Tests) checks DT_NEEDED libtestlibconly.so, and RunTests runs the program
    where Linux is available.
  -->
  <PropertyGroup>
    <TargetFramework>libc</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>libc-consumer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Test.LibcOnly" Version="1.0.0" />
  </ItemGroup>
</Project>
