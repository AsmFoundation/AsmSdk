<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The [AsmLibrary] attribute at every level, over the asm library ApiProto (BindingsTests). The
    project mentions the attribute, so the generator runs (the switch) and writes both sets:
      [assembly: AsmLibrary(SpanOverloads = false)]       the copies' default: no span overloads
      [assembly: AsmLibrary("apiproto", DefaultNamespace = "Proto", DefaultNesting = Folders,
                 DefaultClassKind = Instance, DefaultVirtual = true, DefaultVisibility = ProtectedInternal)]
                                                          the baseline: Proto.Api (root files),
                                                          Proto.Simd, instantiable and virtual
      Text       Files = ["strings.asm"], Visibility = Public     a copy, public
      Vector     Folder = "simd", SpanOverloads = true            a copy of a folder; spans back on
      NoSpans    Files = ["simd/sum"], AliasBinding = true        a second copy; inherits "no spans"
      MathA      Files = ["add"]                                  a copy
      MathB      Files = ["add"], AliasBinding = true             add again, allowed
      Calculator Files = ["add"], AliasBinding, Virtual = true    a non-static class: instance copies
    FixedApi and FixedCalculator override a virtual binding. The program prints what each offers;
    BindingsTests compares the lines.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ApiProto/ApiProto.asmproj" />
  </ItemGroup>
</Project>
