<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The [AsmLibrary] attribute at every level, over the asm library ApiProto (BindingsTests):
      [assembly: AsmLibrary(SpanOverloads = false)]                      every library: no spans
      [assembly: AsmLibrary("apiproto", ClassName = "Proto", Nesting = AsmNesting.Folders)]
                                                                         the default class
      Text    Files = ["strings.asm"], Visibility = Public               chosen file, public
      Vector  Folder = "simd", SpanOverloads = true                      a folder; spans back on
      Alias   Files = ["add"], AliasBinding = true                       a second copy of add_ints
      NoSpans Files = ["simd/sum"], AliasBinding = true                  inherits "no spans"
    The program prints what each class offers; BindingsTests compares the lines.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ApiProto/ApiProto.asmproj" />
  </ItemGroup>
</Project>
