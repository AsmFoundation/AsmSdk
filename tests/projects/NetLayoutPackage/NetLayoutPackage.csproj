<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A .NET program that gets the asm library from packages only (NativeLayoutTests): the
    Test.NetLayoutLibrary package, packed with PrivateAssets="all" so that it carries
    Everywhere's binaries itself, and nothing that depends on AsmFoundation.Sdk. The
    PackageReference takes BinariesCopyPath from NetLayoutPackageReference: the package's own
    buildTransitive targets (plain MSBuild, no SDK) move its binaries there, the .NET SDK writes
    the new place into deps.json as localPath, and in a NativeAOT build the package's generated
    loader finds them.
    NetLayoutPackageVersion=2.0.0 (the delivery QA matrix) takes the wrapper that DEPENDS on the
    asm package Test.Everywhere instead; its binaries then come through that package, laid out
    by the BinariesCopyPath property (the PackageReference here is to the wrapper, not to the
    asm package).
    It prints the same line as NetConsumer: "<RID> 42 <ew_platform()> <ew_os()>".
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NetLayoutPackageVersion Condition="'$(NetLayoutPackageVersion)' == ''">1.0.0</NetLayoutPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Test.NetLayoutLibrary" Version="$(NetLayoutPackageVersion)" BinariesCopyPath="$(NetLayoutPackageReference)" />
  </ItemGroup>
</Project>
