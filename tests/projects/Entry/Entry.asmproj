<Project Sdk="AsmFoundation.Sdk">
  <!--
    A freestanding executable whose entry symbol is not _start: StartupObject names it, as it
    names the class whose Main starts a .NET program. ProjectRuleTests (tests/AsmSdk.Tests)
    checks that the ELF entry address is the address of entry_here, and RunTests runs it where
    Linux is available (exit code 42).
  -->
  <PropertyGroup>
    <!-- Linux x64 code (System V calls, Linux system calls or glibc), checked as ELF. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <AssemblyName>entry</AssemblyName>
    <StartupObject>entry_here</StartupObject>
  </PropertyGroup>
</Project>
