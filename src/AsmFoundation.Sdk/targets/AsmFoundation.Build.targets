<Project>
  <!--
    AsmFoundation.Build.targets - imported by Sdk.targets AFTER Microsoft.NET.Sdk's targets, so
    the targets defined here replace the managed ones of the same name (MSBuild keeps the last
    definition of a target).

    Pipeline (all of it runs inside the standard Build, as CoreCompile), once per runtime
    identifier (an inner build with RuntimeIdentifier set; see AsmFoundation.Properties.targets):
      _AsmResolveToolchain  -> locate nasm / llvm-mc / lld / llvm-ar (bundled or system), check them
      AsmPrepare            -> the sources of this RID (file-name qualifiers), object paths,
                               include and define arguments, link inputs
      AsmAssemble           -> one assembler run per source (NASM for .asm, llvm-mc for .s),
                               skipped when the object is up to date
      AsmLink               -> shared library, static library or executable from the objects,
                               with this OS's linker: ld.lld (ELF), lld-link (PE/COFF) or
                               ld64.lld (Mach-O), all three the one bundled lld binary
    Without RuntimeIdentifier (the RID outer build), CoreCompile builds each RID instead
    (_AsmBuildEachRuntimeIdentifier) and links nothing itself.

    Path convention: every path handed to a tool is computed once, as item metadata or a
    property named *ToolPath / *Argument(s), with forward slashes. A backslash right before a
    closing quote ("C:\dir\") escapes the quote under Windows command-line rules and silently
    merges two arguments; forward slashes are accepted by NASM and lld on every OS.
  -->

  <!-- The SDK's compiled tasks (tasks/netstandard2.0/AsmFoundation.Sdk.Tasks.dll), for the
       decisions plain MSBuild expresses badly. netstandard2.0 so that both the .NET SDK's
       MSBuild and Visual Studio's load it. -->
  <PropertyGroup>
    <_AsmTasksAssembly>$(AsmFoundationSdkDirectory)tasks/netstandard2.0/AsmFoundation.Sdk.Tasks.dll</_AsmTasksAssembly>
  </PropertyGroup>
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmSelectSources" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmReadExports" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmWriteCLibraryStub" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmCheckImage" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmLayOutProgramDependencies" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmSelectRunTarget" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmReadApi" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmMergeApi" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmWriteSourceWrappers" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmReadStructs" AssemblyFile="$(_AsmTasksAssembly)" />

  <!-- ===================================================================================== -->
  <!-- Items                                                                                  -->
  <!-- ===================================================================================== -->

  <!--
    The default items (Compile for the sources, None for every other file) are declared in
    Sdk.props, before the project body, so that a project can Update or Remove them (<None
    Update="data.txt" CopyToOutputDirectory="PreserveNewest" />), as in a .csproj. Here, after
    the body, the sources the project listed itself (EnableDefaultCompileItems=false, or a file
    outside the folder globs) are taken out of None too: each file is one item, a Compile item
    never also a None.
  -->
  <ItemGroup Condition="'$(EnableDefaultNoneItems)' != 'false'">
    <None Remove="@(Compile)" />
  </ItemGroup>

  <!--
    IDE integration.

    The sources are Compile items and the include files None items, item types every IDE shows
    without being told (0.2.0 and 0.3.0 had to declare their AsmSource and AsmInclude types as
    AvailableItemName, or Rider showed an .asmproj empty).

    UpToDateCheckInput / UpToDateCheckBuilt: the fast up-to-date checks of Visual Studio and
    Rider decide whether to call MSBuild at all from these items. Without them an IDE would
    not know that editing a .asm file (or the linker's version script) makes the outputs stale,
    and would skip the build. Visible="false": they name files that are already items. The
    include files are the None items ending in .inc (WithMetadataValue compares the extension
    without regard to case), plus CustomAdditionalCompileInputs, .NET's item for more inputs
    of the compile step, which AsmPrepare also reads.
  -->
  <ItemGroup>
    <UpToDateCheckInput Include="@(Compile);@(None->WithMetadataValue('Extension', '.inc'));@(CustomAdditionalCompileInputs)" Visible="false" />
    <UpToDateCheckInput Include="$(ExportsFile)" Condition="'$(ExportsFile)' != ''" Visible="false" />
    <UpToDateCheckBuilt Include="$(TargetPath)" Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' != 'Objects'" Visible="false" />
  </ItemGroup>

  <!--
    The RID outer build's outputs, for the IDEs' up-to-date checks: an IDE loads a project
    without RuntimeIdentifier, so it sees the outer build, whose own TargetPath no step writes
    (a check against it would find the project stale on every build). Each RID's output is
    named the way Properties.targets names it in that RID's inner build, in the inner build's
    folder (Microsoft.NET.Sdk appends the RID to OutDir). Not in the outer build of a
    multi-targeted project, which has no TargetFramework and no output folder of its own: IDEs
    load each framework's build for the checks.
  -->
  <ItemGroup Condition="'$(_AsmRid)' == '' and '$(TargetFramework)' != '' and '$(_AsmOutputKind)' != 'Objects'">
    <_AsmRidOutput Include="$(_AsmBuildRuntimeIdentifiers)">
      <!-- WebAssembly names carry no lib prefix (see Properties.targets: .NET matches the
           archive's file name against [DllImport]). -->
      <OutputPrefix Condition="!$([System.String]::Copy('%(Identity)').StartsWith('win-')) and !$([System.String]::Copy('%(Identity)').EndsWith('-wasm'))">lib</OutputPrefix>
      <OutputExtension Condition="'$(_AsmOutputKind)' == 'SharedLibrary' and $([System.String]::Copy('%(Identity)').StartsWith('win-'))">.dll</OutputExtension>
      <OutputExtension Condition="'$(_AsmOutputKind)' == 'SharedLibrary' and $([System.String]::Copy('%(Identity)').StartsWith('osx-'))">.dylib</OutputExtension>
      <OutputExtension Condition="'$(_AsmOutputKind)' == 'SharedLibrary' and $([System.String]::Copy('%(Identity)').StartsWith('linux-'))">.so</OutputExtension>
      <OutputExtension Condition="'$(_AsmOutputKind)' != 'StaticLibrary' and $([System.String]::Copy('%(Identity)').EndsWith('-wasm'))">.wasm</OutputExtension>
      <OutputExtension Condition="'$(_AsmOutputKind)' == 'StaticLibrary' and $([System.String]::Copy('%(Identity)').StartsWith('win-'))">.lib</OutputExtension>
      <OutputExtension Condition="'$(_AsmOutputKind)' == 'StaticLibrary' and !$([System.String]::Copy('%(Identity)').StartsWith('win-'))">.a</OutputExtension>
      <OutputExtension Condition="'$(_AsmOutputKind)' == 'Executable' and $([System.String]::Copy('%(Identity)').StartsWith('win-'))">.exe</OutputExtension>
    </_AsmRidOutput>
    <!-- Executables carry no lib prefix on any OS. -->
    <_AsmRidOutput Update="@(_AsmRidOutput)" OutputPrefix="" Condition="'$(_AsmOutputKind)' == 'Executable'" />
    <UpToDateCheckBuilt Include="@(_AsmRidOutput->'$(OutDir)%(Identity)/%(OutputPrefix)$(AssemblyName)%(OutputExtension)')" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The project's own include/ folder and the project folder are searched first, so a
         local file shadows one of the same name from a package or a referenced project. -->
    <AsmIncludeDirectory Include="$(MSBuildProjectDirectory)/include/" Condition="Exists('$(MSBuildProjectDirectory)/include')" />
    <AsmIncludeDirectory Include="$(MSBuildProjectDirectory)/" />
    <!-- The SDK's own include folder, searched last: asmsdk.inc (NASM: the x86-64 calling
         conventions, FUNCTION with exports per OS) and asmsdk-gnu.inc (llvm-mc's GNU syntax:
         FUNCTION, CALL and ADDRESS with each OS's symbol names and relocations; ARM64 needs
         no argument macros, AAPCS64 is the same everywhere). A project's file of the same
         name shadows it. -->
    <AsmIncludeDirectory Include="$(AsmFoundationSdkDirectory)include/" AsmOrigin="Sdk" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Objects and generated files live under obj/<Configuration>/<tfm>/<rid>/asm/
         (IntermediateOutputPath carries the RID in an inner build). -->
    <AsmIntermediateDirectory Condition="'$(AsmIntermediateDirectory)' == ''">$(IntermediateOutputPath)asm/</AsmIntermediateDirectory>
    <!-- The outputs exist per RID only: the RID outer build has a TargetPath (with Linux
         names, see Properties.targets) that no step writes, so it names no library, and a
         referencing project that asked it for one would copy or link a file that is not there. -->
    <AsmStaticLibraryPath Condition="'$(AsmStaticLibraryPath)' == '' and '$(_AsmRid)' != '' and '$(_AsmOutputKind)' == 'StaticLibrary'">$(TargetPath)</AsmStaticLibraryPath>
    <AsmStaticLibraryPath Condition="'$(AsmStaticLibraryPath)' == '' and '$(_AsmRid)' != '' and '$(AsmProduceStaticLibrary)' == 'true'">$(TargetDir)$(_AsmLibraryPrefix)$(AssemblyName)$(_AsmStaticExtension)</AsmStaticLibraryPath>
    <AsmSharedLibraryPath Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' == 'SharedLibrary'">$(TargetPath)</AsmSharedLibraryPath>
    <!-- A Windows DLL is linked against through its import library, never the DLL itself:
         lld-link writes it next to the DLL as foo.dll.lib (see Properties.targets for the name). -->
    <AsmImportLibraryPath Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmOutputKind)' == 'SharedLibrary'">$(TargetDir)$(AssemblyName).dll.lib</AsmImportLibraryPath>
    <!-- The dynamic loader each Linux C library installs, recorded as PT_INTERP in libc
         executables: glibc and musl, each on x64 and ARM64. -->
    <AsmDynamicLinker Condition="'$(AsmDynamicLinker)' == '' and '$(_AsmMusl)' == 'true' and '$(_AsmArch)' == 'arm64'">/lib/ld-musl-aarch64.so.1</AsmDynamicLinker>
    <AsmDynamicLinker Condition="'$(AsmDynamicLinker)' == '' and '$(_AsmMusl)' == 'true'">/lib/ld-musl-x86_64.so.1</AsmDynamicLinker>
    <AsmDynamicLinker Condition="'$(AsmDynamicLinker)' == '' and '$(_AsmOs)' == 'Linux' and '$(_AsmArch)' == 'arm64'">/lib/ld-linux-aarch64.so.1</AsmDynamicLinker>
    <AsmDynamicLinker Condition="'$(AsmDynamicLinker)' == ''">/lib64/ld-linux-x86-64.so.2</AsmDynamicLinker>
    <!-- The oldest macOS the Mach-O files claim to run on (LC_BUILD_VERSION). 11.0 is the
         first with Apple silicon, so one value serves osx-x64 and osx-arm64. -->
    <AsmMacOSMinimumVersion Condition="'$(AsmMacOSMinimumVersion)' == ''">11.0</AsmMacOSMinimumVersion>
    <!--
      The system libraries a linked output (shared library or executable) is linked against,
      as stand-ins the SDK writes itself (_AsmBuildSystemLibraries), so that no build machine
      needs the target's sysroot or SDK:
        Linux libc    a stub of the C library under its SONAME: libc.so.6 (glibc, x64 and
                      ARM64) or libc.musl-x86_64.so.1 / libc.musl-aarch64.so.1 (musl), plus
                      libasmsdk_nonshared.a (atexit, which glibc keeps out of libc.so.6)
        macOS libc    libSystem.tbd, a text stub of /usr/lib/libSystem.B.dylib
        Windows       kernel32.lib, always: kernel32 is a Windows program's way to the OS, as
                      system calls are a Linux program's (Windows system call numbers change
                      between releases), so freestanding Windows code calls it too
        Windows libc  ucrtbase.lib (the Universal C Runtime, part of Windows 10 and later) and
                      asmsdk_winstdio.lib (the printf family and atexit, which the UCRT does
                      not export)
      libc executables start in the SDK's startup code (_AsmBuildCrt) unless the project names
      its own entry symbol with StartupObject: crt1 on Linux (_start, then __libc_start_main),
      mainCRTStartup on Windows. macOS needs none: dyld calls main through LC_MAIN.
    -->
    <_AsmIsLinked Condition="'$(_AsmRid)' != '' and ('$(_AsmOutputKind)' == 'SharedLibrary' or '$(_AsmOutputKind)' == 'Executable')">true</_AsmIsLinked>
    <!-- WebAssembly links no C library of the SDK's: there is no stand-in for one (a linked wasm
         output with libc is ASM0016), and an archive's libc calls are resolved by the .NET
         WebAssembly app's own link, which brings Emscripten's C library or wasi-libc. -->
    <_AsmUsesLibc Condition="'$(_AsmIsLinked)' == 'true' and '$(_AsmRuntime)' == 'Libc' and '$(_AsmArch)' != 'wasm'">true</_AsmUsesLibc>
    <_AsmUsesCrt Condition="'$(_AsmUsesLibc)' == 'true' and '$(_AsmOutputKind)' == 'Executable' and '$(StartupObject)' == '' and '$(_AsmOs)' != 'MacOS'">true</_AsmUsesCrt>
    <_AsmLibcStubName Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmMusl)' == 'true' and '$(_AsmArch)' == 'arm64'">libc.musl-aarch64.so.1</_AsmLibcStubName>
    <_AsmLibcStubName Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmMusl)' == 'true' and '$(_AsmArch)' == 'x64'">libc.musl-x86_64.so.1</_AsmLibcStubName>
    <_AsmLibcStubName Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmMusl)' != 'true'">libc.so.6</_AsmLibcStubName>
    <!-- The PE machine (lld-link's -machine:), for links and for import libraries alike. -->
    <_AsmPeMachine Condition="'$(_AsmArch)' == 'arm64'">arm64</_AsmPeMachine>
    <_AsmPeMachine Condition="'$(_AsmPeMachine)' == ''">x64</_AsmPeMachine>
    <!-- A program's run paths, as a file whose text changes only when they do: an input of
         AsmLink (see _AsmResolveProgramDependencies), so that a new BinariesCopyPath relinks the
         program even when it came from the command line or a Directory.Build.props. -->
    <_AsmRunPathFile Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' == 'Executable'">$(AsmIntermediateDirectory)runpaths.txt</_AsmRunPathFile>
    <!-- The assemblers' options, as a file whose text changes only when they do: an input of
         AsmAssemble (see _AsmWriteAssembleOptions), so that ImplicitUsings, NoWarn,
         DefineConstants or AsmFlags set on the command line or in a Directory.Build.props
         assemble again, as .NET's CoreCompileInputs.cache recompiles C#. -->
    <_AsmAssembleOptionsFile Condition="'$(_AsmRid)' != ''">$(AsmIntermediateDirectory)assemble-options.txt</_AsmAssembleOptionsFile>
    <!-- The loader a Linux libc program names (PT_INTERP): dotnet run checks that the machine,
         WSL or a container has it. Empty for a static program, which needs none. -->
    <_AsmRunLoader Condition="'$(_AsmUsesLibc)' == 'true' and '$(_AsmOs)' == 'Linux' and '$(_AsmOutputKind)' == 'Executable'">$(AsmDynamicLinker)</_AsmRunLoader>
  </PropertyGroup>

  <!-- ===================================================================================== -->
  <!-- Toolchain resolution                                                                   -->
  <!-- ===================================================================================== -->

  <!--
    _AsmResolveToolchain: sets _AsmNasm, _AsmLlvmMc, _AsmLinker and _AsmArchiver to complete
    command prefixes and fails early, with the fix, when a tool is missing.
    lld is one binary for every linker: "-flavor gnu" is ld.lld (ELF, Linux), "-flavor link" is
    lld-link (PE/COFF, Windows), "-flavor darwin" is ld64.lld (Mach-O, macOS) and "-flavor wasm"
    is wasm-ld (WebAssembly, browser-wasm and wasi-wasm); the RID being built picks the flavor.
    llvm-mc assembles GNU-syntax sources (.s), the language of ARM64 code and of WebAssembly;
    it is checked only when such a source builds this RID (see AsmAssemble), so a toolchain
    package older than llvm-mc still builds NASM-only projects.
    Errors: ASM0001 (bundled toolchain not restored), ASM0002 (unknown AsmToolchain value),
    ASM0005 (the System toolchain asked to link Windows, macOS or WebAssembly output with GNU ld).
  -->
  <Target Name="_AsmResolveToolchain">
    <PropertyGroup>
      <_AsmLinkerFlavor Condition="'$(_AsmOs)' == 'Windows'">link</_AsmLinkerFlavor>
      <_AsmLinkerFlavor Condition="'$(_AsmOs)' == 'MacOS'">darwin</_AsmLinkerFlavor>
      <_AsmLinkerFlavor Condition="'$(_AsmArch)' == 'wasm'">wasm</_AsmLinkerFlavor>
      <_AsmLinkerFlavor Condition="'$(_AsmLinkerFlavor)' == ''">gnu</_AsmLinkerFlavor>
    </PropertyGroup>
    <PropertyGroup Condition="'$(AsmToolchain)' == 'Bundled'">
      <!-- NuGetPackageRoot comes from obj/*.nuget.g.props, written by restore. -->
      <AsmToolchainDirectory Condition="'$(AsmToolchainDirectory)' == ''">$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', '$(AsmToolchainPackageId.ToLowerInvariant())', '$(AsmToolchainVersion)', 'tools'))</AsmToolchainDirectory>
      <_AsmNasmPath>$(AsmToolchainDirectory)nasm$(_AsmExe)</_AsmNasmPath>
      <_AsmLlvmMcPath>$(AsmToolchainDirectory)llvm-mc$(_AsmExe)</_AsmLlvmMcPath>
      <_AsmLldPath>$(AsmToolchainDirectory)lld$(_AsmExe)</_AsmLldPath>
      <_AsmArPath>$(AsmToolchainDirectory)llvm-ar$(_AsmExe)</_AsmArPath>
      <_AsmNasm>&quot;$(_AsmNasmPath.Replace('\','/'))&quot;</_AsmNasm>
      <_AsmLlvmMc>&quot;$(_AsmLlvmMcPath.Replace('\','/'))&quot;</_AsmLlvmMc>
      <_AsmLinker>&quot;$(_AsmLldPath.Replace('\','/'))&quot; -flavor $(_AsmLinkerFlavor)</_AsmLinker>
      <_AsmArchiver>&quot;$(_AsmArPath.Replace('\','/'))&quot;</_AsmArchiver>
    </PropertyGroup>
    <PropertyGroup Condition="'$(AsmToolchain)' == 'System'">
      <_AsmNasm>$([MSBuild]::ValueOrDefault('$(AsmNasmCommand)', 'nasm'))</_AsmNasm>
      <_AsmLlvmMc>$([MSBuild]::ValueOrDefault('$(AsmLlvmMcCommand)', 'llvm-mc'))</_AsmLlvmMc>
      <_AsmLinker>$([MSBuild]::ValueOrDefault('$(AsmLinkerCommand)', 'ld'))</_AsmLinker>
      <_AsmArchiver>$([MSBuild]::ValueOrDefault('$(AsmArchiverCommand)', 'ar'))</_AsmArchiver>
    </PropertyGroup>

    <Error Code="ASM0002" Condition="'$(AsmToolchain)' != 'Bundled' and '$(AsmToolchain)' != 'System'"
           Text="AsmToolchain must be 'Bundled' or 'System', not '$(AsmToolchain)'." />
    <Error Code="ASM0001" Condition="'$(AsmToolchain)' == 'Bundled' and (!Exists('$(_AsmNasmPath)') or !Exists('$(_AsmLldPath)') or !Exists('$(_AsmArPath)'))"
           Text="The bundled toolchain was not found in '$(AsmToolchainDirectory)'. Run 'dotnet restore' (it downloads $(AsmToolchainPackageId) $(AsmToolchainVersion)), or set AsmToolchain=System to use nasm, ld and ar from PATH." />
    <!-- The System toolchain's default linker is GNU ld, which links ELF only, while the link
         lines of Windows and macOS are lld-link's and ld64.lld's: a project that cross-links
         with its own tools must name a linker that speaks them. -->
    <Error Code="ASM0005" Condition="'$(AsmToolchain)' == 'System' and ('$(_AsmOs)' == 'Windows' or '$(_AsmOs)' == 'MacOS') and '$(AsmLinkerCommand)' == ''"
           Text="AsmToolchain=System links $(_AsmRid) with the command in AsmLinkerCommand, and its default, ld, is GNU ld, which links Linux (ELF) files only. Set AsmLinkerCommand to lld-link (Windows) or ld64.lld (macOS), or build $(_AsmRid) with the bundled toolchain." />
    <!-- The same default fails for a Linux RID of another architecture: a distribution's GNU
         ld links the build machine's own machine type (an x64 Ubuntu's ld has no AArch64
         emulation), and stopped linux-arm64 with "file in wrong format" (measured: Ubuntu
         24.04, binutils 2.42). _AsmSdkArch is the build machine's architecture as the .NET SDK
         reports it, named like _AsmArch. A cross ld that does link it is named explicitly, and
         an explicit AsmLinkerCommand skips this check. Only for an output that is linked
         (_AsmIsLinked: a shared library or a program): a static library or object
         files never run the linker. -->
    <Error Code="ASM0005" Condition="'$(AsmToolchain)' == 'System' and '$(_AsmIsLinked)' == 'true' and '$(_AsmOs)' == 'Linux' and '$(_AsmSdkArch)' != '' and '$(_AsmArch)' != '$(_AsmSdkArch)' and '$(AsmLinkerCommand)' == ''"
           Text="AsmToolchain=System links $(_AsmRid) with the command in AsmLinkerCommand, and its default, ld, is this machine's GNU ld, which links $(_AsmSdkArch) ELF files only. Set AsmLinkerCommand to ld.lld (it links every architecture) or a cross linker for $(_AsmArch) (such as aarch64-linux-gnu-ld), or build $(_AsmRid) with the bundled toolchain." />
    <!-- WebAssembly links with wasm-ld's command line, which no GNU ld understands. Archives
         need an archiver that indexes wasm objects' symbols, which GNU ar does not either:
         AsmArchiverCommand=llvm-ar (the docs say so; an archive without an index fails only at
         a consumer's link). Only for a linked output, as above. -->
    <Error Code="ASM0005" Condition="'$(AsmToolchain)' == 'System' and '$(_AsmIsLinked)' == 'true' and '$(_AsmArch)' == 'wasm' and '$(AsmLinkerCommand)' == ''"
           Text="AsmToolchain=System links $(_AsmRid) with the command in AsmLinkerCommand, and its default, ld, is GNU ld, which links no WebAssembly. Set AsmLinkerCommand to wasm-ld (LLVM's WebAssembly linker; also AsmArchiverCommand to llvm-ar, which indexes wasm objects), or build $(_AsmRid) with the bundled toolchain." />

    <!--
      NuGet does not keep the Unix execute bit when it extracts a package, so the tools come
      out as plain files on Linux and macOS. Restoring the bit on every build costs one
      process start and is idempotent. llvm-mc is included only when the package has it.
    -->
    <PropertyGroup Condition="'$(AsmToolchain)' == 'Bundled' and Exists('$(_AsmLlvmMcPath)')">
      <_AsmChmodLlvmMc>$(_AsmLlvmMc)</_AsmChmodLlvmMc>
    </PropertyGroup>
    <Exec Condition="'$(AsmToolchain)' == 'Bundled' and !$([MSBuild]::IsOSPlatform('Windows'))"
          Command="chmod +x $(_AsmNasm) $(_AsmChmodLlvmMc) &quot;$(_AsmLldPath)&quot; $(_AsmArchiver)" StandardOutputImportance="low" />
  </Target>

  <!-- ===================================================================================== -->
  <!-- Preparation                                                                            -->
  <!-- ===================================================================================== -->

  <!--
    AsmPrepare: computes everything the assemble and link steps need, so those two targets can
    be pure "inputs -> outputs" steps that MSBuild skips when nothing changed.
  -->
  <!-- The RID check comes first, explicitly: a BeforeTargets hook would run only after the
       DependsOnTargets, that is after the referenced projects were built for a RID that this
       project may not even list. -->
  <Target Name="AsmPrepare" DependsOnTargets="_AsmCheckRuntimeIdentifiers;_AsmResolveToolchain;_AsmResolveProjectReferences">
    <!--
      The sources of this RID: AsmSelectSources reads each file's qualifier and language
      (crc32c.asm for every x64 RID, crc32c.linux.asm for Linux only, crc32c.s for ARM64,
      crc32c.wasm.s for both WebAssembly RIDs; the most specific file of a name wins) and adds
      AsmLanguage (Nasm or Gnu). The RID outer build assembles nothing, so it selects nothing.
      The task's errors: ASM0020 (two files of one name tie), ASM0021 (a .asm qualified for
      ARM64 or WebAssembly only), ASM0022 (a RID it does not know), ASM0024 (a file listed
      twice).
    -->
    <!-- The Compile items that are asm sources: _AsmCheckProject has already refused one of
         another kind the project listed (ASM0025), so this only keeps out what a target of
         .NET's or a package may add to Compile during the build (none does today; measured:
         the target framework attribute file stays out of an .asmproj, which has no language). -->
    <ItemGroup>
      <_AsmSourceItem Include="@(Compile)" Condition="'%(Extension)' == '.asm' or '%(Extension)' == '.s'" />
      <!-- RecursiveDir (the folder a ** glob matched, src/ for src/x.s) is MSBuild's own
           metadata, which the items a task returns do not have: AsmSelectSources' output had it
           empty, so every object went to obj/x.o, and a/x.s and b/x.s overwrote each other's
           (measured: src/wasmlib.wasm.s assembled to obj/wasmlib.wasm.o). Kept as custom
           metadata, which the task copies. -->
      <_AsmSourceItem>
        <AsmRecursiveDir>%(RecursiveDir)</AsmRecursiveDir>
      </_AsmSourceItem>
    </ItemGroup>
    <AsmSelectSources Condition="'$(_AsmRid)' != '' and '@(_AsmSourceItem)' != ''" Sources="@(_AsmSourceItem)" RuntimeIdentifier="$(_AsmRid)">
      <Output TaskParameter="Selected" ItemName="_AsmSelectedSource" />
    </AsmSelectSources>
    <!-- A project with sources, none of which builds this RID, would otherwise link an empty
         library for it: typically NASM-only code built for an ARM64 RID. -->
    <Error Code="ASM0023"
           Condition="'$(_AsmRid)' != '' and '$(_AsmArch)' != 'wasm' and '@(_AsmSourceItem)' != '' and '@(_AsmSelectedSource)' == ''"
           Text="No source of this project builds $(_AsmRid). NASM files (.asm) build the x64 RIDs; ARM64 needs GNU-syntax files (.s). Add a source for $(_AsmRid) (for example name.$(_AsmRid).s), or remove $(_AsmRid) from RuntimeIdentifiers." />
    <!-- The same for WebAssembly, whose sources are always qualified: a project that adds
         browser-wasm to a list of native RIDs has none yet, and its unqualified .s files are
         ARM64 code that llvm-mc's wasm parser could never read. -->
    <Error Code="ASM0023"
           Condition="'$(_AsmRid)' != '' and '$(_AsmArch)' == 'wasm' and '@(_AsmSourceItem)' != '' and '@(_AsmSelectedSource)' == ''"
           Text="No source of this project builds $(_AsmRid). WebAssembly is LLVM's WebAssembly assembly in .s files qualified for it: name.wasm.s (browser-wasm and wasi-wasm), name.$(_AsmOs.ToLowerInvariant()).s or name.$(_AsmRid).s. Unqualified .s files are ARM64 code. Add one, or remove $(_AsmRid) from RuntimeIdentifiers." />

    <!--
      What WebAssembly cannot build, before anything is assembled:
        ASM0016  a linked output (a module, or a WASI program) with TargetFramework libc. The
                 bundled wasm-ld links no C library: there is no stand-in for one, as there is for
                 glibc or the UCRT, and the browser has none at all. A libc library for .NET
                 WebAssembly apps is a StaticLibrary (or Objects): the app's build links it with
                 its own C library (Emscripten's, or wasi-libc from the WASI SDK).
        ASM0017  a program for browser-wasm. The browser starts no programs: JavaScript
                 instantiates a module and calls its exports (OutputType Library), and WASI is the
                 WebAssembly that runs programs.
    -->
    <PropertyGroup>
      <!-- The word the WebAssembly messages use for this project's output. -->
      <_AsmWasmOutputWord Condition="'$(_AsmOutputKind)' == 'Executable'">program</_AsmWasmOutputWord>
      <_AsmWasmOutputWord Condition="'$(_AsmOutputKind)' != 'Executable'">module</_AsmWasmOutputWord>
    </PropertyGroup>
    <Error Code="ASM0016"
           Condition="'$(_AsmArch)' == 'wasm' and '$(_AsmIsLinked)' == 'true' and '$(_AsmRuntime)' == 'Libc'"
           Text="$(MSBuildProjectName) links a WebAssembly $(_AsmWasmOutputWord) for $(_AsmRid) with TargetFramework libc, but the bundled wasm-ld links no C library. Build it freestanding (the default), calling WASI or JavaScript imports directly; or, for a .NET WebAssembly app, build &lt;OutputType&gt;StaticLibrary&lt;/OutputType&gt;: the app's own build links its C library (Emscripten's, or wasi-libc)." />
    <Error Code="ASM0017"
           Condition="'$(_AsmOs)' == 'Browser' and '$(_AsmOutputKind)' == 'Executable'"
           Text="$(MSBuildProjectName) is a program (OutputType Exe), and browser-wasm has none: JavaScript instantiates a module and calls its exports. Build &lt;OutputType&gt;Library&lt;/OutputType&gt; for the browser (a module with exports, and an archive for .NET WebAssembly apps), or build the program for wasi-wasm, which wasmtime and other WASI hosts run." />

    <!--
      ExportsFile: the linker version script, under NativeAOT's name for the same file (the
      list of symbols to export, which NativeAOT hands to the linker as a version script on
      Linux). A relative path is taken from the project folder. Resolved first because it
      changes the defines below as well as the link line.
    -->
    <PropertyGroup>
      <_AsmExportsFilePath Condition="'$(ExportsFile)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(ExportsFile)'))))</_AsmExportsFilePath>
    </PropertyGroup>
    <ItemGroup>
      <!-- Each source's object keeps the source's subfolder, so a/x.asm and b/x.asm do not
           collide, and its qualifier, so x.linux.asm and x.asm never share an object. The
           subfolder is AsmRecursiveDir (see _AsmSourceItem above): RecursiveDir itself is empty
           on the task's output. -->
      <_AsmSelectedSource>
        <ObjectFile>$(AsmIntermediateDirectory)obj/%(AsmRecursiveDir)%(Filename).o</ObjectFile>
      </_AsmSelectedSource>
      <_AsmSelectedSource>
        <ObjectToolPath>$([System.IO.Path]::GetFullPath('%(ObjectFile)').Replace('\','/'))</ObjectToolPath>
        <SourceToolPath>$([System.String]::Copy('%(FullPath)').Replace('\','/'))</SourceToolPath>
        <!-- The source as the assembler is given it: relative to the project folder, the
             assemblers' working directory. NASM and llvm-mc record that name in the object's
             symbol table, so an absolute path made a Release build differ from one checkout
             folder to the next; relative, the objects of two checkouts are byte-identical
             (measured 2026-11-23: the same source from two folders, NASM 3.02, elf64).
             MakeRelative leaves a path on another drive absolute, which still assembles. -->
        <SourceRelativeToolPath>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/', '%(FullPath)').Replace('\','/'))</SourceRelativeToolPath>
        <!-- With ImplicitUsings, a GNU source is assembled through a generated file that
             includes the platform layer first, and a WebAssembly source always is, because the
             file also carries the defines (see _AsmWriteSourceWrappers); its path is relative
             too, for the same reason. -->
        <SourceWrapper Condition="('$(_AsmImplicitUsings)' == 'true' or '$(_AsmArch)' == 'wasm') and '%(_AsmSelectedSource.AsmLanguage)' == 'Gnu'">$(AsmIntermediateDirectory)implicit/%(AsmRecursiveDir)%(Filename)%(Extension)</SourceWrapper>
      </_AsmSelectedSource>
      <!-- Qualified metadata below: only GNU sources define the wrapper, and an unqualified
           %(...) over items that lack it stops the build with MSB4096 (measured). -->
      <_AsmSelectedSource>
        <AssembledToolPath>%(_AsmSelectedSource.SourceRelativeToolPath)</AssembledToolPath>
        <AssembledToolPath Condition="'%(_AsmSelectedSource.SourceWrapper)' != ''">$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/', $([System.IO.Path]::GetFullPath('%(_AsmSelectedSource.SourceWrapper)'))).Replace('\','/'))</AssembledToolPath>
      </_AsmSelectedSource>
      <_AsmObject Include="@(_AsmSelectedSource->'%(ObjectToolPath)')" />

      <!-- Local include directories first, then those that packages and referenced projects
           contributed (they carry AsmOrigin), each group in the order added, and the SDK's own
           folder last, so that any of the others may shadow its files. -->
      <_AsmIncludeDirectoryOrdered Include="@(AsmIncludeDirectory)" Condition="'%(AsmIncludeDirectory.AsmOrigin)' == ''" />
      <_AsmIncludeDirectoryOrdered Include="@(AsmIncludeDirectory)" Condition="'%(AsmIncludeDirectory.AsmOrigin)' != '' and '%(AsmIncludeDirectory.AsmOrigin)' != 'Sdk'" />
      <_AsmIncludeDirectoryOrdered Include="@(AsmIncludeDirectory)" Condition="'%(AsmIncludeDirectory.AsmOrigin)' == 'Sdk'" />
      <_AsmIncludeDirectoryOrdered>
        <!-- NASM uses -I as a plain prefix, so the trailing separator is required. -->
        <ToolPath>$([MSBuild]::EnsureTrailingSlash('%(FullPath)').Replace('\','/'))</ToolPath>
      </_AsmIncludeDirectoryOrdered>

      <!-- Dependencies of every object: all include files in the include path. Coarse but
           never wrong: editing any .inc reassembles every source that could include it. The
           project's own include files are its None items ending in .inc (an include file from
           a folder outside the project is listed as one: <None Include="../common/*.inc" />),
           and any other file a source reads (a %incbin blob, a .mac file) is a
           CustomAdditionalCompileInputs item, .NET's item for extra inputs of the compile. -->
      <_AsmDependency Include="@(None->WithMetadataValue('Extension', '.inc')->'%(FullPath)')" />
      <_AsmDependency Include="@(CustomAdditionalCompileInputs->'%(FullPath)')" />
      <_AsmDependency Include="%(_AsmIncludeDirectoryOrdered.FullPath)**/*.inc" Condition="'%(_AsmIncludeDirectoryOrdered.AsmOrigin)' != ''" />

      <!-- One -D per DefineConstants entry (NAME or NAME=VALUE), then the SDK's own symbols
           (DEBUG or RELEASE, FREESTANDING or LIBC, the platform's), in that order, once each.
           Properties.targets appends them to DefineConstants too, but a DefineConstants given
           on the command line is a global property that ignores the append, so they are added
           here from _AsmImplicitDefineConstants as well, and taken out of the project's list
           first so that a normal build does not pass them twice. An item Include splits on ";"
           and drops the empty entries that a leading or doubled ";" leaves. -->
      <_AsmImplicitDefine Include="$(_AsmImplicitDefineConstants)" />
      <_AsmDefine Include="$(DefineConstants)" Exclude="@(_AsmImplicitDefine)" />
      <_AsmDefine Include="@(_AsmImplicitDefine)" />
      <!-- The exports file decides what is exported: asmsdk.inc's FUNCTION then writes no
           Windows export directive of its own, which would export every FUNCTION whether the
           file lists it or not (lld-link cannot drop a directive). -->
      <_AsmDefine Include="ASMSDK_EXPORTS_FILE" Condition="'$(_AsmExportsFilePath)' != ''" />
      <!-- A program's functions are not an API: FUNCTION exports nothing from an executable
           (on Windows its directive made main an export, and lld-link then wrote an import
           library beside the .exe). A program that does export, a plugin host, names its
           exports in an ExportsFile, as a library can. -->
      <_AsmDefine Include="ASMSDK_EXECUTABLE" Condition="'$(_AsmOutputKind)' == 'Executable'" />

      <!--
        .NET's warning switches, for NASM's warnings by name (the owner's choice, 2026-11-23):
          NoWarn               label-orphan  ->  -w-label-orphan        (off)
          WarningsAsErrors     label-orphan  ->  -w+error=label-orphan  (an error)
          WarningsNotAsErrors  label-orphan  ->  -w-error=label-orphan  (a warning again, under
                                                                        TreatWarningsAsErrors)
        The same lists hold .NET's and NuGet's codes (NU5128, CS1591, 1701): only entries that
        look like NASM's names, lower case with hyphens, are passed on. NASM ignores a name it
        does not know (measured: -w-nonsense-name assembles with no message), so a lower-case
        code of another tool is harmless. llvm-mc (.s) has no per-warning switches.
      -->
      <_AsmNoWarnEntry Include="$(NoWarn)" />
      <_AsmNoWarn Include="@(_AsmNoWarnEntry)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^[a-z][a-z0-9]*(-[a-z0-9]+)*$'))" />
      <_AsmWarningAsErrorEntry Include="$(WarningsAsErrors)" />
      <_AsmWarningAsError Include="@(_AsmWarningAsErrorEntry)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^[a-z][a-z0-9]*(-[a-z0-9]+)*$'))" />
      <_AsmWarningNotAsErrorEntry Include="$(WarningsNotAsErrors)" />
      <_AsmWarningNotAsError Include="@(_AsmWarningNotAsErrorEntry)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^[a-z][a-z0-9]*(-[a-z0-9]+)*$'))" />

      <!-- Link inputs: static libraries and shared objects from NativeLibrary items (NativeAOT's
           name; AsmLinkLibrary before, see ASM0109), packages and referenced projects, in the
           order given. -->
      <_AsmLinkInput Include="@(NativeLibrary->'%(FullPath)')" />
      <_AsmLinkInput>
        <ToolPath>$([System.String]::Copy('%(FullPath)').Replace('\','/'))</ToolPath>
      </_AsmLinkInput>
    </ItemGroup>

    <PropertyGroup>
      <_AsmIncludeArguments>@(_AsmIncludeDirectoryOrdered->'-I&quot;%(ToolPath)&quot;', ' ')</_AsmIncludeArguments>
      <_AsmDefineArguments>@(_AsmDefine->'-D%(Identity)', ' ')</_AsmDefineArguments>
      <!-- DWARF when the project's DebugSymbols/DebugType ask for it (captured as
           _AsmDebugSymbols by Properties.targets, before they were hidden). -->
      <_AsmDebugArguments Condition="'$(_AsmDebugSymbols)' == 'true'">-g -F dwarf</_AsmDebugArguments>
      <!--
        Every warning except two that NASM raises on relocations it cannot judge:

        - reloc-rel-dword fires on any RIP-relative reference to another section (lea rsi,
          [rel msg] from .text to .rodata, a call to an extern). That is how
          position-independent code is written, and it always links.
        - reloc-abs-qword fires on a dq of a label (a jump table, a table of handlers). Whether
          such a pointer works depends on the output and on the section, which NASM cannot see:
          - In a Freestanding executable (-static, not position-independent), the address is
            fixed at link time, and the pointer works in any section.
          - In a shared library or a libc executable (a PIE), the address is known only at
            load time. In a writable section, the linker emits an R_X86_64_RELATIVE dynamic
            relocation, and the loader applies it when the program starts. That covers .data,
            and also ".data.rel.ro" when it is declared "write". There, -z relro makes the
            section read-only again after relocation. Without "write", NASM leaves a section of
            that name read-only.
          - In .rodata, or any other section without the write flag, the LINK FAILS: ld.lld
            reports "relocation R_X86_64_64 cannot be used against local symbol; recompile
            with -fPIC". The fix would be to relocate a read-only page at load time (a text
            relocation), and ld.lld's default -z text forbids that. Tables in read-only data
            hold 32-bit offsets instead (dd label - table), which need no relocation.

        The warning stays off: NASM would flag the valid cases too, and the linker still
        rejects every invalid one. Measured with the bundled NASM 3.02 and ld.lld 23.1.5,
        using this SDK's link lines.

        TreatWarningsAsErrors works as in a .csproj.
      -->
      <_AsmWarningArguments>-w+all -w-reloc-rel-dword -w-reloc-abs-qword</_AsmWarningArguments>
      <_AsmWarningArguments Condition="'$(TreatWarningsAsErrors)' == 'true'">$(_AsmWarningArguments) -w+error</_AsmWarningArguments>
      <!-- The per-name switches come after the general ones: NASM applies its warning options
           in order, so -w-error=name after -w+error leaves that one warning a warning. -->
      <_AsmWarningArguments Condition="'@(_AsmNoWarn)' != ''">$(_AsmWarningArguments) @(_AsmNoWarn->'-w-%(Identity)', ' ')</_AsmWarningArguments>
      <_AsmWarningArguments Condition="'@(_AsmWarningAsError)' != ''">$(_AsmWarningArguments) @(_AsmWarningAsError->'-w+error=%(Identity)', ' ')</_AsmWarningArguments>
      <_AsmWarningArguments Condition="'@(_AsmWarningNotAsError)' != ''">$(_AsmWarningArguments) @(_AsmWarningNotAsError->'-w-error=%(Identity)', ' ')</_AsmWarningArguments>
      <!--
        Run-to-run identical objects: NASM's reproducible option leaves out what changes from
        one run to the next, such as the timestamp of a COFF object's header. A PE file ignores
        its objects' timestamps (lld-link links with -Brepro below), but a Windows static library
        (.lib) holds its objects verbatim, timestamps included. With the relative source paths
        above, a Release build is the same on every machine and in every checkout folder.
      -->
      <_AsmNasmReproducibleArgument>--reproducible</_AsmNasmReproducibleArgument>
      <!-- ImplicitUsings: the platform layer as NASM's pre-include (see Properties.targets). -->
      <_AsmNasmImplicitUsingsArgument Condition="'$(_AsmImplicitUsings)' == 'true'">-P &quot;$(AsmFoundationSdkDirectory.Replace('\','/'))include/asmsdk-implicit.inc&quot;</_AsmNasmImplicitUsingsArgument>
      <!-- The SDK's own stubs: the same warnings, always as errors (they are ours to keep clean). -->
      <_AsmSdkSourceWarningArguments>-w+all -w-reloc-rel-dword -w-reloc-abs-qword -w+error</_AsmSdkSourceWarningArguments>
      <!--
        NASM's messages in Visual C++'s format, "file(line) : error: text", on every OS. NASM's
        default "file:line: error: text" has no column, and MSBuild recognizes the GCC/Clang
        form only with one: NASM's errors and warnings were plain output, so IDEs listed only
        ASM0007 ("the assembler exited with code 1") and MSBuild's MSB3073, never the line at
        fault (measured with MSBuild 18: a syntax error counted 2 errors, not 3). With -Xvc each
        is an MSBuild error or warning with its file and line, which Visual Studio, Rider and
        VS Code open at the line. llvm-mc's "file:line:col: error:" needs nothing.
        Consequence: a NASM warning now counts as an MSBuild warning, so a build run with
        -warnaserror (MSBuild-wide) fails on one; TreatWarningsAsErrors already made NASM
        itself fail (-w+error).
      -->
      <_AsmNasmMessageArguments>-Xvc</_AsmNasmMessageArguments>
      <_AsmObjectArguments>@(_AsmObject->'&quot;%(Identity)&quot;', ' ')</_AsmObjectArguments>
      <_AsmLinkInputArguments>@(_AsmLinkInput->'&quot;%(ToolPath)&quot;', ' ')</_AsmLinkInputArguments>
      <_AsmTargetPathArgument>&quot;$(TargetPath.Replace('\','/'))&quot;</_AsmTargetPathArgument>
      <_AsmStubToolDirectory>$([System.IO.Path]::GetFullPath('$(AsmIntermediateDirectory)stubs/').Replace('\','/'))</_AsmStubToolDirectory>
      <_AsmCrtArgument Condition="'$(_AsmUsesCrt)' == 'true' and '$(_AsmOs)' == 'Linux'">&quot;$(_AsmStubToolDirectory)crt1.o&quot;</_AsmCrtArgument>
      <_AsmCrtArgument Condition="'$(_AsmUsesCrt)' == 'true' and '$(_AsmOs)' == 'Windows'">&quot;$(_AsmStubToolDirectory)wincrt.obj&quot;</_AsmCrtArgument>
      <!--
        The system libraries (see _AsmBuildSystemLibraries), after everything that needs them:
        a linker reads an archive only for the symbols still undefined when it gets there.
        Linux: no-as-needed keeps DT_NEEDED even when only a linked library, not the objects,
        calls into libc; the nonshared archive comes first, its atexit calling into the stub.
        Windows: the stdio archive before ucrtbase.lib, which its functions import from.
      -->
      <_AsmLibcArguments Condition="'$(_AsmUsesLibc)' == 'true' and '$(_AsmOs)' == 'Linux'">&quot;$(_AsmStubToolDirectory)libasmsdk_nonshared.a&quot; --no-as-needed &quot;$(_AsmStubToolDirectory)$(_AsmLibcStubName)&quot;</_AsmLibcArguments>
      <_AsmLibcArguments Condition="'$(_AsmUsesLibc)' == 'true' and '$(_AsmOs)' == 'MacOS'">&quot;$(_AsmStubToolDirectory)libSystem.tbd&quot;</_AsmLibcArguments>
      <_AsmLibcArguments Condition="'$(_AsmUsesLibc)' == 'true' and '$(_AsmOs)' == 'Windows'">&quot;$(_AsmStubToolDirectory)asmsdk_winstdio.lib&quot; &quot;$(_AsmStubToolDirectory)ucrtbase.lib&quot;</_AsmLibcArguments>
      <_AsmSystemLibraryArguments Condition="'$(_AsmIsLinked)' == 'true' and '$(_AsmOs)' == 'Windows'">&quot;$(_AsmStubToolDirectory)kernel32.lib&quot;</_AsmSystemLibraryArguments>

      <!--
        The exports file on Linux: only the symbols it lists as global stay in the dynamic
        symbol table, versioned by its version node. The full path is also an input of AsmLink,
        so editing the script relinks. (Windows and macOS: see AsmReadExports below.)
      -->
      <_AsmExportsFileArgument Condition="'$(_AsmExportsFilePath)' != '' and '$(_AsmOs)' == 'Linux'">--version-script=&quot;$(_AsmExportsFilePath.Replace('\','/'))&quot;</_AsmExportsFileArgument>
      <!-- An executable puts no symbol in its dynamic symbol table unless asked: NativeAOT
           pairs the exports file with the export-dynamic option for that reason, and so does
           the SDK, so that the script decides what a dlopen'ed plugin can call back. -->
      <_AsmExportsFileArgument Condition="'$(_AsmExportsFilePath)' != '' and '$(_AsmOs)' == 'Linux' and '$(_AsmOutputKind)' == 'Executable'">$(_AsmExportsFileArgument) --export-dynamic</_AsmExportsFileArgument>

      <!--
        LinkerArg items: extra linker arguments, under NativeAOT's item name, appended to every
        link line in item order. One item may hold several words ("-z defs"): the items are
        joined with spaces and not quoted, so a path with spaces must carry its own quotes.
        Footgun for NativeAOT users: NativeAOT hands LinkerArg to clang, so its items are
        written "-Wl,..."; the SDK runs the linker directly, so write the linker's own syntax,
        which differs per OS (ld.lld: -z defs; lld-link: -opt:ref; ld64.lld: -dead_strip).
        Condition an item on $(RuntimeIdentifier) when it belongs to one platform.
      -->
      <_AsmLinkerArgArguments>@(LinkerArg, ' ')</_AsmLinkerArgArguments>

      <!--
        NASM, per object format: win64 (COFF) for Windows, elf64 for Linux, macho64 for macOS.
        Mach-O names every C symbol with a leading underscore, so on macOS NASM adds it to every
        global and extern (NASM's gprefix option): the same source says "global crc32c" and "extern printf"
        on every OS. DWARF for ELF and Mach-O, CodeView for COFF (lld-link writes the PDB).
      -->
      <_AsmNasmFormat Condition="'$(_AsmOs)' == 'Windows'">win64</_AsmNasmFormat>
      <_AsmNasmFormat Condition="'$(_AsmOs)' == 'MacOS'">macho64</_AsmNasmFormat>
      <_AsmNasmFormat Condition="'$(_AsmNasmFormat)' == ''">elf64</_AsmNasmFormat>
      <_AsmNasmFormatArguments>-f $(_AsmNasmFormat)</_AsmNasmFormatArguments>
      <_AsmNasmFormatArguments Condition="'$(_AsmOs)' == 'MacOS'">$(_AsmNasmFormatArguments) --gprefix _</_AsmNasmFormatArguments>
      <!--
        Windows: ".rodata" means ".rdata". NASM's win64 output knows .rdata, and puts a section
        of any name it does not know into an EXECUTABLE CODE section (measured: .rodata came out
        IMAGE_SCN_CNT_CODE | MEM_EXECUTE), and with CodeView debug information NASM 3.02 then
        crashed (exit 139) when code from an include file followed such a section (reduced by
        delta debugging to a .rodata label plus one instruction from asmsdk.inc). The macro
        renames the section before NASM sees it, so the Linux spelling works on Windows, as it
        already does on macOS (macho64 maps .rodata to __TEXT,__const).
      -->
      <_AsmNasmFormatArguments Condition="'$(_AsmOs)' == 'Windows'">$(_AsmNasmFormatArguments) -D.rodata=.rdata</_AsmNasmFormatArguments>
      <_AsmDebugArguments Condition="'$(_AsmDebugSymbols)' == 'true' and '$(_AsmOs)' == 'Windows'">-g -F cv8</_AsmDebugArguments>

      <!--
        llvm-mc, for GNU-syntax sources: the target triple says CPU, OS and object format. The
        macOS triples carry the minimum version (Mach-O records it). The same defines reach it
        as llvm-mc's defsym option, which takes integers only: NAME becomes NAME=1, NAME=42 stays, and a
        non-numeric value is llvm-mc's error. Include directories as -I, as for NASM.
      -->
      <_AsmLlvmMcCpu Condition="'$(_AsmArch)' == 'arm64' and '$(_AsmOs)' == 'MacOS'">arm64</_AsmLlvmMcCpu>
      <_AsmLlvmMcCpu Condition="'$(_AsmArch)' == 'arm64' and '$(_AsmOs)' != 'MacOS'">aarch64</_AsmLlvmMcCpu>
      <_AsmLlvmMcCpu Condition="'$(_AsmArch)' == 'x64'">x86_64</_AsmLlvmMcCpu>
      <_AsmLlvmMcTriple Condition="'$(_AsmOs)' == 'Windows'">$(_AsmLlvmMcCpu)-pc-windows-msvc</_AsmLlvmMcTriple>
      <_AsmLlvmMcTriple Condition="'$(_AsmOs)' == 'MacOS'">$(_AsmLlvmMcCpu)-apple-macos$(AsmMacOSMinimumVersion)</_AsmLlvmMcTriple>
      <_AsmLlvmMcTriple Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmMusl)' == 'true'">$(_AsmLlvmMcCpu)-linux-musl</_AsmLlvmMcTriple>
      <_AsmLlvmMcTriple Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmMusl)' != 'true'">$(_AsmLlvmMcCpu)-linux-gnu</_AsmLlvmMcTriple>
      <!--
        WebAssembly: 32-bit wasm, with Emscripten's triple for the browser (what .NET's
        browser-wasm build links with) and WASI's for wasi-wasm. The objects are the same wasm
        object format either way; llvm-mc records no triple in them (measured: the three
        triples' objects have the same sections).
        Features: LLVM 23's generic wasm CPU already accepts bulk memory, multivalue, mutable
        globals, non-trapping float-to-int, reference types and sign extension; SIMD128 and
        tail calls (return_call) are refused without -mattr ("instruction requires: simd128",
        measured). Both are standard WebAssembly that today's browsers, Node and wasmtime run,
        and .NET's WebAssembly runtime is built with SIMD (since .NET 8). Accepting them costs
        nothing: llvm-mc writes no target_features section (measured), so a module needs them
        at run time only if its code uses them. One trap, measured with .NET 10.0.15: the
        browser build's wasm-opt validates dotnet.native.wasm with SIMD but without tail calls,
        so a return_call in code linked into a .NET app fails that app's Release link; that is
        why asmsdk-wasm.inc's TAILCALL is a call and a return. AsmLlvmMcFlags comes later on the
        line, so -mattr=-simd128 there takes SIMD away again, and -mattr=+relaxed-simd adds more.
      -->
      <_AsmLlvmMcTriple Condition="'$(_AsmOs)' == 'Browser'">wasm32-unknown-emscripten</_AsmLlvmMcTriple>
      <_AsmLlvmMcTriple Condition="'$(_AsmOs)' == 'Wasi'">wasm32-unknown-wasi</_AsmLlvmMcTriple>
      <_AsmLlvmMcFeatureArguments Condition="'$(_AsmArch)' == 'wasm'">-mattr=+simd128,+tail-call</_AsmLlvmMcFeatureArguments>
      <!-- llvm-mc writes DWARF only (it has no CodeView option for assembly sources). Windows
           debuggers read PDBs, and lld-link copied the DWARF sections into the DLL with a
           warning per section (".debug_info is longer than 8 characters", measured on
           win-arm64), so Windows objects from .s files carry no line information; the PDB
           still names every function. -->
      <_AsmLlvmMcDebugArguments Condition="'$(_AsmDebugSymbols)' == 'true' and '$(_AsmOs)' != 'Windows'">-g</_AsmLlvmMcDebugArguments>
      <_AsmLlvmMcIncludeArguments>@(_AsmIncludeDirectoryOrdered->'-I &quot;%(ToolPath)&quot;', ' ')</_AsmLlvmMcIncludeArguments>
    </PropertyGroup>
    <!-- WebAssembly takes no defsym: each one is a constant symbol, and llvm-mc's wasm object
         writer stops on any ("WASM: absolute addressing not supported!", measured with LLVM
         23.1.5; its WasmObjectWriter has no way to write a symbol that is not in a section).
         The defines become labels in the generated wrapper instead (AsmWriteSourceWrappers),
         which also refuses a define with a value (ASM0018). -->
    <ItemGroup Condition="'$(_AsmArch)' != 'wasm'">
      <_AsmLlvmMcDefine Include="@(_AsmDefine)" Condition="$([System.String]::Copy('%(Identity)').Contains('='))" />
      <_AsmLlvmMcDefine Include="@(_AsmDefine->'%(Identity)=1')" Condition="!$([System.String]::Copy('%(Identity)').Contains('='))" />
    </ItemGroup>
    <ItemGroup Condition="'$(_AsmArch)' == 'wasm'">
      <_AsmWasmDefineLabel Include="@(_AsmDefine)" />
    </ItemGroup>
    <PropertyGroup>
      <_AsmLlvmMcDefineArguments>@(_AsmLlvmMcDefine->'--defsym=%(Identity)', ' ')</_AsmLlvmMcDefineArguments>
    </PropertyGroup>

    <!--
      The exports file on Windows and macOS: their linkers take names, not a version script.
      AsmReadExports lists the script's global names. lld-link gets -export:name for each (a DLL
      exports nothing it is not told to; functions declared with asmsdk.inc's FUNCTION also
      export themselves through a .drectve directive). ld64.lld gets -exported_symbol _name for
      each, which hides every other global, as the script's "local: *" does on Linux; Mach-O
      names carry the underscore, and ld64.lld matches the script's wildcards itself.
    -->
    <AsmReadExports Condition="'$(_AsmExportsFilePath)' != '' and ('$(_AsmOs)' == 'Windows' or '$(_AsmOs)' == 'MacOS')"
                    ExportsFile="$(_AsmExportsFilePath)"
                    AllowWildcards="$([System.String]::Equals('$(_AsmOs)', 'MacOS'))">
      <Output TaskParameter="Names" ItemName="_AsmExportedName" />
    </AsmReadExports>
    <!--
      WebAssembly (wasm-ld) takes the names too, one exact name per export option, no wildcards.
      Without an ExportsFile, a module exports every global symbol that is not hidden
      (export-dynamic): what asmsdk-wasm.inc's FUNCTION declares, never a HIDDEN_FUNCTION. With
      one, exactly the names it lists, plus what wasm-ld always exports (the memory, and a
      WASI program's _start). A listed name the module does not define is wasm-ld's error, as
      an undefined export is for the other linkers.
    -->
    <AsmReadExports Condition="'$(_AsmExportsFilePath)' != '' and '$(_AsmArch)' == 'wasm'"
                    ExportsFile="$(_AsmExportsFilePath)"
                    AllowWildcards="false"
                    ExactNamesTarget="WebAssembly modules">
      <Output TaskParameter="Names" ItemName="_AsmExportedName" />
    </AsmReadExports>
    <PropertyGroup>
      <_AsmExportsFileArgument Condition="'$(_AsmOs)' == 'Windows' and '@(_AsmExportedName)' != ''">@(_AsmExportedName->'-export:%(Identity)', ' ')</_AsmExportsFileArgument>
      <_AsmExportsFileArgument Condition="'$(_AsmOs)' == 'MacOS' and '@(_AsmExportedName)' != ''">@(_AsmExportedName->'-exported_symbol _%(Identity)', ' ')</_AsmExportsFileArgument>
      <_AsmExportsFileArgument Condition="'$(_AsmArch)' == 'wasm' and '@(_AsmExportedName)' != ''">@(_AsmExportedName->'--export=%(Identity)', ' ')</_AsmExportsFileArgument>
      <_AsmExportsFileArgument Condition="'$(_AsmArch)' == 'wasm' and '$(_AsmExportsFilePath)' == '' and '$(_AsmOutputKind)' == 'SharedLibrary'">--export-dynamic</_AsmExportsFileArgument>

      <!--
        A Windows program's import library. lld-link writes one beside any image that exports
        something. A program with an ExportsFile gets one, named after it (plugin.exe ->
        plugin.lib, which a plugin DLL links to call back into the program). Without one, nothing
        should be exported, but a linked static library's FUNCTIONs still carry their
        .drectve directives (lld-link cannot drop them). -noimplib keeps that leak from also
        leaving a stray import library in the output folder.
      -->
      <_AsmProgramImportLibraryPath Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmOutputKind)' == 'Executable' and '$(_AsmExportsFilePath)' != ''">$(TargetDir)$(TargetName).lib</_AsmProgramImportLibraryPath>
      <_AsmProgramImportLibraryArgument Condition="'$(_AsmProgramImportLibraryPath)' != ''">-implib:&quot;$(_AsmProgramImportLibraryPath.Replace('\','/'))&quot;</_AsmProgramImportLibraryArgument>
      <_AsmProgramImportLibraryArgument Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmOutputKind)' == 'Executable' and '$(_AsmProgramImportLibraryPath)' == ''">-noimplib</_AsmProgramImportLibraryArgument>
    </PropertyGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- Assemble                                                                               -->
  <!-- ===================================================================================== -->

  <!--
    _AsmReadStructs: the STRUCT lines (the C# bindings' structs, catalog
    asmsdk/plans/csharp-bindings.md phase 3). Before assembling, AsmReadStructs reads each
    source's STRUCT lines and those of the files it includes, lays each struct out as C does on
    this RID, and writes the source's constants (rect.min, rect_size) into
    obj/.../asm/structs/<the source's path>.inc. How each assembler gets them:
      NASM     a pre-include, -P "<that file>" (AsmStructsArgument), after ImplicitUsings' own
      llvm-mc  the source's wrapper includes the file (AsmWriteSourceWrappers); a GNU source with
               structs gets a wrapper even with ImplicitUsings off, since llvm-mc has no
               pre-include option
    Why the SDK reads the lines (the owner's choice, 2026-11-24): GNU macros cannot split a
    pointer field ("uint8_t* data" reaches them as one token), so the macros could not lay a
    struct out on ARM64; one C# computation serves both syntaxes, the API file and the C#
    struct. The STRUCT macro still records its line (the API file is what was assembled) and
    stops the build at a STRUCT this target did not read (one written by another macro).
    Each source gets only the structs it declares or includes, as in C. Runs on every build (no
    Inputs): a STRUCT line in any include may change, and reading a few files costs less than
    listing them; a constants file is rewritten only when its text changes, and the files are
    inputs of AsmAssemble, so a changed layout assembles again. Not for WebAssembly, whose
    sources cannot take STRUCT lines yet (asmsdk-wasm.inc stops on one).
    Errors: ASM0130 (a STRUCT line that does not parse, or a refused field), ASM0136 (one struct
    declared twice, differently), each at its line.
  -->
  <Target Name="_AsmReadStructs"
          DependsOnTargets="AsmPrepare"
          Condition="'$(_AsmRid)' != '' and '$(_AsmArch)' != 'wasm' and '@(_AsmSelectedSource)' != ''">
    <AsmReadStructs Sources="@(_AsmSelectedSource)"
                    IncludeDirectories="@(_AsmIncludeDirectoryOrdered)"
                    ProjectDirectory="$(MSBuildProjectDirectory)"
                    OutputDirectory="$(AsmIntermediateDirectory)structs/"
                    PointerSize="$(_AsmPointerSize)">
      <Output TaskParameter="UpdatedSources" ItemName="_AsmSourceWithStructs" />
      <Output TaskParameter="StructFiles" ItemName="_AsmStructsFile" />
    </AsmReadStructs>
    <!-- The same sources, in the same order, with AsmStructsFile and AsmStructsToolPath set on
         those that have structs: the task returns every item with all its metadata. -->
    <ItemGroup>
      <_AsmSelectedSource Remove="@(_AsmSelectedSource)" />
      <_AsmSelectedSource Include="@(_AsmSourceWithStructs)" />
      <_AsmSourceWithStructs Remove="@(_AsmSourceWithStructs)" />
      <FileWrites Include="@(_AsmStructsFile)" />
    </ItemGroup>
    <!-- Qualified metadata throughout: an unqualified %(...) over items that lack it stops the
         build with MSB4096 (measured, see _AsmSelectedSource in AsmPrepare). The wrapper path is
         the one AsmPrepare gives an ImplicitUsings build, so a source keeps one name for its
         wrapper whatever the reason it has one. -->
    <ItemGroup>
      <_AsmSelectedSource Condition="'%(_AsmSelectedSource.AsmLanguage)' == 'Gnu' and '%(_AsmSelectedSource.AsmStructsToolPath)' != '' and '%(_AsmSelectedSource.SourceWrapper)' == ''">
        <SourceWrapper>$(AsmIntermediateDirectory)implicit/%(_AsmSelectedSource.AsmRecursiveDir)%(_AsmSelectedSource.Filename)%(_AsmSelectedSource.Extension)</SourceWrapper>
      </_AsmSelectedSource>
      <_AsmSelectedSource Condition="'%(_AsmSelectedSource.AsmLanguage)' == 'Gnu' and '%(_AsmSelectedSource.AsmStructsToolPath)' != ''">
        <AssembledToolPath>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/', $([System.IO.Path]::GetFullPath('%(_AsmSelectedSource.SourceWrapper)'))).Replace('\','/'))</AssembledToolPath>
      </_AsmSelectedSource>
      <!-- With its own leading space (%20, which MSBuild cannot trim away), written right after
           the ImplicitUsings argument in AsmAssemble's command: a source without structs keeps
           exactly the command line it had before STRUCT existed (ElfOutputTests reads it). -->
      <_AsmSelectedSource Condition="'%(_AsmSelectedSource.AsmLanguage)' == 'Nasm' and '%(_AsmSelectedSource.AsmStructsToolPath)' != ''">
        <AsmStructsArgument>%20-P &quot;%(_AsmSelectedSource.AsmStructsToolPath)&quot;</AsmStructsArgument>
      </_AsmSelectedSource>
    </ItemGroup>
  </Target>

  <!--
    _AsmWriteSourceWrappers: writes, for each GNU-syntax source that needs one, the file that
    llvm-mc assembles in its place, obj/.../asm/implicit/<the source's path>:
      the defines, as labels               WebAssembly only (llvm-mc's wasm objects hold no
                                           constant symbols, so no defsym; ASM0018)
      .include "asmsdk-gnu-implicit.inc"   with ImplicitUsings (llvm-mc has no pre-include
                                           option, which NASM's -P is for .asm files)
      .include "<the STRUCT constants>"    when the source declares or includes a STRUCT
                                           (_AsmReadStructs)
      # 1 "<the source's full path>"       a line marker, then the source's own text
    Every WebAssembly source gets one, every GNU source of an ImplicitUsings build, and every
    GNU source with STRUCT lines. The
    marker keeps diagnostics and DWARF lines on the source and its own line numbers (an
    .include of the source, AsmSdk's first wrapper, put the wrapper's name in every DWARF row:
    see AsmWriteSourceWrappers for the measurement). The object keeps the generated file's
    relative path as its name, the same on every machine, so a Release build stays
    reproducible. A wrapper is rewritten only when its text changes; the object's own inputs
    (the source, the include files, the project, the options) still decide whether it is
    assembled again.
    Runs on every build (no Inputs): a wrapper holds the source's text, so it must follow every
    edit, and comparing a few files costs less than the up-to-date check would.
  -->
  <Target Name="_AsmWriteSourceWrappers"
          DependsOnTargets="AsmPrepare;_AsmReadStructs"
          Condition="'$(_AsmImplicitUsings)' == 'true' or '$(_AsmArch)' == 'wasm' or '@(_AsmStructsFile)' != ''">
    <PropertyGroup>
      <!-- Found through llvm-mc's include path, where the SDK's include folder comes last, so a
           project's own file of that name would shadow it, as for any other include. A
           WebAssembly build includes its layer directly: asmsdk-gnu.inc reaches it only when
           WASM is defined, and DisableImplicitFrameworkDefines=true takes WASM away, which
           would send the wrapper down the native branch and into its .set guard, a constant
           the wasm writer stops on. -->
      <_AsmImplicitIncludeName Condition="'$(_AsmImplicitUsings)' == 'true' and '$(_AsmArch)' != 'wasm'">asmsdk-gnu-implicit.inc</_AsmImplicitIncludeName>
      <_AsmImplicitIncludeName Condition="'$(_AsmImplicitUsings)' == 'true' and '$(_AsmArch)' == 'wasm'">asmsdk-wasm.inc</_AsmImplicitIncludeName>
    </PropertyGroup>
    <AsmWriteSourceWrappers Condition="'@(_AsmSelectedSource)' != ''"
                            Sources="@(_AsmSelectedSource)"
                            DefineLabels="@(_AsmWasmDefineLabel)"
                            ImplicitInclude="$(_AsmImplicitIncludeName)"
                            ProjectDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="Wrappers" ItemName="FileWrites" />
    </AsmWriteSourceWrappers>
  </Target>

  <!--
    _AsmWriteAssembleOptions: writes every option of both assemblers that is not a file
    (formats, warnings, defines, include folders, ImplicitUsings, AsmFlags, AsmLlvmMcFlags) to
    _AsmAssembleOptionsFile, rewriting it only when the text changes. AsmAssemble lists the
    file among its inputs: before it, a property set outside the project file (on the command
    line, in a Directory.Build.props) changed the assembler's arguments without assembling
    again, and the build linked objects made with the old ones (the project file itself has
    always been an input). One line per assembler, written even when the project has no source
    of that kind: WriteLinesToFile deletes a file it has no lines for, and a missing input would
    assemble every source on every build.
  -->
  <Target Name="_AsmWriteAssembleOptions"
          Condition="'$(_AsmAssembleOptionsFile)' != ''"
          DependsOnTargets="AsmPrepare">
    <!-- The options are metadata, not the item's Include: an Include splits on ";" and expands
         "*" and "?" as a file pattern (dropping the line when nothing matches), and an
         AsmFlags value or a folder name may hold either. Metadata keeps any text as it is, and
         the transform below makes each line one item with that text. -->
    <ItemGroup>
      <_AsmAssembleOptionsLine Include="nasm" Options="$(_AsmNasmMessageArguments) $(_AsmNasmFormatArguments) $(_AsmDebugArguments) $(_AsmWarningArguments) $(_AsmNasmReproducibleArgument) $(AsmFlags) $(_AsmIncludeArguments) $(_AsmDefineArguments) $(_AsmNasmImplicitUsingsArgument)" />
      <!-- WebAssembly's defines are in the wrappers, not on the command line: listed here too,
           so that a changed define assembles again (a wrapper's new text alone would not, its
           object being an output of the source, not of the wrapper). -->
      <_AsmAssembleOptionsLine Include="llvm-mc" Options="--triple=$(_AsmLlvmMcTriple) $(_AsmLlvmMcFeatureArguments) $(_AsmLlvmMcDebugArguments) $(AsmLlvmMcFlags) $(_AsmLlvmMcIncludeArguments) $(_AsmLlvmMcDefineArguments) wasm-defines=@(_AsmWasmDefineLabel, ',') implicit-usings=$(_AsmImplicitUsings)" />
    </ItemGroup>
    <MakeDir Directories="$(AsmIntermediateDirectory)" />
    <WriteLinesToFile File="$(_AsmAssembleOptionsFile)"
                      Lines="@(_AsmAssembleOptionsLine->'%(Identity): %(Options)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_AsmAssembleOptionsFile)" />
      <_AsmAssembleOptionsLine Remove="@(_AsmAssembleOptionsLine)" />
    </ItemGroup>
  </Target>

  <!--
    AsmAssemble: one assembler run per source of this RID (target batching on the selected
    sources): NASM for .asm, llvm-mc for .s. Each batch is skipped when its object is newer than
    the source, every include file, the project file, this SDK's targets (a new SDK version
    may change the arguments) and the assemblers' options (_AsmWriteAssembleOptions: an option
    changed outside the project file). AsmFlags are NASM's extra arguments, AsmLlvmMcFlags llvm-mc's.
    Errors: ASM0004 (a .s source builds this RID, and the toolchain package has no llvm-mc),
    ASM0007 (an assembler run failed; after the assembler's own messages), ASM0019 (llvm-mc's
    WebAssembly object writer stopped on what a wasm object cannot hold; before ASM0007).

    A failed run deletes its object. An assembler that crashes rather than reports an error
    (NASM 3.02 did, with CodeView, before the .rodata mapping above) leaves a truncated object
    behind, newer than its source: the next build would skip the source and fail at link time
    with "unknown file type" (measured). ErrorAndContinue keeps the error and the failed build,
    and lets the Delete run.

    WebAssembly's crashes are llvm-mc's report_fatal_error: its wasm object writer stops the
    process, with "LLVM ERROR: <what>", a request to file a bug and a stack dump, on what the
    format cannot express, for which its parser has no ordinary error (measured with LLVM
    23.1.5, exit code 74, or the illegal-instruction status on Windows). The three a hand
    writer meets: a constant symbol (.set, .equ, = or a defsym: "NAME: absolute addressing not
    supported!"), a data label without .size ("data symbols must have a size set with .size"),
    and two functions in one section ("section already has a defining function", after a bare
    .text, which llvm-mc's wasm parser ignores). The output is captured (ConsoleToMSBuild,
    which still logs it as before) so that ASM0019 can name the source and the rule.
  -->
  <Target Name="AsmAssemble"
          DependsOnTargets="AsmPrepare;_AsmReadStructs;_AsmWriteSourceWrappers;_AsmWriteAssembleOptions"
          Inputs="@(_AsmSelectedSource);@(_AsmDependency);$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(_AsmAssembleOptionsFile);@(_AsmStructsFile)"
          Outputs="%(_AsmSelectedSource.ObjectFile)">
    <Error Code="ASM0004"
           Condition="'%(_AsmSelectedSource.AsmLanguage)' == 'Gnu' and '$(AsmToolchain)' == 'Bundled' and !Exists('$(_AsmLlvmMcPath)')"
           Text="%(_AsmSelectedSource.Identity) is GNU-syntax assembly for llvm-mc, which $(AsmToolchainPackageId) $(AsmToolchainVersion) does not include. Use a toolchain package that has it (AsmToolchainVersion 0.2.0 or later)." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('%(_AsmSelectedSource.ObjectToolPath)'))" />
    <!-- Properties keep their values from one batch to the next: each source starts at 0. -->
    <PropertyGroup>
      <_AsmAssemblerExitCode>0</_AsmAssemblerExitCode>
    </PropertyGroup>
    <Exec Condition="'%(_AsmSelectedSource.AsmLanguage)' == 'Nasm'"
          Command="$(_AsmNasm) $(_AsmNasmMessageArguments) $(_AsmNasmFormatArguments) $(_AsmDebugArguments) $(_AsmWarningArguments) $(_AsmNasmReproducibleArgument) $(AsmFlags) $(_AsmIncludeArguments) $(_AsmDefineArguments) $(_AsmNasmImplicitUsingsArgument)%(_AsmSelectedSource.AsmStructsArgument) -o &quot;%(_AsmSelectedSource.ObjectToolPath)&quot; &quot;%(_AsmSelectedSource.AssembledToolPath)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="ErrorAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_AsmAssemblerExitCode" />
    </Exec>
    <Exec Condition="'%(_AsmSelectedSource.AsmLanguage)' == 'Gnu'"
          Command="$(_AsmLlvmMc) --triple=$(_AsmLlvmMcTriple) --filetype=obj $(_AsmLlvmMcFeatureArguments) $(_AsmLlvmMcDebugArguments) $(AsmLlvmMcFlags) $(_AsmLlvmMcIncludeArguments) $(_AsmLlvmMcDefineArguments) -o &quot;%(_AsmSelectedSource.ObjectToolPath)&quot; &quot;%(_AsmSelectedSource.AssembledToolPath)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="$([System.String]::Equals('$(_AsmArch)', 'wasm'))"
          ContinueOnError="ErrorAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_AsmAssemblerExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_AsmAssemblerOutput" />
    </Exec>
    <!-- The fatal line of a wasm object writer crash, if this run had one (first one only:
         llvm-mc stops at it). The items are this batch's own: removed again below. -->
    <ItemGroup Condition="'$(_AsmAssemblerExitCode)' != '0' and '$(_AsmArch)' == 'wasm'">
      <_AsmWasmFatalLine Include="@(_AsmAssemblerOutput)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('LLVM ERROR:'))" />
    </ItemGroup>
    <Error Code="ASM0019"
           Condition="'@(_AsmWasmFatalLine)' != ''"
           Text="%(_AsmSelectedSource.Identity): llvm-mc's WebAssembly object writer stopped (@(_AsmWasmFatalLine->'%(Identity)', ' ')): the source holds something a wasm object cannot express. The usual three: an assembler constant (.set, .equ or =; use the number itself, or a macro), a data label without a size (follow it with ENDDATA name, or .size name, . - name), or a function that is not in a section of its own (start each with FUNCTION; a bare .text does nothing in llvm-mc's wasm parser). The WebAssembly guide lists the rest." />
    <ItemGroup>
      <_AsmAssemblerOutput Remove="@(_AsmAssemblerOutput)" />
      <_AsmWasmFatalLine Remove="@(_AsmWasmFatalLine)" />
    </ItemGroup>
    <Delete Condition="'$(_AsmAssemblerExitCode)' != '0'" Files="%(_AsmSelectedSource.ObjectFile)" />
    <Error Code="ASM0007"
           Condition="'$(_AsmAssemblerExitCode)' != '0'"
           Text="%(_AsmSelectedSource.Identity): the assembler exited with code $(_AsmAssemblerExitCode); its object file was deleted, so the next build assembles the source again." />
    <ItemGroup>
      <FileWrites Include="%(_AsmSelectedSource.ObjectFile)" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- System libraries and startup code: the C library per OS, kernel32, crt1                -->
  <!-- ===================================================================================== -->

  <!--
    _AsmBuildSystemLibraries: writes the stand-ins for the platform's system libraries into
    obj/.../asm/stubs/ (see the property group at the top of this file for which), from the
    SDK's symbol lists (stubs/*.symbols) and the project's AsmLibcSymbol items:
      Linux libc    AsmWriteCLibraryStub writes the stub's source (NASM for x64, GNU syntax for
                    ARM64), assembled and linked as a shared object under the C library's
                    SONAME; linking against it records DT_NEEDED and creates the PLT/GOT
                    entries, and at run time the real glibc or musl supplies every symbol. The
                    nonshared object (atexit) goes into libasmsdk_nonshared.a.
      macOS libc    a TAPI text stub that ld64.lld reads directly.
      Windows       a module-definition file per DLL, made into an import library by lld-link's
                    library mode (-lib -def:); the libc stdio wrappers into asmsdk_winstdio.lib.
    Skipped while every output is newer than the lists, the SDK's stub sources and the project
    file (where AsmLibcSymbol items live); the task writes a source only when its text changes.
  -->
  <Target Name="_AsmBuildSystemLibraries"
          Condition="'$(_AsmIsLinked)' == 'true' and ('$(_AsmUsesLibc)' == 'true' or '$(_AsmOs)' == 'Windows')"
          DependsOnTargets="AsmPrepare;_AsmComputeSystemLibraries"
          Inputs="@(_AsmSystemLibraryInput);$(MSBuildProjectFullPath)"
          Outputs="@(_AsmSystemLibraryOutput)">
    <MakeDir Directories="$(AsmIntermediateDirectory)stubs" />

    <!-- Linux: the C library stub and the nonshared archive. -->
    <AsmWriteCLibraryStub Condition="'$(_AsmOs)' == 'Linux'"
                          Format="$(_AsmStubFormat)"
                          SymbolFiles="$(AsmFoundationSdkDirectory)stubs/linux.symbols"
                          ExtraSymbols="@(AsmLibcSymbol)"
                          OutputPath="$(_AsmStubToolDirectory)libc-stub$(_AsmStubSourceExtension)" />
    <Exec Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmArch)' == 'x64'"
          Command="$(_AsmNasm) $(_AsmNasmMessageArguments) -f elf64 $(_AsmSdkSourceWarningArguments) -o &quot;$(_AsmStubToolDirectory)libc-stub.o&quot; &quot;$(_AsmStubToolDirectory)libc-stub.asm&quot;" />
    <Exec Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmArch)' == 'arm64'"
          Command="$(_AsmLlvmMc) --triple=$(_AsmLlvmMcTriple) --filetype=obj -o &quot;$(_AsmStubToolDirectory)libc-stub.o&quot; &quot;$(_AsmStubToolDirectory)libc-stub.s&quot;" />
    <Exec Condition="'$(_AsmOs)' == 'Linux'"
          Command="$(_AsmLinker) -shared -soname $(_AsmLibcStubName) -o &quot;$(_AsmStubToolDirectory)$(_AsmLibcStubName)&quot; &quot;$(_AsmStubToolDirectory)libc-stub.o&quot;" />
    <!-- The SDK's own sources that end up in what a project ships (the nonshared object here,
         the stdio wrappers and the startup code below) are assembled in their own folder, by
         file name: an ELF object records the name it was given (its file symbol), which the
         linker keeps in a program's or library's symbol table, and the SDK's folder is in the
         NuGet cache, a different path on every machine. A project's sources are passed
         relative to the project folder for the same reason (see AsmAssemble). -->
    <Exec Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmArch)' == 'x64'"
          Command="$(_AsmNasm) $(_AsmNasmMessageArguments) -f elf64 $(_AsmSdkSourceWarningArguments) -o &quot;$(_AsmStubToolDirectory)nonshared.o&quot; nonshared-x64.asm"
          WorkingDirectory="$(_AsmSdkStubSourceDirectory)" />
    <Exec Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmArch)' == 'arm64'"
          Command="$(_AsmLlvmMc) --triple=$(_AsmLlvmMcTriple) --filetype=obj -o &quot;$(_AsmStubToolDirectory)nonshared.o&quot; nonshared-arm64.s"
          WorkingDirectory="$(_AsmSdkStubSourceDirectory)" />
    <Delete Condition="'$(_AsmOs)' == 'Linux'" Files="$(AsmIntermediateDirectory)stubs/libasmsdk_nonshared.a" />
    <Exec Condition="'$(_AsmOs)' == 'Linux'"
          Command="$(_AsmArchiver) rcsD $(_AsmSystemArchiveFormatArgument) &quot;$(_AsmStubToolDirectory)libasmsdk_nonshared.a&quot; &quot;$(_AsmStubToolDirectory)nonshared.o&quot;" />

    <!-- macOS: libSystem's text stub. -->
    <AsmWriteCLibraryStub Condition="'$(_AsmOs)' == 'MacOS'"
                          Format="Tbd"
                          SymbolFiles="$(AsmFoundationSdkDirectory)stubs/macos.symbols"
                          ExtraSymbols="@(AsmLibcSymbol)"
                          LibraryName="/usr/lib/libSystem.B.dylib"
                          Target="$(_AsmTbdTarget)"
                          OutputPath="$(_AsmStubToolDirectory)libSystem.tbd" />

    <!-- Windows: kernel32 always; for libc the UCRT and the stdio wrappers. -->
    <AsmWriteCLibraryStub Condition="'$(_AsmOs)' == 'Windows'"
                          Format="Def"
                          SymbolFiles="$(AsmFoundationSdkDirectory)stubs/kernel32.symbols"
                          LibraryName="kernel32.dll"
                          OutputPath="$(_AsmStubToolDirectory)kernel32.def" />
    <Exec Condition="'$(_AsmOs)' == 'Windows'"
          Command="$(_AsmLibrarian) -def:&quot;$(_AsmStubToolDirectory)kernel32.def&quot; -machine:$(_AsmPeMachine) -out:&quot;$(_AsmStubToolDirectory)kernel32.lib&quot;" />
    <AsmWriteCLibraryStub Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmUsesLibc)' == 'true'"
                          Format="Def"
                          SymbolFiles="$(AsmFoundationSdkDirectory)stubs/ucrtbase.symbols"
                          ExtraSymbols="@(AsmLibcSymbol)"
                          LibraryName="ucrtbase.dll"
                          OutputPath="$(_AsmStubToolDirectory)ucrtbase.def" />
    <Exec Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmUsesLibc)' == 'true'"
          Command="$(_AsmLibrarian) -def:&quot;$(_AsmStubToolDirectory)ucrtbase.def&quot; -machine:$(_AsmPeMachine) -out:&quot;$(_AsmStubToolDirectory)ucrtbase.lib&quot;" />
    <Exec Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmUsesLibc)' == 'true' and '$(_AsmArch)' == 'x64'"
          Command="$(_AsmNasm) $(_AsmNasmMessageArguments) -f win64 $(_AsmSdkSourceWarningArguments) -o &quot;$(_AsmStubToolDirectory)winstdio.obj&quot; winstdio-x64.asm"
          WorkingDirectory="$(_AsmSdkStubSourceDirectory)" />
    <Exec Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmUsesLibc)' == 'true' and '$(_AsmArch)' == 'arm64'"
          Command="$(_AsmLlvmMc) --triple=$(_AsmLlvmMcTriple) --filetype=obj -o &quot;$(_AsmStubToolDirectory)winstdio.obj&quot; winstdio-arm64.s"
          WorkingDirectory="$(_AsmSdkStubSourceDirectory)" />
    <Delete Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmUsesLibc)' == 'true'" Files="$(AsmIntermediateDirectory)stubs/asmsdk_winstdio.lib" />
    <Exec Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmUsesLibc)' == 'true'"
          Command="$(_AsmArchiver) rcsD $(_AsmSystemArchiveFormatArgument) &quot;$(_AsmStubToolDirectory)asmsdk_winstdio.lib&quot; &quot;$(_AsmStubToolDirectory)winstdio.obj&quot;" />

    <ItemGroup>
      <FileWrites Include="$(AsmIntermediateDirectory)stubs/**" />
    </ItemGroup>
  </Target>

  <!--
    _AsmComputeSystemLibraries: the inputs and outputs of _AsmBuildSystemLibraries for this RID,
    and the tool settings the stubs share. The SDK's own sources are always assembled with
    llvm-mc's ARM64 triple or NASM, whichever the RID's CPU needs, so a project that has no .s
    file still needs llvm-mc for an ARM64 libc build.
  -->
  <Target Name="_AsmComputeSystemLibraries" DependsOnTargets="AsmPrepare">
    <PropertyGroup>
      <_AsmSdkStubSourceDirectory>$(AsmFoundationSdkDirectory.Replace('\','/'))stubs/</_AsmSdkStubSourceDirectory>
      <_AsmStubFormat Condition="'$(_AsmArch)' == 'x64'">Nasm</_AsmStubFormat>
      <_AsmStubFormat Condition="'$(_AsmArch)' == 'arm64'">Gnu</_AsmStubFormat>
      <_AsmStubSourceExtension Condition="'$(_AsmArch)' == 'x64'">.asm</_AsmStubSourceExtension>
      <_AsmStubSourceExtension Condition="'$(_AsmArch)' == 'arm64'">.s</_AsmStubSourceExtension>
      <!-- lld-link's library mode ("lib.exe"), from the same lld binary; the System toolchain
           names it through AsmLinkerCommand, an lld-link, with -lib. -->
      <_AsmLibrarian>$(_AsmLinker) -lib</_AsmLibrarian>
      <!-- The archive format of this OS, for the bundled llvm-ar (see AsmLink). -->
      <_AsmSystemArchiveFormatArgument Condition="'$(AsmToolchain)' == 'Bundled' and '$(_AsmOs)' == 'Windows'">--format=coff</_AsmSystemArchiveFormatArgument>
      <_AsmSystemArchiveFormatArgument Condition="'$(AsmToolchain)' == 'Bundled' and '$(_AsmOs)' == 'Linux'">--format=gnu</_AsmSystemArchiveFormatArgument>
      <!-- The macOS stub serves this RID's CPU only, as the link does. -->
      <_AsmTbdTarget Condition="'$(_AsmArch)' == 'x64'">x86_64-macos</_AsmTbdTarget>
      <_AsmTbdTarget Condition="'$(_AsmArch)' == 'arm64'">arm64-macos</_AsmTbdTarget>
      <!-- The startup code of a libc executable (_AsmBuildCrt). -->
      <_AsmCrtSource Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmArch)' == 'x64'">$(AsmFoundationSdkDirectory)stubs/crt1.asm</_AsmCrtSource>
      <_AsmCrtSource Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmArch)' == 'arm64'">$(AsmFoundationSdkDirectory)stubs/crt1-arm64.s</_AsmCrtSource>
      <_AsmCrtSource Condition="'$(_AsmOs)' == 'Windows'">$(AsmFoundationSdkDirectory)stubs/wincrt-$(_AsmArch)$(_AsmStubSourceExtension)</_AsmCrtSource>
      <!-- Its file name alone: _AsmBuildCrt assembles it in the stubs folder. -->
      <_AsmCrtSourceName Condition="'$(_AsmCrtSource)' != ''">$([System.IO.Path]::GetFileName('$(_AsmCrtSource)'))</_AsmCrtSourceName>
      <_AsmCrtObjectName Condition="'$(_AsmOs)' == 'Linux'">crt1.o</_AsmCrtObjectName>
      <_AsmCrtObjectName Condition="'$(_AsmOs)' == 'Windows'">wincrt.obj</_AsmCrtObjectName>
    </PropertyGroup>
    <!-- The SDK's ARM64 stub and startup sources are GNU syntax: an ARM64 libc build needs
         llvm-mc even when the project has no .s file (ASM0004, as for a project's own). -->
    <Error Code="ASM0004"
           Condition="'$(_AsmUsesLibc)' == 'true' and '$(_AsmArch)' == 'arm64' and '$(AsmToolchain)' == 'Bundled' and !Exists('$(_AsmLlvmMcPath)')"
           Text="A libc build for $(_AsmRid) assembles the SDK's GNU-syntax C library stubs with llvm-mc, which $(AsmToolchainPackageId) $(AsmToolchainVersion) does not include. Use a toolchain package that has it (AsmToolchainVersion 0.2.0 or later)." />
    <ItemGroup>
      <_AsmSystemLibraryInput Include="$(AsmFoundationSdkDirectory)stubs/linux.symbols;$(AsmFoundationSdkDirectory)stubs/nonshared-$(_AsmArch)$(_AsmStubSourceExtension)" Condition="'$(_AsmOs)' == 'Linux'" />
      <_AsmSystemLibraryOutput Include="$(AsmIntermediateDirectory)stubs/$(_AsmLibcStubName);$(AsmIntermediateDirectory)stubs/libasmsdk_nonshared.a" Condition="'$(_AsmOs)' == 'Linux'" />
      <_AsmSystemLibraryInput Include="$(AsmFoundationSdkDirectory)stubs/macos.symbols" Condition="'$(_AsmOs)' == 'MacOS'" />
      <_AsmSystemLibraryOutput Include="$(AsmIntermediateDirectory)stubs/libSystem.tbd" Condition="'$(_AsmOs)' == 'MacOS'" />
      <_AsmSystemLibraryInput Include="$(AsmFoundationSdkDirectory)stubs/kernel32.symbols" Condition="'$(_AsmOs)' == 'Windows'" />
      <_AsmSystemLibraryOutput Include="$(AsmIntermediateDirectory)stubs/kernel32.lib" Condition="'$(_AsmOs)' == 'Windows'" />
      <_AsmSystemLibraryInput Include="$(AsmFoundationSdkDirectory)stubs/ucrtbase.symbols;$(AsmFoundationSdkDirectory)stubs/winstdio-$(_AsmArch)$(_AsmStubSourceExtension)" Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmUsesLibc)' == 'true'" />
      <_AsmSystemLibraryOutput Include="$(AsmIntermediateDirectory)stubs/ucrtbase.lib;$(AsmIntermediateDirectory)stubs/asmsdk_winstdio.lib" Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmUsesLibc)' == 'true'" />
    </ItemGroup>
  </Target>

  <!--
    _AsmBuildCrt: assembles the startup code of a libc executable, so that the program's entry
    is an ordinary int main(int argc, char **argv):
      Linux    crt1.asm (x64) / crt1-arm64.s (ARM64): _start, then __libc_start_main(main, ...)
               exactly like the C library's own crt1.o; glibc and musl take the same arguments
      Windows  wincrt-x64.asm / wincrt-arm64.s: mainCRTStartup, over the UCRT
    Skipped when StartupObject names another symbol: the program then provides its own entry,
    and must do what the startup code does. macOS needs none (dyld calls main).
  -->
  <Target Name="_AsmBuildCrt"
          Condition="'$(_AsmUsesCrt)' == 'true'"
          DependsOnTargets="AsmPrepare;_AsmComputeSystemLibraries"
          Inputs="$(_AsmCrtSource)"
          Outputs="$(AsmIntermediateDirectory)stubs/$(_AsmCrtObjectName)">
    <MakeDir Directories="$(AsmIntermediateDirectory)stubs" />
    <!-- In the SDK's stubs folder, by file name: crt1.o is linked into every Linux libc program,
         and its file symbol must not record the NuGet cache's path (see _AsmBuildSystemLibraries). -->
    <Exec Condition="'$(_AsmArch)' == 'x64'"
          Command="$(_AsmNasm) $(_AsmNasmMessageArguments) -f $(_AsmNasmFormat) $(_AsmSdkSourceWarningArguments) -o &quot;$(_AsmStubToolDirectory)$(_AsmCrtObjectName)&quot; $(_AsmCrtSourceName)"
          WorkingDirectory="$(_AsmSdkStubSourceDirectory)" />
    <Exec Condition="'$(_AsmArch)' == 'arm64'"
          Command="$(_AsmLlvmMc) --triple=$(_AsmLlvmMcTriple) --filetype=obj -o &quot;$(_AsmStubToolDirectory)$(_AsmCrtObjectName)&quot; $(_AsmCrtSourceName)"
          WorkingDirectory="$(_AsmSdkStubSourceDirectory)" />
    <ItemGroup>
      <FileWrites Include="$(AsmIntermediateDirectory)stubs/$(_AsmCrtObjectName)" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- A program's dependencies: shared libraries, referenced programs, run paths             -->
  <!-- ===================================================================================== -->

  <!--
    _AsmResolveProgramDependencies: where a program (one RID) keeps what it needs at run time,
    and the run paths that make the OS loader find its libraries there.
    AsmLayOutProgramDependencies has the rules; in short:
      which    the runtime file of each shared link input from a referenced asm project or an asm
               package (AsmRuntimeFile; on Windows the DLL behind the import library), and its
               PDB; and the files of each asm program the project references (AsmReferencedProgram:
               a ProjectReference's, from GetAsmLinkInputs, or a package's, from its props), each
               at its path relative to that program, so its own run paths keep working
      where    BinariesCopyPath on the ProjectReference or PackageReference, then the project's
               BinariesCopyPath property, then Auto, which for a program is its own folder:
                 <ProjectReference Include="../Calc/Calc.asmproj" BinariesCopyPath="lib/{rid}" />
      run path one per library folder: $ORIGIN/<folder> (Linux DT_RUNPATH), @loader_path/<folder>
               (macOS LC_RPATH); Windows has none, so a library folder other than the program's
               own is ASM0047 (a referenced program may go anywhere: it is started, not loaded)
    The files are copied by _AsmCopyProgramDependencies (into the build output) and published by
    _AsmAddOwnPublishFiles, and they travel with the program to whatever references it
    (_AsmComputeProgramBundle in References.targets). The run paths are linked by AsmLink, and
    written to _AsmRunPathFile, an input of AsmLink, so that changing them relinks.
    Only for a program: a shared library's dependencies are laid out by whatever loads it.
  -->
  <Target Name="_AsmResolveProgramDependencies"
          Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' == 'Executable'"
          DependsOnTargets="AsmPrepare">
    <ItemGroup>
      <_AsmProgramProjectReference Include="@(_MSBuildProjectReferenceExistent)" Condition="'%(Extension)' == '.asmproj'" />
    </ItemGroup>
    <AsmLayOutProgramDependencies LinkLibraries="@(NativeLibrary)"
                                  ReferencedPrograms="@(AsmReferencedProgram)"
                                  ProjectReferences="@(_AsmProgramProjectReference)"
                                  PackageReferences="@(PackageReference)"
                                  ProjectBinariesCopyPath="$(BinariesCopyPath)"
                                  RuntimeIdentifier="$(_AsmRid)"
                                  TargetOs="$(_AsmOs)"
                                  ProjectFile="$(MSBuildProjectFullPath)">
      <Output TaskParameter="Files" ItemName="_AsmProgramDependency" />
      <Output TaskParameter="RunPathArguments" PropertyName="_AsmRunPathArguments" />
    </AsmLayOutProgramDependencies>
    <!-- One line even with no run path: WriteLinesToFile deletes the file when it has no lines
         to write, and a missing input would make AsmLink relink on every build. -->
    <WriteLinesToFile File="$(_AsmRunPathFile)" Lines="run paths: $(_AsmRunPathArguments)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_AsmRunPathFile)" />
      <_AsmProgramProjectReference Remove="@(_AsmProgramProjectReference)" />
    </ItemGroup>
  </Target>

  <!--
    _AsmCopyProgramDependencies: the program's shared libraries and referenced programs into the
    build output, where _AsmResolveProgramDependencies put them, so that the program runs from
    bin/ as it is (dotnet run included). Skipped in an IDE's design-time build, which links
    nothing either. Copies only what changed; dotnet clean removes the copies (FileWrites).
  -->
  <Target Name="_AsmCopyProgramDependencies"
          Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' == 'Executable' and '$(DesignTimeBuild)' != 'true' and '$(SkipCompilerExecution)' != 'true'"
          DependsOnTargets="_AsmResolveProgramDependencies">
    <Copy Condition="'@(_AsmProgramDependency)' != ''"
          SourceFiles="@(_AsmProgramDependency)"
          DestinationFiles="@(_AsmProgramDependency->'$(TargetDir)%(TargetPath)')"
          SkipUnchangedFiles="true"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

  <!--
    _AsmCopyOwnContent: the project's None and Content items that ask for it with
    CopyToOutputDirectory, into each RID's output folder at their TargetPath, as a .csproj copies
    them (a program's data files then sit next to it in bin/, as they will in its publish
    folder): Always on every build, PreserveNewest and IfDifferent when the source changed (the
    Copy task's size and time check). AsmSdk 0.3.0 and earlier ignored the metadata: the
    replaced CopyFilesToOutputDirectory copied nothing.
  -->
  <Target Name="_AsmCopyOwnContent"
          Condition="'$(_AsmRid)' != '' and '$(DesignTimeBuild)' != 'true' and '$(SkipCompilerExecution)' != 'true'"
          DependsOnTargets="AssignTargetPaths">
    <ItemGroup>
      <!-- One line per list, each with qualified metadata: an unqualified %(CopyToOutputDirectory)
           over two lists requires every item to define it (MSB4096, measured), and most None
           items (sources' neighbors, a README) define nothing. -->
      <_AsmOwnCopyItem Include="@(_NoneWithTargetPath)" Condition="'%(_NoneWithTargetPath.CopyToOutputDirectory)' == 'Always' or '%(_NoneWithTargetPath.CopyToOutputDirectory)' == 'PreserveNewest' or '%(_NoneWithTargetPath.CopyToOutputDirectory)' == 'IfDifferent'" />
      <_AsmOwnCopyItem Include="@(ContentWithTargetPath)" Condition="'%(ContentWithTargetPath.CopyToOutputDirectory)' == 'Always' or '%(ContentWithTargetPath.CopyToOutputDirectory)' == 'PreserveNewest' or '%(ContentWithTargetPath.CopyToOutputDirectory)' == 'IfDifferent'" />
    </ItemGroup>
    <!-- Two Copy calls, batched by the metadata: Always must not skip an unchanged file. -->
    <Copy Condition="'@(_AsmOwnCopyItem)' != '' and '%(_AsmOwnCopyItem.CopyToOutputDirectory)' == 'Always'"
          SourceFiles="@(_AsmOwnCopyItem)"
          DestinationFiles="@(_AsmOwnCopyItem->'$(TargetDir)%(TargetPath)')"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
    <Copy Condition="'@(_AsmOwnCopyItem)' != '' and '%(_AsmOwnCopyItem.CopyToOutputDirectory)' != 'Always'"
          SourceFiles="@(_AsmOwnCopyItem)"
          DestinationFiles="@(_AsmOwnCopyItem->'$(TargetDir)%(TargetPath)')"
          SkipUnchangedFiles="true"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
    <ItemGroup>
      <_AsmOwnCopyItem Remove="@(_AsmOwnCopyItem)" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- Link                                                                                   -->
  <!-- ===================================================================================== -->

  <!--
    AsmLink: produces the project's output(s) from the objects. Skipped when every output is
    newer than every object, link input and the project file.

    Shared library: the code must be position-independent (NASM: "default rel", calls through
    "wrt ..plt"); -z now + relro make the GOT read-only once loaded; the sha1 build id is
    derived from the content, so identical inputs give identical outputs. Linux shared
    libraries are linked -Bsymbolic: a reference from the library to its own global symbol
    binds to that symbol, never to one of the same name in the executable or another library
    (ELF's default "interposition"). Without it, a PC-relative reference to a global function
    or variable (lea [rel x], an adrp of asmsdk-gnu.inc's ADDRESS) failed to link, "relocation
    R_AARCH64_ADR_PREL_PG_HI21 cannot be used against symbol; recompile with -fPIC" (measured
    on linux-arm64), and every call between the library's own functions went through its PLT.
    Windows and macOS libraries bind this way already. A library that wants interposition back
    adds the LinkerArg -Bno-symbolic, which comes later on the line and wins.
    Executable: freestanding links -static with the entry _start (or StartupObject); libc
    links a PIE with glibc's dynamic loader and the SDK's crt1.o in front.
    Static library: llvm-ar "rcsD" = replace, create, write the symbol index the linker needs,
    deterministic (zero timestamps and ids). The archive is deleted first because "r" would
    keep members of objects that no longer exist.
    Every link line ends with the ExportsFile version script and the LinkerArg items, so a
    project's own arguments come last and can override the SDK's defaults.
    A program that links asm shared libraries gets their run paths ($(_AsmRunPathArguments),
    from _AsmResolveProgramDependencies) before those, on Linux and macOS: none for a program that
    links none, so its output stays byte for byte what it was.
  -->
  <Target Name="AsmLink"
          Condition="'$(_AsmOutputKind)' != 'Objects'"
          DependsOnTargets="AsmAssemble;_AsmBuildSystemLibraries;_AsmBuildCrt;_AsmResolveProgramDependencies"
          Inputs="@(_AsmObject);@(_AsmLinkInput);$(_AsmExportsFilePath);$(MSBuildProjectFullPath);$(_AsmRunPathFile)"
          Outputs="$(TargetPath);$(AsmStaticLibraryPath)">
    <!--
      A freestanding program cannot exist on macOS: Apple supports no static executables, and
      every Mach-O program is started by dyld, which requires libSystem.
    -->
    <Error Code="ASM0015" Condition="'$(_AsmOs)' == 'MacOS' and '$(_AsmOutputKind)' == 'Executable' and '$(_AsmRuntime)' != 'Libc'"
           Text="A freestanding executable cannot be built for $(_AsmRid): macOS starts every program through dyld and libSystem, and supports no static executables. Use &lt;TargetFramework&gt;libc&lt;/TargetFramework&gt; for a macOS program, or build a library." />

    <PropertyGroup>
      <!-- StartupObject is .NET's "where the program starts"; for assembly code that is the
           entry symbol. Empty means _start: the program's own, or crt1's for libc. -->
      <_AsmEntrySymbol>$([MSBuild]::ValueOrDefault('$(StartupObject)', '_start'))</_AsmEntrySymbol>
      <!-- A Windows libc program starts in the SDK's mainCRTStartup (wincrt), which calls main. -->
      <_AsmEntrySymbol Condition="'$(_AsmUsesCrt)' == 'true' and '$(_AsmOs)' == 'Windows'">mainCRTStartup</_AsmEntrySymbol>

      <!-- ELF (ld.lld): a non-executable stack and a build id derived from the content, so
           identical inputs give identical outputs. -->
      <_AsmCommonLinkArguments Condition="'$(_AsmOs)' == 'Linux'">-z noexecstack --build-id=sha1 $(_AsmExportsFileArgument) $(_AsmLinkerArgArguments)</_AsmCommonLinkArguments>
      <_AsmEntryArgument Condition="'$(_AsmOs)' == 'Linux'">-e $(_AsmEntrySymbol)</_AsmEntryArgument>

      <!-- PE/COFF (lld-link): no default libraries (the SDK names every input, kernel32 and the
           UCRT included), the machine (_AsmPeMachine, set with the RID), and -Brepro, which
           derives the timestamp from the content, like the build id. A PDB when debug symbols
           are on (NASM wrote CodeView into the objects). -->
      <_AsmCommonLinkArguments Condition="'$(_AsmOs)' == 'Windows'">-nodefaultlib -machine:$(_AsmPeMachine) -Brepro $(_AsmExportsFileArgument) $(_AsmLinkerArgArguments)</_AsmCommonLinkArguments>
      <_AsmCommonLinkArguments Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmDebugSymbols)' == 'true'">-debug $(_AsmCommonLinkArguments)</_AsmCommonLinkArguments>
      <_AsmEntryArgument Condition="'$(_AsmOs)' == 'Windows'">-entry:$(_AsmEntrySymbol)</_AsmEntryArgument>

      <!-- Mach-O (ld64.lld): the CPU and the macOS versions (minimum and SDK) that Mach-O
           records; ld64.lld signs arm64 output ad hoc by itself, which Apple silicon requires
           of every binary. -->
      <_AsmMachOArch Condition="'$(_AsmArch)' == 'arm64'">arm64</_AsmMachOArch>
      <_AsmMachOArch Condition="'$(_AsmMachOArch)' == ''">x86_64</_AsmMachOArch>
      <_AsmCommonLinkArguments Condition="'$(_AsmOs)' == 'MacOS'">-arch $(_AsmMachOArch) -platform_version macos $(AsmMacOSMinimumVersion) $(AsmMacOSMinimumVersion) $(_AsmExportsFileArgument) $(_AsmLinkerArgArguments)</_AsmCommonLinkArguments>
      <!-- A Mach-O program starts at _main through LC_MAIN, ld64.lld's default; StartupObject
           names another C symbol (Mach-O adds the underscore). -->
      <_AsmEntryArgument Condition="'$(_AsmOs)' == 'MacOS' and '$(StartupObject)' != ''">-e _$(StartupObject)</_AsmEntryArgument>

      <!--
        WebAssembly (wasm-ld): the exports (_AsmExportsFileArgument: export-dynamic, or the
        ExportsFile's names) and the LinkerArg items. Nothing else is needed for a deterministic
        module: wasm-ld writes no time stamp or build id, and its name section (the functions'
        names, for stack traces) comes from the objects. Its defaults stay: a linear memory of
        its own, exported as "memory", with a 64 KiB stack below the data; garbage collection
        of unreferenced functions and data (the define labels' empty segment included); an
        undefined function is an error unless it was declared an import (IMPORT_FUNCTION).
        LinkerArg changes any of it: initial-memory, -z stack-size, import-memory, allow-undefined.
        A WASI program enters at _start, WASI's own entry name (or StartupObject's symbol), and
        exports it and the memory, as a WASI host expects of a command.
      -->
      <_AsmCommonLinkArguments Condition="'$(_AsmArch)' == 'wasm'">$(_AsmExportsFileArgument) $(_AsmLinkerArgArguments)</_AsmCommonLinkArguments>
      <_AsmEntryArgument Condition="'$(_AsmArch)' == 'wasm'">--entry=$(_AsmEntrySymbol)</_AsmEntryArgument>

      <!-- Static archives in each OS's own format: COFF archives for lld-link, Darwin archives
           (BSD with a sorted symbol table) for ld64.lld, GNU archives for ld.lld. The format
           is named for the bundled llvm-ar only: GNU ar (the System toolchain's default) has
           no such option and writes its host's format anyway. -->
      <_AsmArchiveFormat Condition="'$(_AsmOs)' == 'Windows'">coff</_AsmArchiveFormat>
      <_AsmArchiveFormat Condition="'$(_AsmOs)' == 'MacOS'">darwin</_AsmArchiveFormat>
      <_AsmArchiveFormat Condition="'$(_AsmArchiveFormat)' == ''">gnu</_AsmArchiveFormat>
      <_AsmArchiveFormatArgument Condition="'$(AsmToolchain)' == 'Bundled'">--format=$(_AsmArchiveFormat)</_AsmArchiveFormatArgument>
    </PropertyGroup>

    <MakeDir Directories="$(TargetDir)" />

    <!-- Linux (ELF) -->
    <Exec Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmOutputKind)' == 'SharedLibrary'"
          Command="$(_AsmLinker) -shared -soname $(TargetFileName) -Bsymbolic -z relro -z now --hash-style=gnu -o $(_AsmTargetPathArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmLibcArguments) $(_AsmCommonLinkArguments)" />

    <!-- A static program loads no library at all: it gets no run path (and ld.lld would refuse
         a shared library on its line anyway). -->
    <Exec Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmOutputKind)' == 'Executable' and '$(_AsmRuntime)' != 'Libc'"
          Command="$(_AsmLinker) -static $(_AsmEntryArgument) -o $(_AsmTargetPathArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmCommonLinkArguments)" />

    <Exec Condition="'$(_AsmOs)' == 'Linux' and '$(_AsmOutputKind)' == 'Executable' and '$(_AsmRuntime)' == 'Libc'"
          Command="$(_AsmLinker) -pie --dynamic-linker $(AsmDynamicLinker) -z relro -z now --hash-style=gnu $(_AsmEntryArgument) -o $(_AsmTargetPathArgument) $(_AsmCrtArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmLibcArguments) $(_AsmRunPathArguments) $(_AsmCommonLinkArguments)" />

    <!-- Windows (PE/COFF). A DLL has no entry point of its own (-noentry: nothing to run when
         it loads), and its import library goes next to it, for native consumers. -->
    <Exec Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmOutputKind)' == 'SharedLibrary'"
          Command="$(_AsmLinker) -dll -noentry -out:$(_AsmTargetPathArgument) -implib:&quot;$(AsmImportLibraryPath.Replace('\','/'))&quot; $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmLibcArguments) $(_AsmSystemLibraryArguments) $(_AsmCommonLinkArguments)" />

    <!-- A console program, freestanding (entry _start or StartupObject; kernel32 for I/O) or
         libc (entry mainCRTStartup, from the SDK's wincrt). Its import library only when its
         ExportsFile exports something (see _AsmProgramImportLibraryPath). -->
    <Exec Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmOutputKind)' == 'Executable'"
          Command="$(_AsmLinker) -subsystem:console $(_AsmEntryArgument) -out:$(_AsmTargetPathArgument) $(_AsmProgramImportLibraryArgument) $(_AsmCrtArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmLibcArguments) $(_AsmSystemLibraryArguments) $(_AsmCommonLinkArguments)" />

    <!-- macOS (Mach-O). @rpath in the install name: a program that links the dylib finds it
         through its own run paths, the convention for libraries shipped with an app. -->
    <Exec Condition="'$(_AsmOs)' == 'MacOS' and '$(_AsmOutputKind)' == 'SharedLibrary'"
          Command="$(_AsmLinker) -dylib -install_name @rpath/$(TargetFileName) -o $(_AsmTargetPathArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmLibcArguments) $(_AsmCommonLinkArguments)" />

    <!-- A program (libc only, ASM0015 above): dyld loads libSystem and calls main, and finds
         the program's @rpath dylibs through its LC_RPATH entries. -->
    <Exec Condition="'$(_AsmOs)' == 'MacOS' and '$(_AsmOutputKind)' == 'Executable'"
          Command="$(_AsmLinker) -execute $(_AsmEntryArgument) -o $(_AsmTargetPathArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmLibcArguments) $(_AsmRunPathArguments) $(_AsmCommonLinkArguments)" />

    <!-- WebAssembly (wasm-ld). A library is a module without an entry point (no-entry: a
         reactor, which JavaScript or a host calls through its exports); its archive for .NET
         WebAssembly apps and other asm projects is written below, like any static library. A
         program is a WASI command (wasi-wasm only; browser-wasm is ASM0017). Link inputs are
         archives and objects (a wasm module cannot be linked against). -->
    <Exec Condition="'$(_AsmArch)' == 'wasm' and '$(_AsmOutputKind)' == 'SharedLibrary'"
          Command="$(_AsmLinker) --no-entry -o $(_AsmTargetPathArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmCommonLinkArguments)" />
    <Exec Condition="'$(_AsmArch)' == 'wasm' and '$(_AsmOutputKind)' == 'Executable'"
          Command="$(_AsmLinker) $(_AsmEntryArgument) -o $(_AsmTargetPathArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmCommonLinkArguments)" />

    <!--
      The fixups the loader must apply, checked where the linker does not (AsmCheckImage):
      ASM0080 for a 32-bit absolute address in a 64-bit Windows image, which lld-link links
      into a DLL based at 0x180000000 without a word (a NASM memory operand without "default
      rel"); ASM0081 for a fixup in a read-only Mach-O segment, a text relocation ld64.lld
      writes and Apple's ld refuses. ld.lld refuses both on Linux by itself. A failed check
      deletes the image: kept, it would be newer than every input, and the next build would
      skip this link and its check, leaving the broken image in place.
    -->
    <AsmCheckImage Condition="'$(_AsmIsLinked)' == 'true' and ('$(_AsmOs)' == 'Windows' or '$(_AsmOs)' == 'MacOS')"
                   ImagePath="$(TargetPath)"
                   Os="$(_AsmOs)"
                   ContinueOnError="ErrorAndContinue" />
    <Delete Condition="'$(_AsmIsLinked)' == 'true' and ('$(_AsmOs)' == 'Windows' or '$(_AsmOs)' == 'MacOS') and '$(MSBuildLastTaskResult)' == 'false'"
            Files="$(TargetPath)" />

    <!--
      A WebAssembly library's archive holds what its module holds: the library's objects AND the
      static libraries and object files it links, the way a native shared library contains the
      static libraries linked into it. The archive is what a .NET WebAssembly app links in place
      of the module, and a shared library's references to static libraries are private (see
      _AsmMakeStaticLibraryReferencesPrivate in References.targets), so without their members
      the app's link would miss their symbols. llvm-ar's MRI script mode adds another archive's
      members whole (ADDLIB), keeping two members of one name apart, which extracting them would
      not; the result is deterministic and carries the symbol index (measured: an archive merged
      this way links alone, and next to the original static library in either order, with no
      duplicate symbol, because wasm-ld takes a member only for a symbol still undefined). Each
      path is quoted: MRI takes the rest of a line as the argument, and ';' or '*' would start a
      comment there. Only a library's archive: a static library's users link what it links, as
      on every other platform.
    -->
    <!-- Qualified metadata throughout: an unqualified %(...) in an element that adds to
         _AsmMergedArchiveLine would batch over that list too, whose CREATE line has no ToolPath
         (MSB4096, measured). -->
    <ItemGroup Condition="'$(_AsmArch)' == 'wasm' and '$(_AsmOutputKind)' == 'SharedLibrary' and '$(AsmStaticLibraryPath)' != ''">
      <_AsmMergedArchiveLine Include="CREATE" Text="CREATE &quot;$(AsmStaticLibraryPath.Replace('\','/'))&quot;" />
      <_AsmMergedArchiveLine Include="@(_AsmObject->'ADDMOD %(Identity)')" Text="ADDMOD &quot;%(_AsmObject.Identity)&quot;" />
      <_AsmMergedArchiveLine Include="@(_AsmLinkInput->'ADDMOD %(ToolPath)')" Condition="'%(_AsmLinkInput.Extension)' != '.a'" Text="ADDMOD &quot;%(_AsmLinkInput.ToolPath)&quot;" />
      <_AsmMergedArchiveLine Include="@(_AsmLinkInput->'ADDLIB %(ToolPath)')" Condition="'%(_AsmLinkInput.Extension)' == '.a'" Text="ADDLIB &quot;%(_AsmLinkInput.ToolPath)&quot;" />
      <_AsmMergedArchiveLine Include="SAVE" Text="SAVE" />
      <_AsmMergedArchiveLine Include="END" Text="END" />
    </ItemGroup>
    <PropertyGroup>
      <_AsmMergeArchive Condition="'$(_AsmArch)' == 'wasm' and '$(_AsmOutputKind)' == 'SharedLibrary' and '$(AsmStaticLibraryPath)' != '' and '@(_AsmLinkInput)' != ''">true</_AsmMergeArchive>
      <_AsmMergedArchiveScript>$(AsmIntermediateDirectory)archive.mri</_AsmMergedArchiveScript>
    </PropertyGroup>
    <WriteLinesToFile Condition="'$(_AsmMergeArchive)' == 'true'"
                      File="$(_AsmMergedArchiveScript)"
                      Lines="@(_AsmMergedArchiveLine->'%(Text)')"
                      Overwrite="true" />

    <Delete Condition="'$(AsmStaticLibraryPath)' != ''" Files="$(AsmStaticLibraryPath)" />
    <Exec Condition="'$(AsmStaticLibraryPath)' != '' and '$(_AsmMergeArchive)' != 'true'"
          Command="$(_AsmArchiver) rcsD $(_AsmArchiveFormatArgument) &quot;$(AsmStaticLibraryPath.Replace('\','/'))&quot; $(_AsmObjectArguments)" />
    <Exec Condition="'$(_AsmMergeArchive)' == 'true'"
          Command="$(_AsmArchiver) $(_AsmArchiveFormatArgument) -M &lt; &quot;$([System.IO.Path]::GetFullPath('$(_AsmMergedArchiveScript)').Replace('\','/'))&quot;" />
    <ItemGroup>
      <_AsmMergedArchiveLine Remove="@(_AsmMergedArchiveLine)" />
    </ItemGroup>

    <ItemGroup>
      <FileWrites Include="$(TargetPath)" />
      <FileWrites Include="$(AsmStaticLibraryPath)" Condition="'$(AsmStaticLibraryPath)' != ''" />
      <FileWrites Include="$(_AsmMergedArchiveScript)" Condition="'$(_AsmMergeArchive)' == 'true'" />
      <FileWrites Include="$(AsmImportLibraryPath)" Condition="'$(AsmImportLibraryPath)' != ''" />
      <FileWrites Include="$(_AsmProgramImportLibraryPath)" Condition="'$(_AsmProgramImportLibraryPath)' != ''" />
      <!-- lld-link's PDB (link -debug), named after the output: without this, dotnet clean
           left xapp.pdb behind (measured). -->
      <FileWrites Include="$(TargetDir)$(TargetName).pdb" Condition="'$(_AsmOs)' == 'Windows' and '$(_AsmDebugSymbols)' == 'true' and '$(_AsmOutputKind)' != 'StaticLibrary'" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- Replacing the managed build steps                                                      -->
  <!-- ===================================================================================== -->

  <!--
    The managed compiler step becomes assemble + link, except in a design-time build.

    IDEs run design-time builds whenever a project loads or changes, to learn its references
    and items: Rider calls Compile and CoreCompile with DesignTimeBuild=true and
    SkipCompilerExecution=true, and Visual Studio sets the same two properties. A design-time
    build must not run the real tools: it would assemble and link on every load (slow), race
    the real build for the same obj/ files, and fail where a referenced project has not been
    built yet (Rider showed lld's "cannot open libgrpcasm.a" as a project warning). Csc honors
    SkipCompilerExecution the same way.
  -->
  <Target Name="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipCompilerExecution)' != 'true'"
          DependsOnTargets="$(_AsmCoreCompileDependsOn)" />

  <PropertyGroup>
    <!-- One RID: assemble and link it. The RID outer build: build each RID instead (reached
         only when something calls CoreCompile directly; Build skips it, see below). -->
    <!-- The API records are read between the two, so that a wrong PROTO line (ASM0130-0134)
         stops the build before anything is linked. -->
    <_AsmCoreCompileDependsOn Condition="'$(_AsmRid)' != ''">AsmAssemble;_AsmReadApi;AsmLink</_AsmCoreCompileDependsOn>
    <_AsmCoreCompileDependsOn Condition="'$(_AsmRid)' == ''">_AsmBuildEachRuntimeIdentifier;_AsmMergeApi</_AsmCoreCompileDependsOn>

    <!--
      The RID outer build's Build is the dispatch alone, the way the outer build of a
      multi-targeted project (TargetFrameworks) runs DispatchToInnerBuilds and nothing else.
      Through CoreBuild it would also resolve this project's references with no RID, which
      builds each referenced .asmproj's own RID outer build: every RID that reference lists
      (most of which no inner build here asks for), and ASM0010 for a reference that lists none
      because it is built for the RIDs its referencing projects ask for. Each inner build
      resolves the references itself, for its own RID.
    -->
    <BuildDependsOn Condition="'$(_AsmRid)' == ''">BeforeBuild;_AsmBuildEachRuntimeIdentifier;_AsmMergeApi;AfterBuild</BuildDependsOn>
  </PropertyGroup>

  <!-- ===================================================================================== -->
  <!-- The API file: PROTO lines, checked, for the generated C# bindings                     -->
  <!-- ===================================================================================== -->

  <!--
    _AsmReadApi (each RID): reads the API records asmsdk.inc and asmsdk-gnu.inc write into the
    objects (a "fn" record per function macro, a "proto" record per PROTO line, a "struct"
    record per STRUCT line), lays the structs out with the RID's pointer size (the layout
    _AsmReadStructs gave the assembler), checks the PROTO lines against the functions
    (AsmReadApi: ASM0130-ASM0132, ASM0134-ASM0136) and writes the RID's API file,
    <AssemblyName>.api.json, into obj/ and beside the RID's binary. No PROTO and no STRUCT
    line, no file (a stale one is deleted). Not incremental by Inputs/Outputs: it reads a few
    hundred bytes per object, and the task rewrites the file only when its content changes,
    so its timestamp still tells consumers when the API changed.
    Not for WebAssembly (not released yet): asmsdk-wasm.inc writes no records, and the objects
    are wasm, a format the section reader (ObjectSections) does not read, so a wasm RID
    declares nothing and has no API file. A PROTO line in a wasm source is an .error of
    asmsdk-wasm.inc rather than a line silently left unchecked; _AsmMergeApi leaves the wasm
    RIDs out of its comparison.
  -->
  <PropertyGroup>
    <_AsmApiIntermediateFile>$(AsmIntermediateDirectory)api/$(AssemblyName).api.json</_AsmApiIntermediateFile>
  </PropertyGroup>
  <Target Name="_AsmReadApi" DependsOnTargets="AsmAssemble" Condition="'$(_AsmRid)' != '' and '$(_AsmArch)' != 'wasm'">
    <AsmReadApi Sources="@(_AsmSelectedSource)"
                Library="$(AssemblyName)"
                OutputKind="$(_AsmOutputKind)"
                RuntimeIdentifier="$(_AsmRid)"
                ApiFile="$(_AsmApiIntermediateFile)"
                PointerSize="$(_AsmPointerSize)">
      <Output TaskParameter="Written" PropertyName="_AsmApiWritten" />
    </AsmReadApi>
    <Copy Condition="'$(_AsmApiWritten)' != ''" SourceFiles="$(_AsmApiIntermediateFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Delete Condition="'$(_AsmApiWritten)' == ''" Files="$(TargetDir)$(AssemblyName).api.json" />
    <ItemGroup Condition="'$(_AsmApiWritten)' != ''">
      <FileWrites Include="$(_AsmApiIntermediateFile);$(TargetDir)$(AssemblyName).api.json" />
    </ItemGroup>
  </Target>

  <!--
    _AsmMergeApi (the RID outer build): asks each inner build for its API file (the same global
    properties as the Build call, so MSBuild answers from the builds that ran), checks that every
    RID declares the same functions the same way (AsmMergeApi: ASM0133), and writes the
    library's API file, without the per-RID fields, beside the RID folders:
    bin/<Configuration>/<tfm>/<AssemblyName>.api.json. Conditioned on there being inner builds
    (see _AsmBuildEachRuntimeIdentifier: batching over an empty list still runs once).
    The WebAssembly RIDs take no part (see _AsmReadApi): AsmMergeApi reads a RID without an API
    file as one that declares nothing, so a library of native and wasm RIDs with PROTO lines
    would otherwise stop with ASM0133 for every function. Its API file describes the other
    RIDs; a library of wasm RIDs only has none.
  -->
  <Target Name="_AsmMergeApi" Condition="'$(_AsmRid)' == '' and '@(_AsmInnerBuild)' != ''">
    <ItemGroup>
      <_AsmApiRid Include="@(_AsmInnerBuild)" Condition="'%(Identity)' != 'browser-wasm' and '%(Identity)' != 'wasi-wasm'" />
      <_AsmApiInnerProject Include="$(MSBuildProjectFullPath)" Condition="'@(_AsmApiRid)' != ''">
        <AdditionalProperties>%(_AsmApiRid.AdditionalProperties)</AdditionalProperties>
      </_AsmApiInnerProject>
    </ItemGroup>
    <MSBuild Condition="'@(_AsmApiInnerProject)' != ''" Projects="@(_AsmApiInnerProject)" Targets="GetAsmApiFile" BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmApiInnerFile" />
    </MSBuild>
    <!-- Not for a library of wasm RIDs only: RuntimeIdentifiers is required, and an empty list
         is no value to MSBuild. -->
    <AsmMergeApi Condition="'@(_AsmApiRid)' != ''" RuntimeIdentifiers="@(_AsmApiRid)" ApiFiles="@(_AsmApiInnerFile)" ApiFile="$(OutDir)$(AssemblyName).api.json">
      <Output TaskParameter="Written" PropertyName="_AsmApiMerged" />
    </AsmMergeApi>
    <ItemGroup Condition="'$(_AsmApiMerged)' != ''">
      <FileWrites Include="$(_AsmApiMerged)" />
    </ItemGroup>
    <ItemGroup>
      <_AsmApiInnerProject Remove="@(_AsmApiInnerProject)" />
      <_AsmApiRid Remove="@(_AsmApiRid)" />
    </ItemGroup>
  </Target>

  <!--
    GetAsmApiFile: the API file of this build, as an item with RuntimeIdentifier metadata (empty
    in the RID outer build), or nothing when it has no PROTO line. An inner build returns its
    obj/ copy, which names each function's source for the comparison's messages; the outer
    build returns the merged file. Asks for nothing to be built: called after Build.
  -->
  <!-- Absolute paths: a referencing project resolves a returned item's relative path against
       its own folder (measured: a C# consumer was handed NetBindings\bin\...\apiproto.api.json).
       The merge above only worked with relative ones because it runs in this same project. -->
  <PropertyGroup>
    <_AsmApiFileFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_AsmApiIntermediateFile)'))</_AsmApiFileFullPath>
    <_AsmApiMergedFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutDir)', '$(AssemblyName).api.json'))</_AsmApiMergedFullPath>
  </PropertyGroup>
  <Target Name="GetAsmApiFile" Returns="@(_AsmApiFileItem)">
    <ItemGroup>
      <_AsmApiFileItem Include="$(_AsmApiFileFullPath)" Condition="'$(_AsmRid)' != '' and Exists('$(_AsmApiFileFullPath)')" RuntimeIdentifier="$(_AsmRid)" />
      <_AsmApiFileItem Include="$(_AsmApiMergedFullPath)" Condition="'$(_AsmRid)' == '' and Exists('$(_AsmApiMergedFullPath)')" RuntimeIdentifier="" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- Runtime identifiers: checks and the RID outer build                                    -->
  <!-- ===================================================================================== -->

  <!--
    _AsmCheckRuntimeIdentifiers: fails early, with the fix, on what the RIDs of this build
    cannot be. Runs before the RID outer build dispatches (_AsmBuildEachRuntimeIdentifier
    depends on it) and before an inner build prepares anything (the first dependency of
    AsmPrepare, which the link inputs a referencing project asks for also run, and which
    builds the references), so "dotnet build", "dotnet pack" and
    builds through references all check. Never in restore (a project that names no RID must
    still restore inside a consumer's graph), in clean (cleaning asks for no RID: a clean
    through a ProjectReference reaches a RID-less project with none, and must not fail), nor
    in an IDE's design-time build (it would mark a project whose RIDs come from its consumers
    as broken). Hooking the common targets' _CheckForInvalidConfigurationAndPlatform instead,
    as 0.3.0's first draft did, made every Clean and Rebuild run it (measured: Rebuild of a
    project with a RID-less reference failed with ASM0010).
    Errors and warnings:
      ASM0010  no RID at all: not in the project, not asked for by a referencing project, no -r,
               and the build machine is not one of the eight RIDs (so there is no default)
      ASM0011  a RID AsmSdk does not build
      ASM0012  a RID asked for by a referencing project (or -r) that the project does not list
      ASM0013  (warning) a publish or pack carries a project built for the default RID alone,
               the build machine's (see _AsmBuildMachineRid in AsmFoundation.Properties.targets)

    Why ASM0013 warns on publish and pack only: the default RID is right for the dev loop
    (build, run, test on this machine) and wrong for what leaves it. A portable "dotnet publish"
    of a .NET app, or a "dotnet pack", that carries a RID-less asm project would hold that
    one platform's library and quietly lack every other's. The CLI marks both commands with the
    global properties _IsPublishing and _IsPacking, which reach referenced projects too. A
    RID-specific publish asks for its own RID, which is an inner build here: no warning.

    A solution build was 0.3.0's one exception to ASM0010: it built nothing for a project that
    lists no RIDs (only the builds through its references did), and a .NET project that
    referenced such a project without naming RIDs got no binary at all. With the build
    machine's RID as the default, a solution build builds that RID; the exception (a message,
    nothing built) remains only where there is no default. Visual Studio builds the projects of
    a solution one at a time, so BuildingInsideVisualStudio counts as a solution build too.
  -->
  <PropertyGroup>
    <_AsmNothingToBuild Condition="'$(_AsmRid)' == '' and '$(_AsmBuildRuntimeIdentifiers)' == '' and ('$(BuildingSolutionFile)' == 'true' or '$(BuildingInsideVisualStudio)' == 'true')">true</_AsmNothingToBuild>
  </PropertyGroup>
  <Target Name="_AsmCheckRuntimeIdentifiers"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Condition="'$(_AsmNothingToBuild)' == 'true'"
             Importance="high"
             Text="$(MSBuildProjectName): no runtime identifier of its own; it is built for the RIDs that its referencing projects ask for, so this solution build builds nothing for it by itself." />
    <ItemGroup>
      <_AsmRidToCheck Include="$(_AsmBuildRuntimeIdentifiers)" Condition="'$(_AsmRid)' == ''" />
      <_AsmRidToCheck Include="$(_AsmRid)" Condition="'$(_AsmRid)' != ''" />
      <_AsmSupportedRid Include="$(_AsmSupportedRuntimeIdentifiers)" />
      <_AsmDeclaredRid Include="$(_AsmDeclaredRuntimeIdentifiers)" />
      <_AsmUnsupportedRid Include="@(_AsmRidToCheck)" Exclude="@(_AsmSupportedRid)" />
      <_AsmUndeclaredRid Include="@(_AsmRidToCheck)" Exclude="@(_AsmDeclaredRid)" Condition="'$(_AsmDeclaredRuntimeIdentifiers)' != ''" />
    </ItemGroup>
    <Error Code="ASM0010"
           Condition="'@(_AsmRidToCheck)' == '' and '$(_AsmNothingToBuild)' != 'true'"
           Text="This project names no runtime identifier to build, and this build machine ($(NETCoreSdkRuntimeIdentifier)) is not one AsmSdk builds for, so there is no default. Add &lt;RuntimeIdentifiers&gt;win-x64;linux-x64;osx-arm64&lt;/RuntimeIdentifiers&gt; (any of @(_AsmSupportedRid, ', ')), let the project that references it choose: &lt;ProjectReference Include=&quot;...&quot; RuntimeIdentifiers=&quot;linux-x64;win-x64&quot; /&gt;, or build one with -r &lt;rid&gt;." />
    <!-- The word the warning uses for the command: pack when packing (a .NET library packed
         with an asm reference embedded is packing too), publish otherwise. -->
    <PropertyGroup>
      <_AsmPublishOrPackWord Condition="'$(_IsPacking)' == 'true'">pack</_AsmPublishOrPackWord>
    </PropertyGroup>
    <!-- In the RID outer build only: an inner build has its RID from -r or a referencing
         project, never from the default. -->
    <Warning Code="ASM0013"
             Condition="'$(_AsmRid)' == '' and '$(_AsmRidsFromBuildMachine)' == 'true' and ('$(_IsPublishing)' == 'true' or '$(_IsPacking)' == 'true')"
             Text="$(MSBuildProjectName) lists no RuntimeIdentifiers, so this $([MSBuild]::ValueOrDefault('$(_AsmPublishOrPackWord)', 'publish')) carries it for $(_AsmBuildMachineRid) alone: the build machine's platform, its default. List the platforms it should ship in the project: &lt;RuntimeIdentifiers&gt;win-x64;linux-x64;osx-arm64&lt;/RuntimeIdentifiers&gt; (any of @(_AsmSupportedRid, ', ')), or have the referencing project name them (RuntimeIdentifiers=&quot;...&quot; on its ProjectReference), or build for one platform with -r &lt;rid&gt;." />
    <Error Code="ASM0011"
           Condition="'@(_AsmUnsupportedRid)' != ''"
           Text="AsmSdk does not build for @(_AsmUnsupportedRid, ', '). Supported runtime identifiers: @(_AsmSupportedRid, ', ')." />
    <Error Code="ASM0012"
           Condition="'@(_AsmUndeclaredRid)' != ''"
           Text="@(_AsmUndeclaredRid, ', ') was asked for (by a referencing project or -r), but this project's RuntimeIdentifiers are @(_AsmDeclaredRid, ', '). Add it there if the code supports it." />
  </Target>

  <!--
    _AsmBuildEachRuntimeIdentifier: the RID outer build. Builds this project once per RID, each
    as an inner build with the global property RuntimeIdentifier (what -r sets), in parallel
    when the build is. The caller's other global properties (Configuration, a TargetFramework
    of a multi-targeted build) are inherited by the MSBuild task.

    Both steps are conditioned on having a RID to build (a solution build of a project that
    lists none, see _AsmCheckRuntimeIdentifiers). Metadata batching over an EMPTY item list
    still adds the item once, with an empty %(Identity) (measured with MSBuild 18): the
    project would call itself with an empty RuntimeIdentifier, which is a RID outer build
    again, and that build would call itself with the same properties, which MSBuild stops as
    MSB4006, a circular dependency (what a solution build showed before the conditions).
  -->
  <Target Name="_AsmBuildEachRuntimeIdentifier" DependsOnTargets="_AsmCheckRuntimeIdentifiers">
    <ItemGroup>
      <_AsmRidProject Include="$(MSBuildProjectFullPath)" Condition="'@(_AsmInnerBuild)' != ''">
        <AdditionalProperties>%(_AsmInnerBuild.AdditionalProperties)</AdditionalProperties>
      </_AsmRidProject>
    </ItemGroup>
    <MSBuild Condition="'@(_AsmRidProject)' != ''" Projects="@(_AsmRidProject)" Targets="Build" BuildInParallel="$(BuildInParallel)" />
  </Target>

  <!--
    _AsmInnerBuild: one item per RID the RID outer build builds, with the global properties of
    that RID's inner build as AdditionalProperties. The three calls into the inner builds (Build
    above, Clean below, GetAsmNativeRuntimeAssets in References.targets) all use these items,
    because MSBuild reuses a build only for the same global properties: the query must reach the
    builds that already ran, and the clean the folders they wrote.

    The RID, and an output folder per RID when the outer build's would hold them all:
      OutputPath  when it came from the command line (dotnet build -o folder, which also sets
                  _CommandLineDefinedOutputPath). A global OutputPath is not extended by the
                  .NET SDK's RID suffix, so every inner build wrote to the same folder and one
                  RID's libraries overwrote another's: a later link then read a static library
                  of the wrong machine ("machine type x64 conflicts with arm64", measured).
                  Each RID now gets folder/<rid>/, the folder the IDE up-to-date check expects.
      OutDir      when it differs from OutputPath, so it was set explicitly (-p:OutDir=, or in
                  a project file): OutDir is never extended by a RID either.
    A project with several target frameworks (freestanding;libc) gets folder/<tfm>/<rid>/: the
    folder is shared by its frameworks as well, and each builds the same RIDs.
      PublishDir  in a dotnet publish (_IsPublishing, which the CLI sets): <PublishDir><rid>/,
                  each RID's own publish folder (see _AsmPublishEachRuntimeIdentifier), given to
                  the builds as well as to the publishes so that MSBuild runs each inner build
                  once: a property the build lacked would make the publish a second instance.
    Footgun: these global properties reach the projects an inner build references, as any
    global property does, so a static library this project links lands in folder/<rid>/ too.
    A .NET project that references this one removes all three first (see the SDK package's
    buildTransitive targets): its own -o folder gets copies, not the asm projects' builds.
    Items, not properties, so that each value can name its RID; evaluated after every property,
    so OutDir and OutputPath are final here (this file is imported after Microsoft.NET.Sdk's
    targets, which set OutDir).
  -->
  <!--
    The three folders as directories, with their trailing separator, before a RID is appended:
    the .NET SDK 10.0.404 CLI passes -o without one (PublishDir=K:\out, OutputPath=K:\out;
    11.0.100 writes K:\out\), as a global property the common targets cannot normalize, and
    "$(PublishDir)%(Identity)/" made K:\outlinux-x64/, a folder next to the one asked for
    (measured: ProgramTests' publish -o under 10.0.404). For the same reason the OutDir check
    compares the normalized folders: under 10.0.404, OutDir (derived, K:\out\) and OutputPath
    (global, K:\out) differed by the separator alone, which read as an OutDir set by hand.
  -->
  <PropertyGroup Condition="'$(_AsmRid)' == ''">
    <_AsmSharedOutputFramework Condition="$(TargetFrameworks.Contains(';'))">$(TargetFramework)/</_AsmSharedOutputFramework>
    <_AsmOutputPathFolder Condition="'$(OutputPath)' != ''">$([MSBuild]::EnsureTrailingSlash('$(OutputPath)'))</_AsmOutputPathFolder>
    <_AsmOutDirFolder Condition="'$(OutDir)' != ''">$([MSBuild]::EnsureTrailingSlash('$(OutDir)'))</_AsmOutDirFolder>
    <_AsmPublishDirFolder Condition="'$(PublishDir)' != ''">$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_AsmPublishDirFolder>
  </PropertyGroup>
  <ItemGroup Condition="'$(_AsmRid)' == '' and '$(_AsmBuildRuntimeIdentifiers)' != ''">
    <_AsmInnerBuild Include="$(_AsmBuildRuntimeIdentifiers)">
      <AdditionalProperties>RuntimeIdentifier=%(Identity)</AdditionalProperties>
      <AdditionalProperties Condition="'$(_CommandLineDefinedOutputPath)' == 'true'">%(AdditionalProperties);OutputPath=$(_AsmOutputPathFolder)$(_AsmSharedOutputFramework)%(Identity)/</AdditionalProperties>
      <AdditionalProperties Condition="'$(_AsmOutDirFolder)' != '$(_AsmOutputPathFolder)'">%(AdditionalProperties);OutDir=$(_AsmOutDirFolder)$(_AsmSharedOutputFramework)%(Identity)/</AdditionalProperties>
      <AdditionalProperties Condition="'$(_IsPublishing)' == 'true'">%(AdditionalProperties);PublishDir=$(_AsmPublishDirFolder)%(Identity)/</AdditionalProperties>
    </_AsmInnerBuild>
  </ItemGroup>

  <!--
    dotnet clean of the RID outer build cleans every inner build too: each keeps its own list
    of written files in obj/<Configuration>/<tfm>/<rid>/.
    Only in a build that has a TargetFramework: the outer build of a multi-targeted project
    (TargetFrameworks) dispatches Clean to each framework, and each of those cleans its RIDs.
    Run in that outer build as well, this target would call the project with a RuntimeIdentifier
    but no TargetFramework, which is the multi-targeted outer build again, and it would pass the
    RID on to EVERY framework, including one whose RuntimeIdentifiers do not list it (measured:
    "dotnet clean" of a freestanding;libc project failed with ASM0012 for libc and win-x64).
  -->
  <Target Name="_AsmCleanEachRuntimeIdentifier" AfterTargets="Clean" Condition="'$(_AsmRid)' == '' and '$(TargetFramework)' != '' and '$(_AsmBuildRuntimeIdentifiers)' != ''">
    <ItemGroup>
      <!-- The inner builds' own global properties (_AsmInnerBuild): an output folder per RID
           when the outer build's is shared, so each clean finds the folder its build wrote. -->
      <_AsmRidCleanProject Include="$(MSBuildProjectFullPath)">
        <AdditionalProperties>%(_AsmInnerBuild.AdditionalProperties)</AdditionalProperties>
      </_AsmRidCleanProject>
    </ItemGroup>
    <MSBuild Projects="@(_AsmRidCleanProject)" Targets="Clean" BuildInParallel="$(BuildInParallel)" />
  </Target>

  <!-- ===================================================================================== -->
  <!-- dotnet run                                                                             -->
  <!-- ===================================================================================== -->

  <!--
    ComputeRunArguments: the .NET CLI's hook for dotnet run (and for IDEs that use it). After the
    build, the CLI evaluates the project with the same global properties, runs this target, and
    starts $(RunCommand) $(RunArguments) in $(RunWorkingDirectory) (empty: the current folder),
    with the arguments that follow the double dash on its command line appended (an XML comment
    cannot spell that dash pair). Microsoft.NET.Sdk defines it empty, for SDKs to
    replace, and computes its own defaults at evaluation only for a .NETCoreApp executable, which
    an .asmproj never is: dotnet run refused every asm program with "The current OutputType is
    'Library'" (measured with SDK 11.0.100).
    Which build runs, and how (this machine, its emulation, wasmtime for a wasi-wasm program, WSL
    or Docker): AsmSelectRunTarget.
    Settings:
      AsmRunIn               Auto (default), Host, Wasi, Wsl or Docker
      AsmRunWslDistribution  a WSL distribution other than the default one
      AsmRunDockerImage      an image other than debian:stable-slim (glibc) / alpine:3 (musl)
      RunArguments           the program's default arguments, as in .NET (StartArguments too)
    A project that sets RunCommand itself keeps it, as a .csproj does.
  -->
  <Target Name="ComputeRunArguments" DependsOnTargets="_AsmComputeRunArguments" />

  <Target Name="_AsmComputeRunArguments"
          Condition="'$(RunCommand)' == ''"
          DependsOnTargets="_AsmCheckRunnable;_AsmGetRunCandidates">
    <AsmSelectRunTarget Programs="@(_AsmRunCandidate)"
                        RunIn="$(AsmRunIn)"
                        WslDistribution="$(AsmRunWslDistribution)"
                        DockerImage="$(AsmRunDockerImage)"
                        HostIsMusl="$(_AsmSdkRidIsMusl)"
                        Arguments="$([MSBuild]::ValueOrDefault('$(RunArguments)', '$(StartArguments)'))"
                        ProjectName="$(MSBuildProjectName)"
                        ProjectFile="$(MSBuildProjectFullPath)">
      <Output TaskParameter="RunCommand" PropertyName="RunCommand" />
      <Output TaskParameter="RunArguments" PropertyName="RunArguments" />
      <Output TaskParameter="SelectedRuntimeIdentifier" PropertyName="AsmRunRuntimeIdentifier" />
    </AsmSelectRunTarget>
  </Target>

  <!--
    _AsmCheckRunnable: dotnet run starts programs. A library, a static library or object files
    stop here with ASM0090, which says what to change, rather than with the CLI's "The current
    OutputType is 'Library'", which named the managed SDK's view of the project (it sees every
    .asmproj as a Library) and was wrong for a StaticLibrary or Objects project.
  -->
  <Target Name="_AsmCheckRunnable">
    <PropertyGroup>
      <_AsmOutputKindText Condition="'$(_AsmOutputKind)' == 'SharedLibrary'">a shared library (OutputType Library)</_AsmOutputKindText>
      <_AsmOutputKindText Condition="'$(_AsmOutputKind)' == 'StaticLibrary'">a static library (OutputType StaticLibrary)</_AsmOutputKindText>
      <_AsmOutputKindText Condition="'$(_AsmOutputKind)' == 'Objects'">object files only (OutputType Objects)</_AsmOutputKindText>
    </PropertyGroup>
    <Error Code="ASM0090"
           Condition="'$(_AsmOutputKind)' != 'Executable'"
           Text="$(MSBuildProjectName) builds $(_AsmOutputKindText), and dotnet run starts programs. Set &lt;OutputType&gt;Exe&lt;/OutputType&gt; to build a program; a library runs inside the program that loads it." />
  </Target>

  <!--
    _AsmGetRunCandidates: the program of each RID this build covers, with what AsmSelectRunTarget
    needs to know about it (its OS, CPU, C library and loader). An inner build answers for its
    own RID; the RID outer build asks each inner build with the dispatch's global properties
    (_AsmInnerBuild), so the paths are those the builds wrote.
  -->
  <Target Name="_AsmGetRunCandidates" Returns="@(_AsmRunCandidate)">
    <ItemGroup Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' == 'Executable'">
      <_AsmRunCandidate Include="$(TargetPath)"
                        RuntimeIdentifier="$(_AsmRid)"
                        AsmOs="$(_AsmOs)"
                        AsmArch="$(_AsmArch)"
                        AsmMusl="$(_AsmMusl)"
                        AsmDynamicLinker="$(_AsmRunLoader)" />
    </ItemGroup>
    <ItemGroup Condition="'$(_AsmRid)' == ''">
      <_AsmRunQueryProject Include="$(MSBuildProjectFullPath)" Condition="'@(_AsmInnerBuild)' != ''">
        <AdditionalProperties>%(_AsmInnerBuild.AdditionalProperties)</AdditionalProperties>
      </_AsmRunQueryProject>
    </ItemGroup>
    <MSBuild Condition="'@(_AsmRunQueryProject)' != ''" Projects="@(_AsmRunQueryProject)" Targets="_AsmGetRunCandidates" BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmRunCandidate" />
    </MSBuild>
  </Target>

  <!-- ===================================================================================== -->
  <!-- dotnet publish                                                                         -->
  <!-- ===================================================================================== -->

  <!--
    dotnet publish of an asm project rides on the managed publish pipeline, as a .csproj's does
    (PublishDir and -o, publish profiles, NoBuild, the incremental copy and clean of the publish
    folder), with this project's own files in its list:
      one RID (dotnet publish -r <rid>, an inner build): _AsmAddOwnPublishFiles below; the folder
        is .NET's, bin/<Configuration>/<tfm>/<rid>/publish/, or the -o folder itself
      the RID outer build (no -r): every RID this build covers (the project's RuntimeIdentifiers,
        or those a referencing project asks for), each published by its inner build into
        <PublishDir><rid>/: bin/<Configuration>/<tfm>/publish/<rid>/, or <-o folder>/<rid>/
        (_AsmPublishEachRuntimeIdentifier)
    Release by default, as for .NET 8 projects (PublishRelease in Sdk.props).
  -->
  <PropertyGroup Condition="'$(_AsmRid)' == ''">
    <!-- The core publish steps of the RID outer build, which links nothing of its own: the
         managed Publish target still runs around them (its "Project -> folder" line, the build
         first unless NoBuild), and they publish each RID instead. -->
    <_CorePublishTargets>_AsmPublishEachRuntimeIdentifier</_CorePublishTargets>
    <_PublishNoBuildAlternativeDependsOn>_AsmPublishEachRuntimeIdentifier</_PublishNoBuildAlternativeDependsOn>
  </PropertyGroup>

  <!--
    _AsmPublishEachRuntimeIdentifier: the RID outer build's publish. Each RID's inner build runs
    Publish with its own folder, <PublishDir><rid>/. With dotnet publish, which sets the global
    property _IsPublishing, the inner builds already got that folder when the outer Build built
    them (_AsmInnerBuild), so MSBuild reuses those builds; through -t:Publish they are evaluated
    again with the folder, and their Build finds everything up to date.
    Conditioned on a RID to publish for the reason _AsmBuildEachRuntimeIdentifier gives (an
    empty batch would call this project with its own properties: MSB4006).
  -->
  <Target Name="_AsmPublishEachRuntimeIdentifier" DependsOnTargets="_AsmCheckRuntimeIdentifiers">
    <ItemGroup>
      <_AsmRidPublishProject Include="$(MSBuildProjectFullPath)" Condition="'@(_AsmInnerBuild)' != ''">
        <AdditionalProperties>%(_AsmInnerBuild.AdditionalProperties)</AdditionalProperties>
        <AsmRid>%(_AsmInnerBuild.Identity)</AsmRid>
      </_AsmRidPublishProject>
      <!-- Without _IsPublishing the inner builds have no folder yet: give each its own. -->
      <_AsmRidPublishProject Condition="'$(_IsPublishing)' != 'true'">
        <AdditionalProperties>%(AdditionalProperties);PublishDir=$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))%(AsmRid)/</AdditionalProperties>
      </_AsmRidPublishProject>
    </ItemGroup>
    <MSBuild Condition="'@(_AsmRidPublishProject)' != ''" Projects="@(_AsmRidPublishProject)" Targets="Publish" BuildInParallel="$(BuildInParallel)" />
  </Target>

  <!--
    _AsmAddOwnPublishFiles: one RID's publish list, completed after the managed SDK computed it
    (and before anything copies it):
      the output (program, shared library or static library), and its PDB unless
        CopyOutputSymbolsToPublishDirectory=false, as .NET publishes its own
      a program's shared libraries, where BinariesCopyPath put them (_AsmResolveProgramDependencies),
        their PDBs unless PublishReferencesSymbols=false, as .NET treats a reference's
      None and Content items with CopyToPublishDirectory (or only CopyToOutputDirectory, which
        .NET's DefaultCopyToPublishDirectoryMetadata extends to publish), at their TargetPath
    Taken out: NuGet's copy-local files of the project's packages (_ResolvedCopyLocalPublishAssets),
    which the managed SDK publishes flat. An asm package's library is published by the
    BinariesCopyPath rule above instead, where the program's run path expects it, and its import
    library or static library is nothing to deploy. Objects projects publish nothing.
  -->
  <Target Name="_AsmAddOwnPublishFiles"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="_AsmResolveProgramDependencies;DefaultCopyToPublishDirectoryMetadata"
          Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' != 'Objects'">
    <PropertyGroup>
      <_AsmPublishSymbols Condition="'$(_AsmOs)' == 'Windows' and '$(CopyOutputSymbolsToPublishDirectory)' != 'false' and Exists('$(TargetDir)$(TargetName).pdb') and '$(_AsmOutputKind)' != 'StaticLibrary'">$(TargetDir)$(TargetName).pdb</_AsmPublishSymbols>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_ResolvedCopyLocalPublishAssets)" />
      <ResolvedFileToPublish Include="$(TargetPath)" RelativePath="$(TargetFileName)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(_AsmPublishSymbols)" Condition="'$(_AsmPublishSymbols)' != ''" RelativePath="$(TargetName).pdb" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_AsmProgramDependency)" Condition="'%(_AsmProgramDependency.AsmSymbols)' != 'true' or '$(PublishReferencesSymbols)' != 'false'" RelativePath="%(_AsmProgramDependency.TargetPath)" CopyToPublishDirectory="PreserveNewest" />
      <!-- Qualified, one list per line, for the reason _AsmCopyOwnContent gives (MSB4096). -->
      <_AsmOwnPublishItem Include="@(_NoneWithTargetPath)" Condition="'%(_NoneWithTargetPath.CopyToPublishDirectory)' == 'Always' or '%(_NoneWithTargetPath.CopyToPublishDirectory)' == 'PreserveNewest' or '%(_NoneWithTargetPath.CopyToPublishDirectory)' == 'IfDifferent'" />
      <_AsmOwnPublishItem Include="@(ContentWithTargetPath)" Condition="'%(ContentWithTargetPath.CopyToPublishDirectory)' == 'Always' or '%(ContentWithTargetPath.CopyToPublishDirectory)' == 'PreserveNewest' or '%(ContentWithTargetPath.CopyToPublishDirectory)' == 'IfDifferent'" />
      <ResolvedFileToPublish Include="@(_AsmOwnPublishItem)" RelativePath="%(_AsmOwnPublishItem.TargetPath)" />
      <_AsmOwnPublishItem Remove="@(_AsmOwnPublishItem)" />
    </ItemGroup>
  </Target>

  <!-- An unknown project extension gets no language targets, and the common targets call
       this one unconditionally; there are no resources to name. -->
  <Target Name="CreateManifestResourceNames" />

  <!-- Outputs are written straight to the output folder by AsmLink; there is no managed
       assembly in obj/ to copy. What the .NET SDK's version also does is kept: the
       "Project -> path" line at normal verbosity, here once per RID (each inner build runs
       this target; the RID outer build's Build does not), so a build of eight RIDs says where
       each platform's output went. Objects projects write no output, and an IDE's design-time
       build links nothing, so neither prints one. A program's shared libraries are copied next
       to it (or below it) first (_AsmCopyProgramDependencies), and the project's files marked
       CopyToOutputDirectory (_AsmCopyOwnContent). -->
  <Target Name="CopyFilesToOutputDirectory" DependsOnTargets="_AsmCopyProgramDependencies;_AsmCopyOwnContent">
    <Message Importance="high"
             Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' != 'Objects' and '$(DesignTimeBuild)' != 'true' and '$(SkipCompilerExecution)' != 'true'"
             Text="$(MSBuildProjectName) -> $(TargetPath)" />
  </Target>
</Project>
