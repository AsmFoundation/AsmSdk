<Project>
  <!--
    AsmFoundation.Build.targets - imported by Sdk.targets AFTER Microsoft.NET.Sdk's targets, so
    the targets defined here replace the managed ones of the same name (MSBuild keeps the last
    definition of a target).

    Pipeline (all of it runs inside the standard Build, as CoreCompile):
      _AsmResolveToolchain  -> locate nasm / lld / llvm-ar (bundled or system) and check them
      AsmPrepare            -> object paths, include and define arguments, link inputs
      AsmAssemble           -> one nasm run per source, skipped when the object is up to date
      AsmLink               -> shared library, static library or executable from the objects

    Path convention: every path handed to a tool is computed once, as item metadata or a
    property named *ToolPath / *Argument(s), with forward slashes. A backslash right before a
    closing quote ("C:\dir\") escapes the quote under Windows command-line rules and silently
    merges two arguments; forward slashes are accepted by NASM and lld on every OS.
  -->

  <!-- ===================================================================================== -->
  <!-- Items                                                                                  -->
  <!-- ===================================================================================== -->
  <ItemGroup Condition="'$(EnableDefaultAsmItems)' == 'true'">
    <!-- DefaultItemExcludes keeps bin/ and obj/ out, as for a .csproj. -->
    <AsmSource Include="**/*.asm" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <AsmInclude Include="**/*.inc" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>

  <!--
    Every other file of the project folder is a None item, as in a .csproj: IDEs show a project
    as its items, so without this a linker script, a C header or a README next to the sources
    would be invisible. Set EnableDefaultNoneItems=false (.NET's own switch) to list them
    yourself.

    Why not Microsoft.NET.Sdk's own None glob (EnableDefaultItems stays false in Sdk.props):
    it removes "**/*$(DefaultLanguageSourceExtension)" from None right after including
    "**/*", and an .asmproj has no language extension, so that Remove is "**/*" and takes
    every file away again. The asm items are taken out of None below, so each file is one
    item: a .asm file is an AsmSource, never also a None.
  -->
  <ItemGroup Condition="'$(EnableDefaultNoneItems)' != 'false'">
    <None Include="**/*" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <None Remove="@(AsmSource);@(AsmInclude)" />
  </ItemGroup>

  <!--
    IDE integration.

    AvailableItemName: the item types an IDE shows besides its built-in ones (Compile, None,
    Content, ...). Rider's MSBuild host and Visual Studio's project system both read it; an
    item type missing from it is not shown at all, which is how an .asmproj looked empty in
    Rider before 0.2.0. It also offers AsmSource and AsmInclude as build actions.

    UpToDateCheckInput / UpToDateCheckBuilt: the fast up-to-date checks of Visual Studio and
    Rider decide whether to call MSBuild at all from these items. Without them an IDE would
    not know that editing a .asm file (or the linker's version script) makes the outputs stale,
    and would skip the build. Visible="false": they name files that are already items.
  -->
  <ItemGroup>
    <AvailableItemName Include="AsmSource" />
    <AvailableItemName Include="AsmInclude" />
    <UpToDateCheckInput Include="@(AsmSource);@(AsmInclude)" Visible="false" />
    <UpToDateCheckInput Include="$(ExportsFile)" Condition="'$(ExportsFile)' != ''" Visible="false" />
    <UpToDateCheckBuilt Include="$(TargetPath)" Condition="'$(_AsmOutputKind)' != 'Objects'" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The project's own include/ folder and the project folder are searched first, so a
         local file shadows one of the same name from a package or a referenced project. -->
    <AsmIncludeDirectory Include="$(MSBuildProjectDirectory)/include/" Condition="Exists('$(MSBuildProjectDirectory)/include')" />
    <AsmIncludeDirectory Include="$(MSBuildProjectDirectory)/" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Objects and generated files live under obj/<Configuration>/asm/. -->
    <AsmIntermediateDirectory Condition="'$(AsmIntermediateDirectory)' == ''">$(IntermediateOutputPath)asm/</AsmIntermediateDirectory>
    <AsmStaticLibraryPath Condition="'$(AsmStaticLibraryPath)' == '' and '$(_AsmOutputKind)' == 'StaticLibrary'">$(TargetPath)</AsmStaticLibraryPath>
    <AsmStaticLibraryPath Condition="'$(AsmStaticLibraryPath)' == '' and '$(AsmProduceStaticLibrary)' == 'true'">$(TargetDir)lib$(AssemblyName).a</AsmStaticLibraryPath>
    <AsmSharedLibraryPath Condition="'$(_AsmOutputKind)' == 'SharedLibrary'">$(TargetPath)</AsmSharedLibraryPath>
    <!-- glibc's dynamic loader, recorded as PT_INTERP in libc executables. -->
    <AsmDynamicLinker Condition="'$(AsmDynamicLinker)' == ''">/lib64/ld-linux-x86-64.so.2</AsmDynamicLinker>
    <!-- libc executables start in the SDK's crt1.o unless the project names its own entry
         symbol with StartupObject. -->
    <_AsmUsesCrt Condition="'$(_AsmRuntime)' == 'Libc' and '$(_AsmOutputKind)' == 'Executable' and '$(StartupObject)' == ''">true</_AsmUsesCrt>
    <_AsmUsesLibcStub Condition="'$(_AsmRuntime)' == 'Libc' and ('$(_AsmOutputKind)' == 'SharedLibrary' or '$(_AsmOutputKind)' == 'Executable')">true</_AsmUsesLibcStub>
  </PropertyGroup>

  <!-- ===================================================================================== -->
  <!-- Toolchain resolution                                                                   -->
  <!-- ===================================================================================== -->

  <!--
    _AsmResolveToolchain: sets _AsmNasm, _AsmLinker and _AsmArchiver to complete command
    prefixes and fails early, with the fix, when a tool is missing.
    Errors: ASM0001 (bundled toolchain not restored), ASM0002 (unknown AsmToolchain value).
  -->
  <Target Name="_AsmResolveToolchain">
    <PropertyGroup Condition="'$(AsmToolchain)' == 'Bundled'">
      <!-- NuGetPackageRoot comes from obj/*.nuget.g.props, written by restore. -->
      <AsmToolchainDirectory Condition="'$(AsmToolchainDirectory)' == ''">$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', '$(AsmToolchainPackageId.ToLowerInvariant())', '$(AsmToolchainVersion)', 'tools'))</AsmToolchainDirectory>
      <_AsmNasmPath>$(AsmToolchainDirectory)nasm$(_AsmExe)</_AsmNasmPath>
      <_AsmLldPath>$(AsmToolchainDirectory)lld$(_AsmExe)</_AsmLldPath>
      <_AsmArPath>$(AsmToolchainDirectory)llvm-ar$(_AsmExe)</_AsmArPath>
      <_AsmNasm>&quot;$(_AsmNasmPath.Replace('\','/'))&quot;</_AsmNasm>
      <!-- lld is one binary for every linker flavor; -flavor gnu selects ld.lld (ELF). -->
      <_AsmLinker>&quot;$(_AsmLldPath.Replace('\','/'))&quot; -flavor gnu</_AsmLinker>
      <_AsmArchiver>&quot;$(_AsmArPath.Replace('\','/'))&quot;</_AsmArchiver>
    </PropertyGroup>
    <PropertyGroup Condition="'$(AsmToolchain)' == 'System'">
      <_AsmNasm>$([MSBuild]::ValueOrDefault('$(AsmNasmCommand)', 'nasm'))</_AsmNasm>
      <_AsmLinker>$([MSBuild]::ValueOrDefault('$(AsmLinkerCommand)', 'ld'))</_AsmLinker>
      <_AsmArchiver>$([MSBuild]::ValueOrDefault('$(AsmArchiverCommand)', 'ar'))</_AsmArchiver>
    </PropertyGroup>

    <Error Code="ASM0002" Condition="'$(AsmToolchain)' != 'Bundled' and '$(AsmToolchain)' != 'System'"
           Text="AsmToolchain must be 'Bundled' or 'System', not '$(AsmToolchain)'." />
    <Error Code="ASM0001" Condition="'$(AsmToolchain)' == 'Bundled' and (!Exists('$(_AsmNasmPath)') or !Exists('$(_AsmLldPath)') or !Exists('$(_AsmArPath)'))"
           Text="The bundled toolchain was not found in '$(AsmToolchainDirectory)'. Run 'dotnet restore' (it downloads $(AsmToolchainPackageId) $(AsmToolchainVersion)), or set AsmToolchain=System to use nasm, ld and ar from PATH." />

    <!--
      NuGet does not keep the Unix execute bit when it extracts a package, so the tools come
      out as plain files on Linux and macOS. Restoring the bit on every build costs one
      process start and is idempotent.
    -->
    <Exec Condition="'$(AsmToolchain)' == 'Bundled' and !$([MSBuild]::IsOSPlatform('Windows'))"
          Command="chmod +x $(_AsmNasm) &quot;$(_AsmLldPath)&quot; $(_AsmArchiver)" StandardOutputImportance="low" />
  </Target>

  <!-- ===================================================================================== -->
  <!-- Preparation                                                                            -->
  <!-- ===================================================================================== -->

  <!--
    AsmPrepare: computes everything the assemble and link steps need, so those two targets can
    be pure "inputs -> outputs" steps that MSBuild skips when nothing changed.
  -->
  <Target Name="AsmPrepare" DependsOnTargets="_AsmResolveToolchain;_AsmResolveProjectReferences">
    <ItemGroup>
      <!-- Each source's object keeps the source's subfolder, so a/x.asm and b/x.asm do not
           collide. -->
      <AsmSource>
        <ObjectFile>$(AsmIntermediateDirectory)obj/%(RecursiveDir)%(Filename).o</ObjectFile>
      </AsmSource>
      <AsmSource>
        <ObjectToolPath>$([System.IO.Path]::GetFullPath('%(ObjectFile)').Replace('\','/'))</ObjectToolPath>
        <SourceToolPath>$([System.String]::Copy('%(FullPath)').Replace('\','/'))</SourceToolPath>
      </AsmSource>
      <_AsmObject Include="@(AsmSource->'%(ObjectToolPath)')" />

      <!-- Local include directories first, then those that packages and referenced projects
           contributed (they carry AsmOrigin), each group in the order added. -->
      <_AsmIncludeDirectoryOrdered Include="@(AsmIncludeDirectory)" Condition="'%(AsmIncludeDirectory.AsmOrigin)' == ''" />
      <_AsmIncludeDirectoryOrdered Include="@(AsmIncludeDirectory)" Condition="'%(AsmIncludeDirectory.AsmOrigin)' != ''" />
      <_AsmIncludeDirectoryOrdered>
        <!-- NASM uses -I as a plain prefix, so the trailing separator is required. -->
        <ToolPath>$([MSBuild]::EnsureTrailingSlash('%(FullPath)').Replace('\','/'))</ToolPath>
      </_AsmIncludeDirectoryOrdered>

      <!-- Dependencies of every object: all include files in the include path. Coarse but
           never wrong: editing any .inc reassembles every source that could include it. -->
      <_AsmDependency Include="@(AsmInclude->'%(FullPath)')" />
      <_AsmDependency Include="%(_AsmIncludeDirectoryOrdered.FullPath)**/*.inc" Condition="'%(_AsmIncludeDirectoryOrdered.AsmOrigin)' != ''" />

      <!-- One -D per DefineConstants entry (NAME or NAME=VALUE). Properties.targets has
           already appended DEBUG or RELEASE and FREESTANDING or LIBC; an item Include splits
           on ";" and drops the empty entries that a leading or doubled ";" leaves. -->
      <_AsmDefine Include="$(DefineConstants)" />

      <!-- Link inputs: static libraries and shared objects from AsmLinkLibrary items,
           packages and referenced projects, in the order given. -->
      <_AsmLinkInput Include="@(AsmLinkLibrary->'%(FullPath)')" />
      <_AsmLinkInput>
        <ToolPath>$([System.String]::Copy('%(FullPath)').Replace('\','/'))</ToolPath>
      </_AsmLinkInput>
    </ItemGroup>

    <PropertyGroup>
      <_AsmIncludeArguments>@(_AsmIncludeDirectoryOrdered->'-I&quot;%(ToolPath)&quot;', ' ')</_AsmIncludeArguments>
      <_AsmDefineArguments>@(_AsmDefine->'-D%(Identity)', ' ')</_AsmDefineArguments>
      <!-- DWARF when the project's DebugSymbols/DebugType ask for it (captured as
           _AsmDebugSymbols by Properties.targets, before they were hidden). -->
      <_AsmDebugArguments Condition="'$(_AsmDebugSymbols)' == 'true'">-g -F dwarf</_AsmDebugArguments>
      <!--
        Every warning except two that NASM raises on relocations it cannot judge:

        - reloc-rel-dword fires on any RIP-relative reference to another section (lea rsi,
          [rel msg] from .text to .rodata, a call to an extern). That is how
          position-independent code is written, and it always links.
        - reloc-abs-qword fires on a dq of a label (a jump table, a table of handlers). Whether
          such a pointer works depends on the output and on the section, which NASM cannot see:
          - In a Freestanding executable (-static, not position-independent), the address is
            fixed at link time, and the pointer works in any section.
          - In a shared library or a libc executable (a PIE), the address is known only at
            load time. In a writable section, the linker emits an R_X86_64_RELATIVE dynamic
            relocation, and the loader applies it when the program starts. That covers .data,
            and also ".data.rel.ro" when it is declared "write". There, -z relro makes the
            section read-only again after relocation. Without "write", NASM leaves a section of
            that name read-only.
          - In .rodata, or any other section without the write flag, the LINK FAILS: ld.lld
            reports "relocation R_X86_64_64 cannot be used against local symbol; recompile
            with -fPIC". The fix would be to relocate a read-only page at load time (a text
            relocation), and ld.lld's default -z text forbids that. Tables in read-only data
            hold 32-bit offsets instead (dd label - table), which need no relocation.

        The warning stays off: NASM would flag the valid cases too, and the linker still
        rejects every invalid one. Measured with the bundled NASM 3.02 and ld.lld 23.1.5,
        using this SDK's link lines.

        TreatWarningsAsErrors works as in a .csproj.
      -->
      <_AsmWarningArguments>-w+all -w-reloc-rel-dword -w-reloc-abs-qword</_AsmWarningArguments>
      <_AsmWarningArguments Condition="'$(TreatWarningsAsErrors)' == 'true'">$(_AsmWarningArguments) -w+error</_AsmWarningArguments>
      <!-- The SDK's own stubs: the same warnings, always as errors (they are ours to keep clean). -->
      <_AsmSdkSourceWarningArguments>-w+all -w-reloc-rel-dword -w-reloc-abs-qword -w+error</_AsmSdkSourceWarningArguments>
      <_AsmObjectArguments>@(_AsmObject->'&quot;%(Identity)&quot;', ' ')</_AsmObjectArguments>
      <_AsmLinkInputArguments>@(_AsmLinkInput->'&quot;%(ToolPath)&quot;', ' ')</_AsmLinkInputArguments>
      <_AsmTargetPathArgument>&quot;$(TargetPath.Replace('\','/'))&quot;</_AsmTargetPathArgument>
      <_AsmStubToolDirectory>$([System.IO.Path]::GetFullPath('$(AsmIntermediateDirectory)stubs/').Replace('\','/'))</_AsmStubToolDirectory>
      <_AsmCrtArgument Condition="'$(_AsmUsesCrt)' == 'true'">&quot;$(_AsmStubToolDirectory)crt1.o&quot;</_AsmCrtArgument>
      <!-- libc: the stub comes last, after the libraries that need it; no-as-needed keeps
           DT_NEEDED even when only a linked library, not the objects, calls into libc. -->
      <_AsmLibcArguments Condition="'$(_AsmUsesLibcStub)' == 'true'">--no-as-needed &quot;$(_AsmStubToolDirectory)libc.so.6&quot;</_AsmLibcArguments>

      <!--
        ExportsFile: the linker version script, under NativeAOT's name for the same file (the
        list of symbols to export, which NativeAOT hands to the linker as a version script on
        Linux). A relative path is taken from the project folder. Only the symbols it lists as
        global stay in the dynamic symbol table, versioned by its version node. The full path
        is also an input of AsmLink, so editing the script relinks.
      -->
      <_AsmExportsFilePath Condition="'$(ExportsFile)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(ExportsFile)'))))</_AsmExportsFilePath>
      <_AsmExportsFileArgument Condition="'$(_AsmExportsFilePath)' != ''">--version-script=&quot;$(_AsmExportsFilePath.Replace('\','/'))&quot;</_AsmExportsFileArgument>
      <!-- An executable puts no symbol in its dynamic symbol table unless asked: NativeAOT
           pairs the exports file with the export-dynamic option for that reason, and so does
           the SDK, so that the script decides what a dlopen'ed plugin can call back. -->
      <_AsmExportsFileArgument Condition="'$(_AsmExportsFilePath)' != '' and '$(_AsmOutputKind)' == 'Executable'">$(_AsmExportsFileArgument) --export-dynamic</_AsmExportsFileArgument>

      <!--
        LinkerArg items: extra linker arguments, under NativeAOT's item name, appended to every
        link line in item order. One item may hold several words ("-z defs"): the items are
        joined with spaces and not quoted, so a path with spaces must carry its own quotes.
        Footgun for NativeAOT users: NativeAOT hands LinkerArg to clang, so its items are
        written "-Wl,..."; the SDK runs ld.lld directly, so write the linker's own syntax.
      -->
      <_AsmLinkerArgArguments>@(LinkerArg, ' ')</_AsmLinkerArgArguments>
    </PropertyGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- Assemble                                                                               -->
  <!-- ===================================================================================== -->

  <!--
    AsmAssemble: one NASM run per source (target batching on AsmSource). Each batch is skipped
    when its object is newer than the source, every include file and the project file.
  -->
  <Target Name="AsmAssemble"
          DependsOnTargets="AsmPrepare"
          Inputs="@(AsmSource);@(_AsmDependency);$(MSBuildProjectFullPath)"
          Outputs="%(AsmSource.ObjectFile)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('%(AsmSource.ObjectToolPath)'))" />
    <Exec Command="$(_AsmNasm) -f $(AsmFormat) $(_AsmDebugArguments) $(_AsmWarningArguments) $(AsmFlags) $(_AsmIncludeArguments) $(_AsmDefineArguments) -o &quot;%(AsmSource.ObjectToolPath)&quot; &quot;%(AsmSource.SourceToolPath)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <FileWrites Include="%(AsmSource.ObjectFile)" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- Libc runtime support: the stub libc.so.6 and the hosted _start                         -->
  <!-- ===================================================================================== -->

  <!--
    _AsmBuildLibcStub: builds obj/.../asm/stubs/libc.so.6 from the SDK's stubs/libc.asm (once,
    then up to date). The stub defines the libc symbols as empty functions and carries SONAME
    libc.so.6. Linking against it records DT_NEEDED libc.so.6 and lets the linker create the
    PLT/GOT entries; at run time the real glibc supplies every symbol (unversioned references
    bind to glibc's default symbol versions).
    Symbols missing from the stub's list are added with AsmLibcSymbol items.
  -->
  <Target Name="_AsmBuildLibcStub"
          Condition="'$(_AsmUsesLibcStub)' == 'true'"
          DependsOnTargets="AsmPrepare"
          Inputs="$(AsmFoundationSdkDirectory)stubs/libc.asm;$(MSBuildProjectFullPath)"
          Outputs="$(AsmIntermediateDirectory)stubs/libc.so.6">
    <PropertyGroup>
      <_AsmExtraLibcSymbols>@(AsmLibcSymbol, ',')</_AsmExtraLibcSymbols>
      <_AsmExtraLibcArgument Condition="'$(_AsmExtraLibcSymbols)' != ''">-dEXTRA_LIBC_SYMBOLS=$(_AsmExtraLibcSymbols)</_AsmExtraLibcArgument>
    </PropertyGroup>
    <MakeDir Directories="$(AsmIntermediateDirectory)stubs" />
    <Exec Command="$(_AsmNasm) -f elf64 $(_AsmSdkSourceWarningArguments) $(_AsmExtraLibcArgument) -o &quot;$(_AsmStubToolDirectory)libc.o&quot; &quot;$(AsmFoundationSdkDirectory.Replace('\','/'))stubs/libc.asm&quot;" />
    <Exec Command="$(_AsmLinker) -shared -soname libc.so.6 -o &quot;$(_AsmStubToolDirectory)libc.so.6&quot; &quot;$(_AsmStubToolDirectory)libc.o&quot;" />
    <ItemGroup>
      <FileWrites Include="$(AsmIntermediateDirectory)stubs/libc.o;$(AsmIntermediateDirectory)stubs/libc.so.6" />
    </ItemGroup>
  </Target>

  <!--
    _AsmBuildCrt: assembles the SDK's stubs/crt1.asm, the _start of a libc executable. It calls
    __libc_start_main(main, ...) exactly like glibc's crt1.o, so the program's entry is an
    ordinary int main(int argc, char **argv). Skipped when StartupObject names another symbol:
    the program then provides its own entry, and must do what crt1 does.
  -->
  <Target Name="_AsmBuildCrt"
          Condition="'$(_AsmUsesCrt)' == 'true'"
          DependsOnTargets="AsmPrepare"
          Inputs="$(AsmFoundationSdkDirectory)stubs/crt1.asm"
          Outputs="$(AsmIntermediateDirectory)stubs/crt1.o">
    <MakeDir Directories="$(AsmIntermediateDirectory)stubs" />
    <Exec Command="$(_AsmNasm) -f elf64 $(_AsmSdkSourceWarningArguments) -o &quot;$(_AsmStubToolDirectory)crt1.o&quot; &quot;$(AsmFoundationSdkDirectory.Replace('\','/'))stubs/crt1.asm&quot;" />
    <ItemGroup>
      <FileWrites Include="$(AsmIntermediateDirectory)stubs/crt1.o" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- Link                                                                                   -->
  <!-- ===================================================================================== -->

  <!--
    AsmLink: produces the project's output(s) from the objects. Skipped when every output is
    newer than every object, link input and the project file.

    Shared library: the code must be position-independent (NASM: "default rel", calls through
    "wrt ..plt"); -z now + relro make the GOT read-only once loaded; the sha1 build id is
    derived from the content, so identical inputs give identical outputs.
    Executable: freestanding links -static with the entry _start (or StartupObject); libc
    links a PIE with glibc's dynamic loader and the SDK's crt1.o in front.
    Static library: llvm-ar "rcsD" = replace, create, write the symbol index the linker needs,
    deterministic (zero timestamps and ids). The archive is deleted first because "r" would
    keep members of objects that no longer exist.
    Every link line ends with the ExportsFile version script and the LinkerArg items, so a
    project's own arguments come last and can override the SDK's defaults.
  -->
  <Target Name="AsmLink"
          Condition="'$(_AsmOutputKind)' != 'Objects'"
          DependsOnTargets="AsmAssemble;_AsmBuildLibcStub;_AsmBuildCrt"
          Inputs="@(_AsmObject);@(_AsmLinkInput);$(_AsmExportsFilePath);$(MSBuildProjectFullPath)"
          Outputs="$(TargetPath);$(AsmStaticLibraryPath)">
    <PropertyGroup>
      <_AsmCommonLinkArguments>-z noexecstack --build-id=sha1 $(_AsmExportsFileArgument) $(_AsmLinkerArgArguments)</_AsmCommonLinkArguments>
      <!-- StartupObject is .NET's "where the program starts"; for assembly code that is the
           entry symbol. Empty means _start: the program's own, or crt1's for libc. -->
      <_AsmEntryArgument>-e $([MSBuild]::ValueOrDefault('$(StartupObject)', '_start'))</_AsmEntryArgument>
    </PropertyGroup>

    <MakeDir Directories="$(TargetDir)" />

    <Exec Condition="'$(_AsmOutputKind)' == 'SharedLibrary'"
          Command="$(_AsmLinker) -shared -soname $(TargetFileName) -z relro -z now --hash-style=gnu -o $(_AsmTargetPathArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmLibcArguments) $(_AsmCommonLinkArguments)" />

    <Exec Condition="'$(_AsmOutputKind)' == 'Executable' and '$(_AsmRuntime)' != 'Libc'"
          Command="$(_AsmLinker) -static $(_AsmEntryArgument) -o $(_AsmTargetPathArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmCommonLinkArguments)" />

    <Exec Condition="'$(_AsmOutputKind)' == 'Executable' and '$(_AsmRuntime)' == 'Libc'"
          Command="$(_AsmLinker) -pie --dynamic-linker $(AsmDynamicLinker) -z relro -z now --hash-style=gnu $(_AsmEntryArgument) -o $(_AsmTargetPathArgument) $(_AsmCrtArgument) $(_AsmObjectArguments) $(_AsmLinkInputArguments) $(_AsmLibcArguments) $(_AsmCommonLinkArguments)" />

    <Delete Condition="'$(AsmStaticLibraryPath)' != ''" Files="$(AsmStaticLibraryPath)" />
    <Exec Condition="'$(AsmStaticLibraryPath)' != ''"
          Command="$(_AsmArchiver) rcsD &quot;$(AsmStaticLibraryPath.Replace('\','/'))&quot; $(_AsmObjectArguments)" />

    <ItemGroup>
      <FileWrites Include="$(TargetPath)" />
      <FileWrites Include="$(AsmStaticLibraryPath)" Condition="'$(AsmStaticLibraryPath)' != ''" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- Replacing the managed build steps                                                      -->
  <!-- ===================================================================================== -->

  <!--
    The managed compiler step becomes assemble + link, except in a design-time build.

    IDEs run design-time builds whenever a project loads or changes, to learn its references
    and items: Rider calls Compile and CoreCompile with DesignTimeBuild=true and
    SkipCompilerExecution=true, and Visual Studio sets the same two properties. A design-time
    build must not run the real tools: it would assemble and link on every load (slow), race
    the real build for the same obj/ files, and fail where a referenced project has not been
    built yet (Rider showed lld's "cannot open libgrpcasm.a" as a project warning). Csc honors
    SkipCompilerExecution the same way.
  -->
  <Target Name="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipCompilerExecution)' != 'true'"
          DependsOnTargets="AsmAssemble;AsmLink" />

  <!-- An unknown project extension gets no language targets, and the common targets call
       this one unconditionally; there are no resources to name. -->
  <Target Name="CreateManifestResourceNames" />

  <!-- Outputs are written straight to the output folder by AsmLink; there is no managed
       assembly in obj/ to copy. -->
  <Target Name="CopyFilesToOutputDirectory" />
</Project>
