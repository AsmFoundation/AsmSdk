<Project>
  <!--
    AsmFoundation.Pack.targets - "dotnet pack" for an .asmproj. Imported after
    Microsoft.NET.Sdk's targets.

    Package layout. <tfm> is the target framework (freestanding or libc), <nuget-tfm> the NuGet
    framework behind it (netstandard1.0 or netstandard2.0; see AsmFoundation.Properties.targets)
    and <rid> each runtime identifier the project builds (its RuntimeIdentifiers). NuGet ignores
    the folders it does not know, and treats lib/ as managed assemblies, so the static libraries
    live under native/ instead:
      include/**                               public include files (.inc, .h), shared by
                                               every target framework and RID; and the C header
                                               the SDK writes from the PROTO and STRUCT lines,
                                               include/<AssemblyName>.h (AsmGenerateCHeader, on by
                                               default; a project's own file of that name wins:
                                               ASM0149)
      src/**                                   sources, when AsmPackSources=true
      lib/<nuget-tfm>/_._                      empty marker, one per target framework (below)
      build/<nuget-tfm>/<id>.props, buildTransitive/<nuget-tfm>/<id>.props
                                               generated per target framework: wire the include
                                               files and, per RID, that RID's library into a
                                               consuming .asmproj (AsmWritePackageProps)
      build/<nuget-tfm>/<id>.targets, buildTransitive/<nuget-tfm>/<id>.targets
                                               for a package with a shared library: lets a .NET
                                               consumer choose where the library goes
                                               (BinariesCopyPath on its PackageReference, or as
                                               its property), in plain MSBuild because the
                                               package does not depend on AsmFoundation.Sdk
                                               (AsmWritePackageConsumerTargets); for a package
                                               with C# bindings, their targets too (below)
      contentFiles/cs/net7.0/AsmBindings/<AssemblyName>.cs.pp
                                               the C# bindings' baseline, for a library with
                                               PROTO or STRUCT lines: NuGet fills its tokens from
                                               the consumer's AsmBindings settings (the targets
                                               above) and compiles it into each C# consumer for
                                               .NET 7 or later (AsmWritePackageBindings)
      build/bindings/<AssemblyName>.api.json, build/bindings/AsmFoundation.Sdk.Bindings.dll
                                               the API file and the bindings generator, for a
                                               consumer whose code uses [AsmLibrary]: the newest
                                               generator among the packages' and the SDK's runs
      native/<rid>/<tfm>/libfoo.a, foo.lib     static library (Unix, Windows)
      native/<rid>/<tfm>/foo.a, foo.wasm       WebAssembly (browser-wasm, wasi-wasm): the archive,
                                               which a consuming .asmproj links and the props hand
                                               a .NET WebAssembly app as NativeFileReference, and
                                               a library's module, for JavaScript and WASI hosts.
                                               Not under runtimes/: nothing loads a wasm module
                                               the way a .NET app loads a shared library, so NuGet
                                               must not copy it into an app's output
      native/<rid>/<tfm>/foo.dll.lib           the import library of a Windows DLL, for a
                                               consuming .asmproj that links the DLL
      runtimes/<rid>/native/libfoo.so, libfoo.dylib, foo.dll
                                               shared library, for a single target framework:
                                               NuGet's own place for native files, so a .NET
                                               consumer gets the one for its RID (portable:
                                               every RID, in deps.json; -r: the best match, flat)
      runtimes/<rid>/nativeassets/<nuget-tfm>/<file>
                                               shared library of each target framework, when
                                               the project multi-targets (the names collide
                                               otherwise); NuGet gives a .NET consumer the
                                               nearest framework's, which is libc's

    Why per-framework build/ folders and the lib/ markers: NuGet imports the build/ props of
    the framework nearest to the consumer's, so a libc consumer of a package that has both
    builds links the libc build. And NuGet judges a package's compatibility by its lib/ and
    ref/ folders: without the markers, a package with no lib/ counts as compatible with every
    framework, and a freestanding project could restore a libc-only package, import nothing
    and fail at link time with undefined symbols. With them, that restore fails with NU1202.
    The marker is the name NuGet itself documents for an empty lib/ folder; it adds no
    assembly reference to a .NET consumer.

    How the RIDs get in: NuGet packs once per target framework, in that framework's RID outer
    build (no RuntimeIdentifier), after Build has built every RID. _AsmPackNativeContent asks
    each RID's inner build for its files (_AsmGetRidPackContent), so a package always holds
    every RID the project lists. A project that lists none has nothing to pack: its Build stops
    with ASM0010 first.

    Package versions are the dependency versions: a consumer pins an asm library exactly as it
    pins a .NET library, and transitive dependencies flow through buildTransitive/.
  -->

  <PropertyGroup>
    <!-- Ship the sources too, for consumers that assemble them with their own settings. -->
    <AsmPackSources Condition="'$(AsmPackSources)' == ''">false</AsmPackSources>
    <!-- What a consuming .asmproj links by default: Static (the static library when there is
         one) or Shared (the shared library; on Windows its import library). -->
    <AsmPackageLinkKind Condition="'$(AsmPackageLinkKind)' == ''">Static</AsmPackageLinkKind>
    <!-- A .NET tool's packages (PackAsTool, below) hold the tool layout instead. -->
    <TargetsForTfmSpecificContentInPackage Condition="'$(_AsmPackAsTool)' != 'true'">$(TargetsForTfmSpecificContentInPackage);_AsmPackNativeContent</TargetsForTfmSpecificContentInPackage>
    <TargetsForTfmSpecificContentInPackage Condition="'$(_AsmPackAsTool)' == 'true'">$(TargetsForTfmSpecificContentInPackage);_AsmPackToolContent</TargetsForTfmSpecificContentInPackage>
    <_AsmGeneratedPropsPath>$(AsmIntermediateDirectory)pack/$(PackageId).props</_AsmGeneratedPropsPath>
    <_AsmGeneratedConsumerTargetsPath>$(AsmIntermediateDirectory)pack/$(PackageId).targets</_AsmGeneratedConsumerTargetsPath>
    <!-- The C# bindings' baseline the package carries (AsmWritePackageBindings). -->
    <_AsmGeneratedBindingsPath>$(AsmIntermediateDirectory)pack/$(AssemblyName).cs.pp</_AsmGeneratedBindingsPath>
    <_AsmEmptyLibMarkerPath>$(AsmIntermediateDirectory)pack/_._</_AsmEmptyLibMarkerPath>
  </PropertyGroup>

  <!--
    Symbol packages. A .snupkg (SymbolPackageFormat=snupkg, the format nuget.org's symbol server
    takes) holds portable PDBs, and an asm package has none: its code is native, and a Windows
    build's PDB is not a portable one. NuGet still wrote one, empty but for its nuspec (measured:
    dotnet pack with the include-symbols switch and snupkg, .NET 11 SDK), which nuget.org refuses;
    a repository that sets IncludeSymbols and snupkg for its .NET packages got one beside every asm
    package. So that format makes no symbol package here, and says so once. The legacy
    .symbols.nupkg (the default format) is left as NuGet makes it: the package's files, and with
    IncludeSource the sources under src/. IncludeSymbols is a local property (see Sdk.props), so
    this also wins over the switch.
  -->
  <PropertyGroup Condition="'$(IncludeSymbols)' == 'true' and '$(SymbolPackageFormat)' == 'snupkg'">
    <IncludeSymbols>false</IncludeSymbols>
    <_AsmSkipsSymbolPackage>true</_AsmSkipsSymbolPackage>
  </PropertyGroup>

  <Target Name="_AsmSaySymbolPackageSkipped" BeforeTargets="GenerateNuspec" Condition="'$(_AsmSkipsSymbolPackage)' == 'true'">
    <Message Importance="high"
             Text="$(MSBuildProjectName): no .snupkg: a symbol package of that format holds portable PDBs, and an asm package has none (native code). The package itself is packed as usual." />
  </Target>

  <ItemGroup Condition="'@(AsmPublicInclude)' == '' and '$(_AsmHasPublicIncludeFolder)' == 'true'">
    <!-- Public include files: everything under include/ by default. -->
    <AsmPublicInclude Include="include/**/*" />
  </ItemGroup>

  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmWritePackageProps" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmWritePackageConsumerTargets" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmWritePackageBindings" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmRemovePackageDependency" AssemblyFile="$(_AsmTasksAssembly)" />
  <UsingTask TaskName="AsmFoundation.Sdk.Tasks.AsmWriteToolSettings" AssemblyFile="$(_AsmTasksAssembly)" />

  <!-- ===================================================================================== -->
  <!-- .NET tools: PackAsTool                                                                 -->
  <!-- ===================================================================================== -->

  <!--
    <PackAsTool>true</PackAsTool> on an asm program makes dotnet pack write a .NET tool, in the
    kinds the .NET 10 SDK writes for a platform-specific tool (measured with SDK 11.0.100 and a
    C# tool with RuntimeIdentifiers):
      <PackageId>.<version>.nupkg        PackageType DotnetTool, tools/any/any/DotnetToolSettings.xml:
                                         the command, and one package per RID
      <PackageId>.<rid>.<version>.nupkg  PackageType DotnetToolRidPackage, one per RID this build
                                         covers, tools/any/<rid>/: DotnetToolSettings.xml (the
                                         command, EntryPoint, Runner="executable") and what a
                                         publish of that RID holds (the program, its libraries and
                                         programs at their paths, its data files)
    Then: dotnet tool install -g <PackageId> (from any NuGet feed; dotnet nuget push each
    .nupkg to publish), and the command (ToolCommandName, the program's name by default) runs
    the program for the machine, which needs no .NET runtime. "any" for the framework folder,
    as the SDK packs a self-contained tool. Folders survive inside tools/ (dotnet tool install
    extracts the package as it is), so a program's library folder and run path work there.
    The RID packages are the RID inner builds packed (_AsmPackToolRidPackages), the way
    Microsoft.NET.Sdk orchestrates its own per-RID tool packs; dotnet pack -r <rid> packs that
    RID's package alone, as it does for a .NET tool.
    Errors: ASM0053 (PackAsTool on something that is not a program, or on several target
    frameworks).
  -->
  <!-- A program only: PackAsTool on anything else packs nothing but ASM0053 (_AsmCheckToolPack
       through _AsmPackToolContent), and must not rename it on the way. -->
  <PropertyGroup Condition="'$(_AsmPackAsTool)' == 'true' and '$(_AsmOutputKind)' == 'Executable'">
    <!-- A RID inner build of a tool packs that RID's package. -->
    <_AsmToolRidPack Condition="'$(_AsmRid)' != ''">true</_AsmToolRidPack>
    <ToolCommandName Condition="'$(ToolCommandName)' == ''">$(TargetName)</ToolCommandName>
    <!-- A tool carries everything it needs: no package dependency, as for a .NET tool. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- DotnetTool first, as Microsoft.NET.Sdk's AddPackageType keeps a type of the project's
         own after it. -->
    <PackageType Condition="'$(_AsmToolRidPack)' != 'true' and '$(PackageType)' == ''">DotnetTool</PackageType>
    <PackageType Condition="'$(_AsmToolRidPack)' != 'true' and !$(PackageType.Contains('DotnetTool'))">DotnetTool;$(PackageType)</PackageType>
    <PackageType Condition="'$(_AsmToolRidPack)' == 'true'">DotnetToolRidPackage</PackageType>
    <!-- The top-level id, before a RID package appends its RID: the pointer names them. -->
    <_AsmToolPackageId>$(PackageId)</_AsmToolPackageId>
    <PackageId Condition="'$(_AsmToolRidPack)' == 'true'">$(PackageId).$(_AsmRid)</PackageId>
    <GenerateNuspecDependsOn Condition="'$(_AsmToolRidPack)' != 'true' and '$(_AsmRid)' == ''">$(GenerateNuspecDependsOn);_AsmPackToolRidPackages</GenerateNuspecDependsOn>
    <_AsmToolSettingsPath>$(AsmIntermediateDirectory)tool/DotnetToolSettings.xml</_AsmToolSettingsPath>
  </PropertyGroup>

  <!--
    _AsmCheckToolPack: ASM0053 for PackAsTool on a project that is not a program (a tool is
    something to run), or that has several target frameworks (one tool, one command: a tool's
    packages cannot hold two builds of it).
    ASM0056 for a RID package whose id could not take its RID: dotnet pack -r <rid> with a
    PackageId on the command line. The pack would write the RID package under the top-level
    id, which dotnet tool install then reads as the top-level package and fails on. Without
    -r, the top-level pack passes each RID package its id itself (_AsmPackToolRidPackages), so
    only a pack of one RID can get here.
  -->
  <Target Name="_AsmCheckToolPack" Condition="'$(_AsmPackAsTool)' == 'true'">
    <Error Code="ASM0053"
           Condition="'$(_AsmOutputKind)' != 'Executable'"
           Text="PackAsTool makes a program a .NET tool, and $(MSBuildProjectName) builds a $(_AsmOutputKind). Set &lt;OutputType&gt;Exe&lt;/OutputType&gt;, or remove PackAsTool." />
    <Error Code="ASM0053"
           Condition="$(TargetFrameworks.Contains(';'))"
           Text="PackAsTool packs one program per RID, and $(MSBuildProjectName) builds several target frameworks ($(TargetFrameworks)). Give the tool one TargetFramework." />
    <Error Code="ASM0056"
           Condition="'$(_AsmToolRidPack)' == 'true' and !$(PackageId.ToLowerInvariant().EndsWith('.$(_AsmRid)'))"
           Text="The $(_AsmRid) package of the .NET tool $(PackageId) must be named $(PackageId).$(_AsmRid), and a PackageId given on the command line cannot be renamed. Set &lt;PackageId&gt;$(PackageId)&lt;/PackageId&gt; in the project, or pack without -r: the top-level pack names every RID package itself." />
  </Target>

  <!--
    _AsmPackToolRidPackages: the RID packages, from the top-level pack (GenerateNuspec of the RID
    outer build): Pack of each RID's inner build (_AsmInnerBuild: the RIDs this build covers,
    with the dispatch's own global properties, so MSBuild reuses the builds it already ran).
    Each builds first unless NoBuild, as any pack does.
    With a PackageId from the command line (_AsmCommandLinePackageId, see Sdk.props), each RID
    package also gets PackageId=<id>.<rid> as a global property of its own: a global property
    passed to the MSBuild task outranks the inherited one, which the RID inner build's own
    <PackageId>$(PackageId).$(_AsmRid)</PackageId> cannot. Only then, because a global property
    makes these builds new project instances (evaluated again, their builds found up to date),
    which the usual pack has no reason to pay for.
  -->
  <Target Name="_AsmPackToolRidPackages" DependsOnTargets="_AsmCheckToolPack;_AsmCheckRuntimeIdentifiers">
    <ItemGroup>
      <_AsmToolRidProject Include="$(MSBuildProjectFullPath)" Condition="'@(_AsmInnerBuild)' != ''">
        <AdditionalProperties>%(_AsmInnerBuild.AdditionalProperties)</AdditionalProperties>
        <AdditionalProperties Condition="'$(_AsmCommandLinePackageId)' != ''">%(_AsmInnerBuild.AdditionalProperties);PackageId=$(_AsmToolPackageId).%(_AsmInnerBuild.Identity)</AdditionalProperties>
      </_AsmToolRidProject>
    </ItemGroup>
    <MSBuild Condition="'@(_AsmToolRidProject)' != ''" Projects="@(_AsmToolRidProject)" Targets="Pack" BuildInParallel="$(BuildInParallel)" />
  </Target>

  <!--
    _AsmPackToolContent: a tool package's files (NuGet's TargetsForTfmSpecificContentInPackage,
    replacing _AsmPackNativeContent for a tool): the pointer in the top-level package
    (_AsmPackToolPointer), or a RID package's files (_AsmPackToolRidContent). Two targets with
    conditions, not one with CallTarget: a target's condition, false, also skips its
    dependencies (the publish-list targets run for a RID package only), and items a CallTarget'ed
    target creates would not be visible here.
  -->
  <Target Name="_AsmPackToolContent" DependsOnTargets="_AsmCheckToolPack;_AsmPackToolPointer;_AsmPackToolRidContent" />

  <!-- _AsmPackToolPointer: the top-level package (the RID outer build): DotnetToolSettings.xml
       with the command and one RuntimeIdentifierPackage per RID, in tools/any/any/. -->
  <Target Name="_AsmPackToolPointer" Condition="'$(_AsmRid)' == ''">
    <ItemGroup>
      <_AsmToolRid Include="$(_AsmBuildRuntimeIdentifiers)" />
      <_AsmToolRid PackageId="$(_AsmToolPackageId).%(_AsmToolRid.Identity)" />
    </ItemGroup>
    <AsmWriteToolSettings CommandName="$(ToolCommandName)"
                          RuntimeIdentifierPackages="@(_AsmToolRid)"
                          OutputPath="$(_AsmToolSettingsPath)" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_AsmToolSettingsPath)" PackagePath="tools/any/any/" />
      <FileWrites Include="$(_AsmToolSettingsPath)" />
    </ItemGroup>
  </Target>

  <!--
    _AsmPackToolRidContent: one RID package (a RID inner build): DotnetToolSettings.xml with
    EntryPoint and Runner="executable", and what a publish of that RID holds (the program and its
    PDB, its dependencies at their paths, its data files with CopyToPublishDirectory or
    CopyToOutputDirectory), all under tools/any/<rid>/. PackagePath names each file's folder, not
    the file: NuGet takes a PackagePath without the source's extension for a folder and appends
    the name, which doubled an extensionless program (hello/hello, measured).
  -->
  <Target Name="_AsmPackToolRidContent"
          Condition="'$(_AsmToolRidPack)' == 'true'"
          DependsOnTargets="_AsmResolveProgramDependencies;DefaultCopyToPublishDirectoryMetadata">
    <AsmWriteToolSettings CommandName="$(ToolCommandName)"
                          EntryPoint="$(TargetFileName)"
                          OutputPath="$(_AsmToolSettingsPath)" />
    <ItemGroup>
      <_AsmToolFile Include="$(TargetPath)" AsmToolPath="$(TargetFileName)" />
      <_AsmToolFile Include="$(TargetDir)$(TargetName).pdb" Condition="'$(_AsmOs)' == 'Windows' and Exists('$(TargetDir)$(TargetName).pdb')" AsmToolPath="$(TargetName).pdb" />
      <!-- Batched on each dependency's place; the condition keeps an empty list from adding a
           bare folder (batching over nothing still runs once). -->
      <_AsmToolFile Include="$(TargetDir)%(_AsmProgramDependency.TargetPath)" Condition="'@(_AsmProgramDependency)' != ''" AsmToolPath="%(_AsmProgramDependency.TargetPath)" />
      <_AsmToolFile Include="@(_NoneWithTargetPath)" Condition="'%(_NoneWithTargetPath.CopyToPublishDirectory)' == 'Always' or '%(_NoneWithTargetPath.CopyToPublishDirectory)' == 'PreserveNewest' or '%(_NoneWithTargetPath.CopyToPublishDirectory)' == 'IfDifferent'" AsmToolPath="%(_NoneWithTargetPath.TargetPath)" />
      <_AsmToolFile Include="@(ContentWithTargetPath)" Condition="'%(ContentWithTargetPath.CopyToPublishDirectory)' == 'Always' or '%(ContentWithTargetPath.CopyToPublishDirectory)' == 'PreserveNewest' or '%(ContentWithTargetPath.CopyToPublishDirectory)' == 'IfDifferent'" AsmToolPath="%(ContentWithTargetPath.TargetPath)" />
      <_AsmToolFile>
        <AsmToolFolder>$([System.IO.Path]::GetDirectoryName('%(AsmToolPath)').Replace('\', '/'))</AsmToolFolder>
      </_AsmToolFile>
      <TfmSpecificPackageFile Include="$(_AsmToolSettingsPath)" PackagePath="tools/any/$(_AsmRid)/" />
      <TfmSpecificPackageFile Include="@(_AsmToolFile)" Condition="'%(_AsmToolFile.AsmToolFolder)' == ''" PackagePath="tools/any/$(_AsmRid)/" />
      <TfmSpecificPackageFile Include="@(_AsmToolFile)" Condition="'%(_AsmToolFile.AsmToolFolder)' != ''" PackagePath="tools/any/$(_AsmRid)/%(_AsmToolFile.AsmToolFolder)/" />
      <FileWrites Include="$(_AsmToolSettingsPath)" />
    </ItemGroup>
  </Target>

  <!--
    _AsmComputePackLayout: facts every pack step needs, in the outer and the inner builds alike.

    _AsmPackIsFirstTargetFramework: pack collects content from every target framework of a
    multi-targeted project, and the include files and sources are the same in each. Only the
    first target framework of TargetFrameworks packs them, so each lands once. A single-target
    project is always "first".
    _AsmPackIsMultiTargeted: the shared libraries of two target frameworks have the same file
    name, so they cannot both go to runtimes/<rid>/native/.
    _AsmPackIsDotnetFramework: the target framework whose build a .NET consumer gets, libc's when
    the project has it (net7.0 and later are nearer to netstandard2.0 than to netstandard1.0),
    else the first: it alone packs the C# bindings (_AsmPackNativeContent), which exist once per
    package (contentFiles are chosen by the consumer's framework, not the asm one).
  -->
  <Target Name="_AsmComputePackLayout">
    <ItemGroup>
      <!-- An item Include splits on ";" and trims each name, whatever the project's spacing. -->
      <_AsmPackTargetFramework Include="$(TargetFrameworks)" />
      <_AsmPackLibcTargetFramework Include="@(_AsmPackTargetFramework)" Condition="'%(Identity)' == 'libc'" />
    </ItemGroup>
    <PropertyGroup>
      <_AsmPackFirstTargetFramework>$([System.Text.RegularExpressions.Regex]::Replace('$(TargetFrameworks)', '(?s)^[\s;]*([^;\s]+).*$', '$1'))</_AsmPackFirstTargetFramework>
      <_AsmPackIsFirstTargetFramework Condition="'$(TargetFrameworks)' == '' or '$(_AsmPackFirstTargetFramework)' == '$(TargetFramework)'">true</_AsmPackIsFirstTargetFramework>
      <_AsmPackIsMultiTargeted Condition="@(_AsmPackTargetFramework->Count()) &gt; 1">true</_AsmPackIsMultiTargeted>
      <_AsmPackIsDotnetFramework Condition="'$(TargetFramework)' == 'libc' or ('@(_AsmPackLibcTargetFramework)' == '' and '$(_AsmPackIsFirstTargetFramework)' == 'true')">true</_AsmPackIsDotnetFramework>
    </PropertyGroup>
  </Target>

  <!--
    _AsmGetRidPackContent: one RID's package files (an inner build, called by
    _AsmPackNativeContent), each with PackagePath and RuntimeIdentifier, and AsmLink=true on the
    one a consuming .asmproj links (by AsmPackageLinkKind): the static library, or the shared
    library (on Windows its import library, the file a PE program links against). Object files
    are not packed.
    A program goes to runtimes/<rid>/native/ with what it needs at run time (its bundle, from
    _AsmComputeProgramBundle, without PDBs), each file AsmPackProgram=true: a .NET consumer gets
    it there as NuGet gives native files, and an asm program consumer through the generated
    props (AsmReferencedProgram). The bundle must be flat (ASM0051): NuGet copies runtimes/
    files flat into a consumer built for one RID (measured with the .NET 11 SDK), where a run
    path to a subfolder would find nothing.
  -->
  <Target Name="_AsmGetRidPackContent" DependsOnTargets="_AsmComputePackLayout;_AsmComputeProgramBundle" Returns="@(_AsmRidPackFile)">
    <PropertyGroup>
      <_AsmPackNativeFolder>native/$(RuntimeIdentifier)/$(_AsmTargetFrameworkName)/</_AsmPackNativeFolder>
      <_AsmPackStaticPath Condition="'$(AsmStaticLibraryPath)' != ''">$(_AsmPackNativeFolder)$([System.IO.Path]::GetFileName('$(AsmStaticLibraryPath)'))</_AsmPackStaticPath>
      <_AsmPackSharedPath Condition="'$(AsmSharedLibraryPath)' != '' and '$(_AsmArch)' != 'wasm' and '$(_AsmPackIsMultiTargeted)' != 'true'">runtimes/$(RuntimeIdentifier)/native/$(TargetFileName)</_AsmPackSharedPath>
      <_AsmPackSharedPath Condition="'$(AsmSharedLibraryPath)' != '' and '$(_AsmArch)' != 'wasm' and '$(_AsmPackIsMultiTargeted)' == 'true'">runtimes/$(RuntimeIdentifier)/nativeassets/$(_AsmNuGetFramework)/$(TargetFileName)</_AsmPackSharedPath>
      <!-- A WebAssembly module goes next to its archive (see the layout above): per framework
           already, so no nativeassets/ folder is needed when the project multi-targets. -->
      <_AsmPackSharedPath Condition="'$(AsmSharedLibraryPath)' != '' and '$(_AsmArch)' == 'wasm'">$(_AsmPackNativeFolder)$(TargetFileName)</_AsmPackSharedPath>
      <_AsmPackImportPath Condition="'$(AsmImportLibraryPath)' != ''">$(_AsmPackNativeFolder)$([System.IO.Path]::GetFileName('$(AsmImportLibraryPath)'))</_AsmPackImportPath>

      <!-- The file to link: what AsmPackageLinkKind asks for when the project produces it, else
           the other one. A WebAssembly module is never one: wasm-ld cannot link against it, so
           a wasm package without an archive (AsmProduceStaticLibrary=false) links nothing. -->
      <_AsmPackSharedLink Condition="'$(_AsmArch)' != 'wasm'">$([MSBuild]::ValueOrDefault('$(_AsmPackImportPath)', '$(_AsmPackSharedPath)'))</_AsmPackSharedLink>
      <_AsmPackLink Condition="'$(AsmPackageLinkKind)' == 'Static'">$([MSBuild]::ValueOrDefault('$(_AsmPackStaticPath)', '$(_AsmPackSharedLink)'))</_AsmPackLink>
      <_AsmPackLink Condition="'$(AsmPackageLinkKind)' != 'Static'">$([MSBuild]::ValueOrDefault('$(_AsmPackSharedLink)', '$(_AsmPackStaticPath)'))</_AsmPackLink>
      <!-- A consumer that links the shared library (or its import library) needs the library
           itself at run time: an asm program copies it next to itself (AsmRuntimeFile in the
           generated props, AsmLayOutProgramDependencies). -->
      <_AsmPackRuntimePath Condition="'$(_AsmPackLink)' != '' and '$(_AsmPackLink)' == '$(_AsmPackSharedLink)'">$(_AsmPackSharedPath)</_AsmPackRuntimePath>
      <!-- A program's folder in the package: runtimes/<rid>/native/, or nativeassets/<tfm>/ when
           the project multi-targets, as for a shared library. -->
      <_AsmPackProgramFolder Condition="'$(_AsmPackIsMultiTargeted)' != 'true'">runtimes/$(RuntimeIdentifier)/native/</_AsmPackProgramFolder>
      <_AsmPackProgramFolder Condition="'$(_AsmPackIsMultiTargeted)' == 'true'">runtimes/$(RuntimeIdentifier)/nativeassets/$(_AsmNuGetFramework)/</_AsmPackProgramFolder>
    </PropertyGroup>
    <ItemGroup>
      <_AsmRidPackFile Include="$(AsmStaticLibraryPath)" Condition="'$(_AsmPackStaticPath)' != ''" PackagePath="$(_AsmPackStaticPath)" />
      <_AsmRidPackFile Include="$(AsmSharedLibraryPath)" Condition="'$(_AsmPackSharedPath)' != ''" PackagePath="$(_AsmPackSharedPath)" />
      <_AsmRidPackFile Include="$(AsmImportLibraryPath)" Condition="'$(_AsmPackImportPath)' != ''" PackagePath="$(_AsmPackImportPath)" />
      <!-- PackagePath is the folder, not the file: NuGet takes a PackagePath without the source's
           extension for a folder and appends the file's name, so a Linux or macOS program (no
           extension) came out as runtimes/linux-x64/native/hello/hello (measured). A bundle is
           flat (ASM0051 below), so each file keeps its own name there. AsmPackageFile is the
           file's path in the package, for the props. -->
      <_AsmRidPackFile Include="@(_AsmProgramBundleFile)" Condition="'%(_AsmProgramBundleFile.AsmSymbols)' != 'true'" PackagePath="$(_AsmPackProgramFolder)" AsmPackageFile="$(_AsmPackProgramFolder)%(_AsmProgramBundleFile.AsmBundlePath)" AsmPackProgram="true" />
      <_AsmRidPackFile RuntimeIdentifier="$(RuntimeIdentifier)" />
      <_AsmRidPackFile Condition="'%(PackagePath)' == '$(_AsmPackLink)'" AsmLink="true" AsmRuntimePackagePath="$(_AsmPackRuntimePath)" />
      <_AsmPackNestedProgramFile Include="@(_AsmRidPackFile)" Condition="'%(_AsmRidPackFile.AsmPackProgram)' == 'true' and $([System.String]::Copy('%(_AsmRidPackFile.AsmBundlePath)').Contains('/'))" />
    </ItemGroup>
    <Error Code="ASM0051"
           Condition="'@(_AsmPackNestedProgramFile)' != ''"
           Text="A packed program keeps the libraries and programs it needs next to it, and these are in subfolders: @(_AsmPackNestedProgramFile->'%(AsmBundlePath)', ', ') ($(RuntimeIdentifier)). NuGet copies a package's runtimes/ files flat into a consumer built for one RID, where the program's run path would then find nothing. Keep them next to the program: BinariesCopyPath=&quot;AppFolder&quot; (the default) on its references." />
  </Target>

  <!--
    _AsmPackNativeContent: hooked into NuGet's TargetsForTfmSpecificContentInPackage, so it
    runs once per target framework, in that framework's RID outer build. Collects every RID's
    files, writes the framework's consumer props, and returns TfmSpecificPackageFile items
    whose PackagePath is the layout above.
  -->
  <Target Name="_AsmPackNativeContent" DependsOnTargets="_AsmComputePackLayout;_AsmComputeCHeader">
    <!-- The inner builds with the dispatch's global properties: MSBuild reuses them. -->
    <ItemGroup>
      <_AsmRidToPack Include="$(_AsmBuildRuntimeIdentifiers)" />
      <_AsmRidPackProject Include="$(MSBuildProjectFullPath)" Condition="'@(_AsmRidToPack)' != ''">
        <AdditionalProperties>RuntimeIdentifier=%(_AsmRidToPack.Identity)</AdditionalProperties>
      </_AsmRidPackProject>
    </ItemGroup>
    <MSBuild Condition="'@(_AsmRidPackProject)' != ''" Projects="@(_AsmRidPackProject)" Targets="_AsmGetRidPackContent" BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmPackedRidFile" />
    </MSBuild>

    <ItemGroup>
      <_AsmPackedLink Include="@(_AsmPackedRidFile->'%(PackagePath)')" Condition="'%(_AsmPackedRidFile.AsmLink)' == 'true'" />
      <!-- A program's files, for an asm program that references the package: it delivers them
           next to itself (AsmReferencedProgram in the props). -->
      <_AsmPackedProgram Include="@(_AsmPackedRidFile->'%(AsmPackageFile)')" Condition="'%(_AsmPackedRidFile.AsmPackProgram)' == 'true'" />
      <_AsmSupportedRidItem Include="$(_AsmSupportedRuntimeIdentifiers)" />
    </ItemGroup>
    <PropertyGroup>
      <_AsmPackHasIncludes Condition="'@(AsmPublicInclude)' != '' or ('$(_AsmWritesCHeader)' == 'true' and Exists('$(_AsmApiMergedFullPath)'))">true</_AsmPackHasIncludes>
      <!-- The C header beside the merged API file of this target framework's build. -->
      <_AsmPackCHeader>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutDir)', '$(AssemblyName).h'))</_AsmPackCHeader>
    </PropertyGroup>
    <!-- ASM0149: the project ships its own include/<AssemblyName>.h, so the package holds that one,
         and the SDK wrote no header of its own (_AsmComputeCHeader). Said where it matters, when
         the package is made, and only for a library with PROTO or STRUCT lines. -->
    <Warning Code="ASM0149"
             Condition="'$(_AsmPackIsFirstTargetFramework)' == 'true' and '$(AsmGenerateCHeader)' != 'false' and '@(_AsmOwnCHeader)' != '' and Exists('$(_AsmApiMergedFullPath)')"
             Text="include/$(AssemblyName).h is the project's own, so the package carries it and the SDK writes no C header from the PROTO and STRUCT lines. Rename one of them, or set AsmGenerateCHeader to false to keep yours without this warning." />
    <AsmWritePackageProps PackageId="$(PackageId)"
                          PackageVersion="$(PackageVersion)"
                          TargetFrameworkName="$(_AsmTargetFrameworkName)"
                          NuGetFramework="$(_AsmNuGetFramework)"
                          HasIncludes="$(_AsmPackHasIncludes)"
                          ImportName="$(AssemblyName)"
                          LinkLibraries="@(_AsmPackedLink)"
                          ProgramFiles="@(_AsmPackedProgram)"
                          SupportedRuntimeIdentifiers="@(_AsmSupportedRidItem)"
                          RuntimeIdentifierGraphPath="$(RuntimeIdentifierGraphPath)"
                          OutputPath="$(_AsmGeneratedPropsPath)" />
    <!-- The empty lib/ marker. Touch, not WriteLinesToFile: with no lines and Overwrite, that
         task deletes the file instead of writing an empty one. -->
    <Touch Files="$(_AsmEmptyLibMarkerPath)" AlwaysCreate="true" />

    <!-- A shared library is something a .NET consumer loads, and a program something it starts:
         give it BinariesCopyPath for either. The loader is for a library only. A package of
         static libraries only has nothing for .NET to move. -->
    <ItemGroup>
      <_AsmPackedSharedLibrary Include="@(_AsmPackedRidFile)" Condition="$([System.String]::Copy('%(_AsmPackedRidFile.PackagePath)').StartsWith('runtimes/'))" />
    </ItemGroup>
    <PropertyGroup>
      <_AsmPackLoaderName Condition="'$(_AsmOutputKind)' == 'SharedLibrary'">$(AssemblyName)</_AsmPackLoaderName>
    </PropertyGroup>

    <!-- The C# bindings (phase 4; the owner's spec of 2026-11-25): a library with PROTO or STRUCT
         lines carries its baseline, written now (AsmWritePackageBindings), the API file and this
         SDK's bindings generator, for its .NET consumers, who need no AsmFoundation.Sdk. Once per
         package: from the target framework a .NET consumer gets. Not for a program (started,
         never loaded), and only with the generator at hand (an SDK used from a source folder
         may not have it built). -->
    <PropertyGroup>
      <_AsmPackBindingsGeneratorSource>$(AsmFoundationSdkDirectory)bindings/netstandard2.0/AsmFoundation.Sdk.Bindings.dll</_AsmPackBindingsGeneratorSource>
      <_AsmPackBindingsGeneratorVersion Condition="'$(_AsmPackBindingsGeneratorVersion)' == ''">$([MSBuild]::ValueOrDefault('$(AsmFoundationSdkVersion)', '0.0.0'))</_AsmPackBindingsGeneratorVersion>
      <_AsmPackHasBindings Condition="'$(_AsmPackIsDotnetFramework)' == 'true' and '$(_AsmOutputKind)' != 'Executable' and Exists('$(_AsmApiMergedFullPath)') and Exists('$(_AsmPackBindingsGeneratorSource)')">true</_AsmPackHasBindings>
    </PropertyGroup>
    <AsmWritePackageBindings Condition="'$(_AsmPackHasBindings)' == 'true'"
                             ApiFile="$(_AsmApiMergedFullPath)"
                             PackageId="$(PackageId)"
                             PackageVersion="$(PackageVersion)"
                             Origin="AsmFoundation.Sdk $(AsmFoundationSdkVersion)"
                             OutputPath="$(_AsmGeneratedBindingsPath)">
      <Output TaskParameter="Library" PropertyName="_AsmPackBindingsLibrary" />
      <Output TaskParameter="DefaultNamespace" PropertyName="_AsmPackBindingsNamespace" />
      <Output TaskParameter="TokenPrefix" PropertyName="_AsmPackBindingsTokenPrefix" />
    </AsmWritePackageBindings>
    <!-- The targets: BinariesCopyPath for a package with shared libraries, the bindings'
         targets for a package with bindings, both in one file (NuGet imports one per id). -->
    <PropertyGroup>
      <_AsmPackMovesNativeFiles>false</_AsmPackMovesNativeFiles>
      <_AsmPackMovesNativeFiles Condition="'@(_AsmPackedSharedLibrary)' != ''">true</_AsmPackMovesNativeFiles>
      <_AsmPackWritesConsumerTargets Condition="'$(_AsmPackMovesNativeFiles)' == 'true' or '$(_AsmPackHasBindings)' == 'true'">true</_AsmPackWritesConsumerTargets>
    </PropertyGroup>
    <AsmWritePackageConsumerTargets Condition="'$(_AsmPackWritesConsumerTargets)' == 'true'"
                                    PackageId="$(PackageId)"
                                    PackageVersion="$(PackageVersion)"
                                    Origin="AsmFoundation.Sdk"
                                    LibraryNames="$(_AsmPackLoaderName)"
                                    MovesNativeFiles="$(_AsmPackMovesNativeFiles)"
                                    BindingsLibrary="$(_AsmPackBindingsLibrary)"
                                    BindingsNamespace="$(_AsmPackBindingsNamespace)"
                                    BindingsTokenPrefix="$(_AsmPackBindingsTokenPrefix)"
                                    BindingsApiFile="build/bindings/$(AssemblyName).api.json"
                                    BindingsGenerator="build/bindings/AsmFoundation.Sdk.Bindings.dll"
                                    BindingsGeneratorVersion="$(_AsmPackBindingsGeneratorVersion)"
                                    OutputPath="$(_AsmGeneratedConsumerTargetsPath)" />

    <ItemGroup>
      <TfmSpecificPackageFile Include="@(AsmPublicInclude)" Condition="'$(_AsmPackIsFirstTargetFramework)' == 'true'" PackagePath="include/%(RecursiveDir)%(Filename)%(Extension)" />
      <!-- The C header the build wrote beside the merged API file (_AsmWriteMergedCHeader), next
           to the public include files, from the first target framework (the include/ folder is
           shared by all of them). -->
      <TfmSpecificPackageFile Include="$(_AsmPackCHeader)" Condition="'$(_AsmPackIsFirstTargetFramework)' == 'true' and '$(_AsmWritesCHeader)' == 'true' and Exists('$(_AsmPackCHeader)')" PackagePath="include/$(AssemblyName).h" />
      <!-- AsmPackSources: the asm sources (Compile items) and include files (None items ending
           in .inc) under src/, for consumers that assemble them themselves. -->
      <TfmSpecificPackageFile Include="@(Compile)" Condition="'$(AsmPackSources)' == 'true' and '$(_AsmPackIsFirstTargetFramework)' == 'true' and ('%(Extension)' == '.asm' or '%(Extension)' == '.s')" PackagePath="src/%(RecursiveDir)%(Filename)%(Extension)" />
      <TfmSpecificPackageFile Include="@(None->WithMetadataValue('Extension', '.inc'))" Condition="'$(AsmPackSources)' == 'true' and '$(_AsmPackIsFirstTargetFramework)' == 'true'" PackagePath="src/%(RecursiveDir)%(Filename)%(Extension)" />
      <TfmSpecificPackageFile Include="$(_AsmEmptyLibMarkerPath)" PackagePath="lib/$(_AsmNuGetFramework)/_._" />
      <TfmSpecificPackageFile Include="@(_AsmPackedRidFile)" PackagePath="%(_AsmPackedRidFile.PackagePath)" />
      <TfmSpecificPackageFile Include="$(_AsmGeneratedPropsPath)" PackagePath="build/$(_AsmNuGetFramework)/$(PackageId).props" />
      <TfmSpecificPackageFile Include="$(_AsmGeneratedPropsPath)" PackagePath="buildTransitive/$(_AsmNuGetFramework)/$(PackageId).props" />
      <TfmSpecificPackageFile Include="$(_AsmGeneratedConsumerTargetsPath)" Condition="'$(_AsmPackWritesConsumerTargets)' == 'true'" PackagePath="build/$(_AsmNuGetFramework)/$(PackageId).targets" />
      <TfmSpecificPackageFile Include="$(_AsmGeneratedConsumerTargetsPath)" Condition="'$(_AsmPackWritesConsumerTargets)' == 'true'" PackagePath="buildTransitive/$(_AsmNuGetFramework)/$(PackageId).targets" />
      <!-- The bindings: the baseline as a C# content file NuGet preprocesses (.pp) and compiles
           (BuildAction Compile, written into the nuspec's contentFiles) for net7.0 and later; the
           API file and the generator beside the targets' folders, which reach them as
           ../../build/bindings/ from build/<tfm>/ and buildTransitive/<tfm>/ alike. -->
      <TfmSpecificPackageFile Include="$(_AsmGeneratedBindingsPath)" Condition="'$(_AsmPackHasBindings)' == 'true'" PackagePath="contentFiles/cs/net7.0/AsmBindings/$(_AsmPackBindingsLibrary).cs.pp" BuildAction="Compile" />
      <TfmSpecificPackageFile Include="$(_AsmApiMergedFullPath)" Condition="'$(_AsmPackHasBindings)' == 'true'" PackagePath="build/bindings/$(AssemblyName).api.json" />
      <TfmSpecificPackageFile Include="$(_AsmPackBindingsGeneratorSource)" Condition="'$(_AsmPackHasBindings)' == 'true'" PackagePath="build/bindings/AsmFoundation.Sdk.Bindings.dll" />
      <FileWrites Include="$(_AsmGeneratedPropsPath);$(_AsmEmptyLibMarkerPath)" />
      <FileWrites Include="$(_AsmGeneratedConsumerTargetsPath)" Condition="'$(_AsmPackWritesConsumerTargets)' == 'true'" />
      <FileWrites Include="$(_AsmGeneratedBindingsPath)" Condition="'$(_AsmPackHasBindings)' == 'true'" />
    </ItemGroup>
  </Target>

  <!--
    _AsmRemoveSdkPackageDependency: takes the implicit AsmFoundation.Sdk reference (see
    Properties.targets) back out of the packed package's dependencies, once NuGet has written
    the .nupkg (NuGetPackOutput: the .nupkg and .nuspec paths). A package built with this SDK
    must not require it: an asm project on an older SDK would otherwise fail to restore it
    (NU1605, a downgrade), and a .NET consumer of the package gets its native files from
    runtimes/ through NuGet alone. Runs again on an up-to-date package without harm: there is
    nothing left to remove.
  -->
  <Target Name="_AsmRemoveSdkPackageDependency" AfterTargets="GenerateNuspec" Condition="'@(NuGetPackOutput)' != ''">
    <AsmRemovePackageDependency Packages="@(NuGetPackOutput)" DependencyId="AsmFoundation.Sdk" />
  </Target>
</Project>
