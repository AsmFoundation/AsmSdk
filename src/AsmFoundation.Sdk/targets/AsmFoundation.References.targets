<Project>
  <!--
    AsmFoundation.References.targets - how .asmproj projects reference each other, and how a
    .csproj references an .asmproj. Imported after Microsoft.NET.Sdk's targets.

    asmproj -> asmproj (ProjectReference): the referencing project gets the referenced
      project's public include directories and links its static library (or its shared
      library, or its objects) - see GetAsmLinkInputs.
    csproj -> asmproj (ProjectReference): the asmproj is built first and its shared library is
      copied next to the managed output, ready for P/Invoke - see GetCopyToOutputDirectoryItems.
      No assembly reference is added (see GetTargetPathWithTargetPlatformMoniker). When the
      asmproj targets both freestanding and libc, NuGet's nearest-framework rule gives a .NET
      project the libc build (libc stands for netstandard2.0, freestanding for netstandard1.0;
      see AsmFoundation.Properties.targets).

    Which target framework of a referenced asmproj is used is NuGet's decision, exactly as for
    a .csproj: freestanding code links into libc projects, never the reverse (NU1201).
  -->

  <PropertyGroup>
    <!-- The folders a referencing project, or a package consumer, adds to its include path:
         include/ when the project has one, the project folder otherwise. -->
    <_AsmHasPublicIncludeFolder Condition="Exists('$(MSBuildProjectDirectory)/include')">true</_AsmHasPublicIncludeFolder>
  </PropertyGroup>
  <ItemGroup Condition="'@(AsmPublicIncludeDirectory)' == ''">
    <AsmPublicIncludeDirectory Include="$(MSBuildProjectDirectory)/include/" Condition="'$(_AsmHasPublicIncludeFolder)' == 'true'" />
    <AsmPublicIncludeDirectory Include="$(MSBuildProjectDirectory)/" Condition="'$(_AsmHasPublicIncludeFolder)' != 'true'" />
  </ItemGroup>

  <!--
    GetTargetPathWithTargetPlatformMoniker: returns nothing. The common targets return this
    item from Build and GetTargetPath, and a referencing .csproj would hand it to the assembly
    resolver as a reference; a .so or .a is not an assembly and would raise MSB3246.
  -->
  <Target Name="GetTargetPathWithTargetPlatformMoniker" Returns="@(TargetPathWithTargetPlatformMoniker)" />

  <!--
    GetAsmLinkInputs: what a referencing asmproj needs from this one, as items with
    AsmItemType metadata:
      IncludeDirectory - each public include directory;
      LinkInput        - the static library if one is produced (preferred: no run-time
                         dependency), else the shared library (on Windows its import library,
                         the file a PE program links against), else the object files.
    Called by _AsmResolveProjectReferences after ResolveProjectReferences has built us, in the
    referencing project's RID: an inner build of one RID asks for that RID's files (the RID
    reaches us because asm projects are not RID-agnostic; see Properties.targets).

    A shared link input also says what a program that links it needs at run time:
      AsmRuntimeFile     the shared library itself (.so, .dylib, .dll). On Windows the link input
                         is the import library (foo.dll.lib), so without this a referencing
                         program could not know which file to copy next to itself.
      AsmRuntimeSymbols  its PDB, when the link wrote one (Windows, debug information on).
    A referencing program copies them where its BinariesCopyPath says (AsmLayOutProgramDependencies
    in Build.targets). A static library has no run-time file: the program contains its code.

    A program links into nothing, but a referencing program can deliver it: its files come back
    as Program items (_AsmComputeProgramBundle below: the program, its PDB, and what it needs at
    run time, each with AsmBundlePath, its path relative to the program), which the referencing
    program copies where its BinariesCopyPath says, keeping their paths relative to each other.
  -->
  <Target Name="GetAsmLinkInputs" DependsOnTargets="AsmPrepare;_AsmComputeProgramBundle" Returns="@(_AsmExportedLinkInput)">
    <PropertyGroup>
      <_AsmSharedLinkInput>$(AsmSharedLibraryPath)</_AsmSharedLinkInput>
      <_AsmSharedLinkInput Condition="'$(AsmImportLibraryPath)' != ''">$(AsmImportLibraryPath)</_AsmSharedLinkInput>
      <!-- Checked when a referencing project asks, after this project was built: the PDB exists
           only for a Windows link with debug information. -->
      <_AsmSharedLinkSymbols Condition="'$(_AsmOs)' == 'Windows' and '$(AsmSharedLibraryPath)' != '' and Exists('$(TargetDir)$(TargetName).pdb')">$(TargetDir)$(TargetName).pdb</_AsmSharedLinkSymbols>
    </PropertyGroup>
    <ItemGroup>
      <_AsmExportedLinkInput Include="@(AsmPublicIncludeDirectory->'%(FullPath)')" AsmItemType="IncludeDirectory" AsmOrigin="Project" AsmProject="$(MSBuildProjectName)" />
      <_AsmExportedLinkInput Include="$(AsmStaticLibraryPath)" Condition="'$(AsmStaticLibraryPath)' != ''" AsmItemType="LinkInput" AsmOrigin="Project" AsmProject="$(MSBuildProjectName)" />
      <_AsmExportedLinkInput Include="$(_AsmSharedLinkInput)" Condition="'$(AsmStaticLibraryPath)' == '' and '$(_AsmSharedLinkInput)' != ''" AsmItemType="LinkInput" AsmOrigin="Project" AsmProject="$(MSBuildProjectName)" AsmRuntimeFile="$(AsmSharedLibraryPath)" AsmRuntimeSymbols="$(_AsmSharedLinkSymbols)" />
      <!-- ObjectToolPath, the absolute path: ObjectFile is relative to THIS project's folder,
           and a referencing project would look for it in its own (the 0.1.0 and 0.2.0 bug:
           "cannot open <referencing project>/obj/.../x.o"). -->
      <_AsmExportedLinkInput Include="@(_AsmSelectedSource->'%(ObjectToolPath)')" Condition="'$(_AsmOutputKind)' == 'Objects'" AsmItemType="LinkInput" AsmOrigin="Project" AsmProject="$(MSBuildProjectName)" />
      <_AsmExportedLinkInput Include="@(_AsmProgramBundleFile)" AsmItemType="Program" AsmOrigin="Project" AsmProject="$(MSBuildProjectName)" />
    </ItemGroup>
  </Target>

  <!--
    _AsmComputeProgramBundle: what a program (one RID) takes along to whatever references it,
    as _AsmProgramBundleFile items: the program, its PDB when the link wrote one, and every file
    _AsmResolveProgramDependencies put next to (or below) it, the copies in this program's own
    output folder. Each has AsmBundlePath (its path relative to the program, forward slashes),
    AsmProgramName (the program's file name) and, on a PDB, AsmSymbols=true. Keeping the paths
    relative to each other is what keeps the program's run paths valid wherever a consumer puts
    it. Data files (CopyToOutputDirectory) stay behind: they are the program's own business, and
    NuGet would flatten their folders for a consumer built for one RID.
    Nothing for anything but a program, and nothing in the RID outer build.
  -->
  <Target Name="_AsmComputeProgramBundle"
          Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' == 'Executable'"
          DependsOnTargets="_AsmResolveProgramDependencies">
    <PropertyGroup>
      <_AsmProgramPdb Condition="'$(_AsmOs)' == 'Windows' and Exists('$(TargetDir)$(TargetName).pdb')">$(TargetDir)$(TargetName).pdb</_AsmProgramPdb>
    </PropertyGroup>
    <ItemGroup>
      <_AsmProgramBundleFile Include="$(TargetPath)" AsmBundlePath="$(TargetFileName)" />
      <_AsmProgramBundleFile Include="$(_AsmProgramPdb)" Condition="'$(_AsmProgramPdb)' != ''" AsmBundlePath="$(TargetName).pdb" AsmSymbols="true" />
      <!-- One item per dependency (batched on its TargetPath, the place it got here); the
           condition keeps an empty list from adding a bare folder (batching over nothing still
           runs once). -->
      <_AsmProgramBundleFile Include="$(TargetDir)%(_AsmProgramDependency.TargetPath)" Condition="'@(_AsmProgramDependency)' != ''" AsmBundlePath="%(_AsmProgramDependency.TargetPath)" AsmSymbols="%(_AsmProgramDependency.AsmSymbols)" />
      <_AsmProgramBundleFile AsmProgramName="$(TargetFileName)" />
    </ItemGroup>
  </Target>

  <!--
    _AsmSkipAsmReferencesInRidOuterBuild: the RID outer build links nothing, so it visits no
    referenced .asmproj; each inner build resolves them for its own RID. Build already skips
    reference resolution there (see BuildDependsOn in Build.targets), but other entry points
    still run ResolveReferences in the outer build, NuGet's pack among them
    (_GetFrameworkAssemblyReferences): it built each referenced asm project with no RID, which
    stopped a reference that names none with ASM0010 (measured). The references stay
    ProjectReference items, so pack still turns them into package dependencies.
  -->
  <Target Name="_AsmSkipAsmReferencesInRidOuterBuild" AfterTargets="_SplitProjectReferencesByFileExistence" Condition="'$(_AsmRid)' == ''">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Remove="@(_MSBuildProjectReferenceExistent)" Condition="'%(Extension)' == '.asmproj'" />
    </ItemGroup>
  </Target>

  <!--
    _AsmResolveProjectReferences: collects GetAsmLinkInputs from every referenced .asmproj and
    adds them to this project's AsmIncludeDirectory and NativeLibrary items (NativeAOT's name for
    link inputs; AsmLinkLibrary until 0.3.0). ProjectReference
    items to anything else (for example a .csproj holding a generator) are left alone.

    The referenced project is called exactly as ResolveProjectReferences calls it, so the
    MSBuild engine reuses that build instead of starting another one:
      - SetTargetFramework is NuGet's choice of the referenced project's target framework
        (the nearest to ours: a libc project referencing a freestanding;libc project gets
        libc). It is set only when the referenced project multi-targets.
      - UndefineProperties (item metadata, which the MSBuild task honors) removes our own
        global TargetFramework when the referenced project has a single one. Without it, the
        libc inner build of a multi-targeted project would build a freestanding-only
        reference as libc.
      - RemoveProperties drops the global properties the common targets drop.
  -->
  <Target Name="_AsmResolveProjectReferences" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_AsmReferencedProject Include="@(_MSBuildProjectReferenceExistent)" Condition="'%(Extension)' == '.asmproj'" />
    </ItemGroup>
    <MSBuild Projects="@(_AsmReferencedProject)"
             Targets="GetAsmLinkInputs"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_AsmReferencedProject.SetConfiguration);%(_AsmReferencedProject.SetPlatform);%(_AsmReferencedProject.SetTargetFramework)"
             RemoveProperties="%(_AsmReferencedProject.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'@(_AsmReferencedProject)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmReferencedOutput" />
    </MSBuild>
    <ItemGroup>
      <AsmIncludeDirectory Include="@(_AsmReferencedOutput)" Condition="'%(_AsmReferencedOutput.AsmItemType)' == 'IncludeDirectory'" />
      <NativeLibrary Include="@(_AsmReferencedOutput)" Condition="'%(_AsmReferencedOutput.AsmItemType)' == 'LinkInput'" />
      <!-- A referenced program's files: a program delivers them (_AsmResolveProgramDependencies);
           anything else ignores them. -->
      <AsmReferencedProgram Include="@(_AsmReferencedOutput)" Condition="'%(_AsmReferencedOutput.AsmItemType)' == 'Program'" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- .NET projects that reference this one                                                  -->
  <!-- ===================================================================================== -->

  <!--
    A .NET project that references an .asmproj gets the native library of the RID it runs on,
    the way a PackageReference gets a package's runtimes/ folder. The work is shared between
    this file (what the asm project offers) and the consumer targets in the SDK package's
    buildTransitive/ folder (what the .NET project does with it), which reach the .NET project
    through the implicit AsmFoundation.Sdk PackageReference of every .asmproj (see
    Properties.targets):
      RID-specific .NET build (-r linux-arm64, a RuntimeIdentifier in the .csproj): the consumer
        targets ask GetAsmRuntimeIdentifiers what this project builds, pick the best RID for
        theirs by NuGet's fallback order, and build that RID here; GetCopyToOutputDirectoryItems
        of that inner build hands over the library, flat, next to the app.
      Portable .NET build (no RuntimeIdentifier): this project's RID outer build builds every RID
        it lists (or the ProjectReference's RuntimeIdentifiers metadata asks for);
        GetCopyToOutputDirectoryItems hands over each RID's library as
        runtimes/<rid>/native/<file>, and the consumer targets add them to the app's deps.json
        (GetAsmNativeRuntimeAssets), so the .NET host loads the one for the machine it runs on.
  -->

  <!--
    GetAsmRuntimeIdentifiers: the RIDs this project declares, empty when it declares none (it
    then builds whatever RID it is asked for). The caller removes its own global
    RuntimeIdentifier first: a lone RuntimeIdentifier counts as the declared list, and the
    caller's must not be mistaken for it.
  -->
  <Target Name="GetAsmRuntimeIdentifiers" Returns="@(_AsmDeclaredRuntimeIdentifier)">
    <ItemGroup>
      <_AsmDeclaredRuntimeIdentifier Include="$(_AsmDeclaredRuntimeIdentifiers)" />
    </ItemGroup>
  </Target>

  <!--
    GetAsmConsumerInfo: what a referencing .NET project needs to know before it builds this
    project, as one item (the project file) with metadata:
      AsmOutputKind        SharedLibrary, StaticLibrary, Executable or Objects; a .NET app loads
                           a shared library and starts a program (Executable), and gets both;
                           a static library or object files are for asm projects to link
      RuntimeIdentifiers   the declared RIDs (as GetAsmRuntimeIdentifiers), ";"-separated
      AsmImportName        the library's name without "lib" or an extension (its AssemblyName):
                           the name [DllImport] uses, which the generated loader looks for
    The caller removes its own global RuntimeIdentifier first, as for GetAsmRuntimeIdentifiers.
  -->
  <Target Name="GetAsmConsumerInfo" Returns="@(_AsmConsumerInfo)">
    <ItemGroup>
      <_AsmConsumerInfo Include="$(MSBuildProjectFullPath)" AsmOutputKind="$(_AsmOutputKind)" RuntimeIdentifiers="$(_AsmDeclaredRuntimeIdentifiers)" AsmImportName="$(AssemblyName)" OptionalOnUnlistedRuntimes="$(OptionalOnUnlistedRuntimes)" />
    </ItemGroup>
  </Target>

  <!--
    _AsmMakeStaticLibraryReferencesPrivate: a shared library's references to static libraries
    are private by default (PrivateAssets="all"), as every reference of a program already is
    (the ItemDefinitionGroup in Properties.targets). The static library's code is linked INTO
    the shared library, so neither the shared library's package nor the projects that
    reference it need the static library. Before, NuGet made it a dependency of the package
    (its consumers failed with NU1101, the static library having no package of its own) and a
    transitive reference of every project that references the shared library.

    When: before NuGet reads the references for its restore graph
    (_GenerateProjectRestoreGraphPerFramework); dotnet pack takes a package's dependencies from
    the assets file that restore writes, and the .NET SDK its transitive project references, so
    both follow. A restore that does not run MSBuild's restore targets (one that reads only the
    evaluated project) does not see this: write PrivateAssets="all" yourself for such a tool.

    Which references: an .asmproj reference that sets no PrivateAssets, and whose project says
    it is a StaticLibrary (GetAsmConsumerInfo: its own evaluation decides, not a guess from its
    file). PrivateAssets="none" keeps a static library a dependency, for a package that ships it
    too. Not in a shared library that also produces a static library (AsmProduceStaticLibrary):
    a program that links that one statically still needs the static libraries it links; nor in
    a static library or object files, whose users link what they link.
  -->
  <Target Name="_AsmMakeStaticLibraryReferencesPrivate"
          BeforeTargets="_GenerateProjectRestoreGraphPerFramework"
          DependsOnTargets="_AsmFindReferencesToClassify;_AsmClassifyEachReference"
          Condition="'$(_AsmOutputKind)' == 'SharedLibrary' and '$(AsmProduceStaticLibrary)' != 'true'" />

  <Target Name="_AsmFindReferencesToClassify">
    <ItemGroup>
      <_AsmReferenceToClassify Include="@(ProjectReference)" Condition="'%(Extension)' == '.asmproj' and '%(ProjectReference.PrivateAssets)' == ''" />
    </ItemGroup>
  </Target>

  <!-- One batch per reference, conditioned on there being one: batching over an empty list still
       runs a target once (see the consumer targets). -->
  <Target Name="_AsmClassifyEachReference" Outputs="%(_AsmReferenceToClassify.Identity)" Condition="'@(_AsmReferenceToClassify)' != ''">
    <!-- Properties keep their values from one batch to the next: each one is set here. The
         batch's one item, as written in the project (its Include): the ProjectReference to
         update has exactly that identity. -->
    <PropertyGroup>
      <_AsmClassifiedSpec>@(_AsmReferenceToClassify)</_AsmClassifiedSpec>
      <_AsmClassifiedKind />
    </PropertyGroup>
    <!-- Asked as the consumer targets ask (GetAsmConsumerInfo needs no build), without this
         project's RuntimeIdentifier and TargetFramework: a restore passes them as global
         properties, and the referenced project may build another target framework. -->
    <MSBuild Projects="@(_AsmReferenceToClassify)"
             Targets="GetAsmConsumerInfo"
             RemoveProperties="RuntimeIdentifier;TargetFramework;%(_AsmReferenceToClassify.GlobalPropertiesToRemove)">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmClassifiedInfo" />
    </MSBuild>
    <PropertyGroup>
      <_AsmClassifiedKind>@(_AsmClassifiedInfo->'%(AsmOutputKind)')</_AsmClassifiedKind>
    </PropertyGroup>
    <!-- An item element without Include, inside a target, sets metadata on the existing items
         its condition selects: here the one reference of this batch. -->
    <ItemGroup Condition="'$(_AsmClassifiedKind)' == 'StaticLibrary'">
      <ProjectReference Condition="'%(ProjectReference.Identity)' == '$(_AsmClassifiedSpec)'">
        <PrivateAssets>all</PrivateAssets>
      </ProjectReference>
    </ItemGroup>
    <Message Condition="'$(_AsmClassifiedKind)' == 'StaticLibrary'"
             Importance="low"
             Text="$(_AsmClassifiedSpec) is a static library linked into $(MSBuildProjectName): a private reference (PrivateAssets=&quot;all&quot;), no package dependency." />
    <ItemGroup>
      <_AsmClassifiedInfo Remove="@(_AsmClassifiedInfo)" />
    </ItemGroup>
  </Target>

  <!--
    GetAsmNativeRuntimeAssets: the shared library of every RID this build covers, each with
      RelativePath       runtimes/<rid>/native/<file>: where a portable .NET app keeps it by
                         default (a referencing project's BinariesCopyPath may choose another
                         place; see the consumer targets)
      RuntimeIdentifier  the RID, as deps.json's runtimeTargets name it
      AsmLibraryName,    the library's name and version in deps.json: the project's PackageId
      AsmLibraryVersion  and PackageVersion, the names NuGet's assets file gives this project
      AsmProject         this project file: which library a file belongs to
      AsmImportName      the name [DllImport] uses (AssemblyName: calc for calc.dll, libcalc.so)
    An inner build returns its own RID's library; the RID outer build asks each inner build.
    On Windows the PDB goes along when there is one, as .NET copies a referenced project's PDB.
    A program returns its bundle (_AsmComputeProgramBundle: the program, its PDB, the libraries
    and programs it needs), each file with AsmKind=Program and AsmBundlePath, its path relative
    to the program, which a consumer keeps under whatever folder it puts the program in (so the
    program's run paths keep finding its libraries). Nothing for a static library or object
    files: nothing a .NET app can load or start.
  -->
  <Target Name="GetAsmNativeRuntimeAssets" DependsOnTargets="_AsmComputeProgramBundle" Returns="@(_AsmNativeRuntimeAsset)">
    <PropertyGroup>
      <_AsmPdbPath Condition="'$(_AsmOs)' == 'Windows' and '$(AsmSharedLibraryPath)' != ''">$(TargetDir)$(TargetName).pdb</_AsmPdbPath>
      <_AsmNativeLibraryName>$([MSBuild]::ValueOrDefault('$(PackageId)', '$(AssemblyName)'))</_AsmNativeLibraryName>
      <_AsmNativeLibraryVersion>$([MSBuild]::ValueOrDefault('$(PackageVersion)', '$(Version)'))</_AsmNativeLibraryVersion>
    </PropertyGroup>
    <ItemGroup Condition="'$(_AsmRid)' != '' and '$(AsmSharedLibraryPath)' != ''">
      <_AsmNativeRuntimeAsset Include="$(AsmSharedLibraryPath)" RelativePath="runtimes/$(RuntimeIdentifier)/native/$(TargetFileName)" />
      <_AsmNativeRuntimeAsset Include="$(_AsmPdbPath)" Condition="'$(_AsmPdbPath)' != '' and Exists('$(_AsmPdbPath)')" RelativePath="runtimes/$(RuntimeIdentifier)/native/$(TargetName).pdb" AsmSymbols="true" />
    </ItemGroup>
    <ItemGroup Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' == 'Executable'">
      <_AsmNativeRuntimeAsset Include="@(_AsmProgramBundleFile)" RelativePath="runtimes/$(RuntimeIdentifier)/native/%(_AsmProgramBundleFile.AsmBundlePath)" AsmKind="Program" />
    </ItemGroup>
    <ItemGroup Condition="'$(_AsmRid)' != ''">
      <_AsmNativeRuntimeAsset RuntimeIdentifier="$(RuntimeIdentifier)" AsmLibraryName="$(_AsmNativeLibraryName)" AsmLibraryVersion="$(_AsmNativeLibraryVersion)" AsmProject="$(MSBuildProjectFullPath)" AsmImportName="$(AssemblyName)" />
    </ItemGroup>

    <!-- The RID outer build: each inner build, with the same global properties as the
         dispatch (_AsmInnerBuild in Build.targets: the RID, and an output folder per RID when
         the outer build's is shared), so MSBuild returns the results of the builds it already
         ran and the paths name the files those builds wrote. -->
    <ItemGroup Condition="'$(_AsmRid)' == ''">
      <_AsmRidQueryProject Include="$(MSBuildProjectFullPath)" Condition="'@(_AsmInnerBuild)' != ''">
        <AdditionalProperties>%(_AsmInnerBuild.AdditionalProperties)</AdditionalProperties>
      </_AsmRidQueryProject>
    </ItemGroup>
    <MSBuild Condition="'@(_AsmRidQueryProject)' != ''" Projects="@(_AsmRidQueryProject)" Targets="GetAsmNativeRuntimeAssets" BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmNativeRuntimeAsset" />
    </MSBuild>
  </Target>

  <!--
    GetCopyToOutputDirectoryItems: the shared library for a referencing .NET project to copy.
    Replaces the common target, which would look for managed content this project never has.
      Inner build (one RID): flat, next to the app's own files, so [DllImport("foo")] finds it in
        the app folder (foo.dll, libfoo.so or libfoo.dylib: the names of different OSes never
        collide, those of one OS's RIDs would).
      RID outer build: every RID's library under runtimes/<rid>/native/, the layout NuGet gives
        a package's native files; the consumer targets list them in deps.json.
    A program's files keep their paths relative to the program (AsmBundlePath) in an inner
    build, where a library goes flat.
  -->
  <Target Name="GetCopyToOutputDirectoryItems" DependsOnTargets="GetAsmNativeRuntimeAssets" Returns="@(_AsmCopyToOutputItem)">
    <ItemGroup>
      <_AsmCopyToOutputItem Include="@(_AsmNativeRuntimeAsset)">
        <TargetPath Condition="'$(_AsmRid)' != ''">%(Filename)%(Extension)</TargetPath>
        <TargetPath Condition="'$(_AsmRid)' != '' and '%(_AsmNativeRuntimeAsset.AsmBundlePath)' != ''">%(_AsmNativeRuntimeAsset.AsmBundlePath)</TargetPath>
        <TargetPath Condition="'$(_AsmRid)' == ''">%(RelativePath)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </_AsmCopyToOutputItem>
    </ItemGroup>
  </Target>

  <!-- The same for dotnet publish of a referencing project. -->
  <Target Name="GetCopyToPublishDirectoryItems" DependsOnTargets="GetAsmNativeRuntimeAssets" Returns="@(_AsmCopyToPublishItem)">
    <ItemGroup>
      <_AsmCopyToPublishItem Include="@(_AsmNativeRuntimeAsset)">
        <TargetPath Condition="'$(_AsmRid)' != ''">%(Filename)%(Extension)</TargetPath>
        <TargetPath Condition="'$(_AsmRid)' != '' and '%(_AsmNativeRuntimeAsset.AsmBundlePath)' != ''">%(_AsmNativeRuntimeAsset.AsmBundlePath)</TargetPath>
        <TargetPath Condition="'$(_AsmRid)' == ''">%(RelativePath)</TargetPath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </_AsmCopyToPublishItem>
    </ItemGroup>
  </Target>
</Project>
