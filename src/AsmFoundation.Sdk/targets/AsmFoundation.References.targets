<Project InitialTargets="_AsmDropGraphOnlyReferences">
  <!--
    AsmFoundation.References.targets - how .asmproj projects reference each other, and how a
    .csproj references an .asmproj. Imported after Microsoft.NET.Sdk's targets.

    asmproj -> asmproj (ProjectReference): the referencing project gets the referenced
      project's public include directories and links its static library (or its shared
      library, or its objects) - see GetAsmLinkInputs.
    csproj -> asmproj (ProjectReference): the asmproj is built first and its shared library is
      copied next to the managed output, ready for P/Invoke - see GetCopyToOutputDirectoryItems.
      No assembly reference is added (see GetTargetPathWithTargetPlatformMoniker). When the
      asmproj targets both freestanding and libc, NuGet's nearest-framework rule gives a .NET
      project the libc build (libc stands for netstandard2.0, freestanding for netstandard1.0;
      see AsmFoundation.Properties.targets).

    Which target framework of a referenced asmproj is used is NuGet's decision, exactly as for
    a .csproj: freestanding code links into libc projects, never the reverse (NU1201).
  -->

  <PropertyGroup>
    <!-- The folders a referencing project, or a package consumer, adds to its include path:
         include/ when the project has one, the project folder otherwise. -->
    <_AsmHasPublicIncludeFolder Condition="Exists('$(MSBuildProjectDirectory)/include')">true</_AsmHasPublicIncludeFolder>
  </PropertyGroup>
  <ItemGroup Condition="'@(AsmPublicIncludeDirectory)' == ''">
    <AsmPublicIncludeDirectory Include="$(MSBuildProjectDirectory)/include/" Condition="'$(_AsmHasPublicIncludeFolder)' == 'true'" />
    <AsmPublicIncludeDirectory Include="$(MSBuildProjectDirectory)/" Condition="'$(_AsmHasPublicIncludeFolder)' != 'true'" />
  </ItemGroup>

  <!--
    GetTargetPathWithTargetPlatformMoniker: returns nothing. The common targets return this
    item from Build and GetTargetPath, and a referencing .csproj would hand it to the assembly
    resolver as a reference; a .so or .a is not an assembly and would raise MSB3246.
  -->
  <Target Name="GetTargetPathWithTargetPlatformMoniker" Returns="@(TargetPathWithTargetPlatformMoniker)" />

  <!--
    GetAsmLinkInputs: what a referencing asmproj needs from this one, as items with
    AsmItemType metadata:
      IncludeDirectory - each public include directory;
      LinkInput        - the static library if one is produced (preferred: no run-time
                         dependency), else the shared library (on Windows its import library,
                         the file a PE program links against), else the object files.
    Called by _AsmResolveProjectReferences after ResolveProjectReferences has built us, in the
    referencing project's RID: an inner build of one RID asks for that RID's files (the RID
    reaches us because asm projects are not RID-agnostic; see Properties.targets).

    A shared link input also says what a program that links it needs at run time:
      AsmRuntimeFile     the shared library itself (.so, .dylib, .dll). On Windows the link input
                         is the import library (foo.dll.lib), so without this a referencing
                         program could not know which file to copy next to itself.
      AsmRuntimeSymbols  its PDB, when the link wrote one (Windows, debug information on).
    A referencing program copies them where its BinariesCopyPath says (AsmLayOutProgramDependencies
    in Build.targets). A static library has no run-time file: the program contains its code.

    A program links into nothing, but a referencing program can deliver it: its files come back
    as Program items (_AsmComputeProgramBundle below: the program, its PDB, and what it needs at
    run time, each with AsmBundlePath, its path relative to the program), which the referencing
    program copies where its BinariesCopyPath says, keeping their paths relative to each other.

    WebAssembly: a module cannot be linked against (wasm-ld has no shared libraries without
    PIC and a dynamic loader, which neither the browser nor WASI provide), so a wasm library's
    link input is its archive (a Library builds one by default; see AsmProduceStaticLibrary),
    and its objects when it has none. Every link input carries AsmImportName (AssemblyName): a
    .NET WebAssembly app names its P/Invoke module after it (the consumer targets), whatever
    the files are called.
  -->
  <!-- RID builds only: every caller asks a RID's build (an asm RID build, a NativeAOT or
       WebAssembly consumer's configured reference). A static graph build also asks the RID outer
       build, because the graph sends every reference the same targets; there it returns nothing,
       rather than preparing an assembly for no RID. -->
  <Target Name="GetAsmLinkInputs" DependsOnTargets="AsmPrepare;_AsmComputeProgramBundle" Returns="@(_AsmExportedLinkInput)" Condition="'$(_AsmRid)' != ''">
    <PropertyGroup>
      <_AsmSharedLinkInput Condition="'$(_AsmArch)' != 'wasm'">$(AsmSharedLibraryPath)</_AsmSharedLinkInput>
      <_AsmSharedLinkInput Condition="'$(AsmImportLibraryPath)' != ''">$(AsmImportLibraryPath)</_AsmSharedLinkInput>
      <!-- A wasm library whose archive was turned off (AsmProduceStaticLibrary=false) still has
           its objects to hand over. -->
      <_AsmObjectsAreLinkInput Condition="'$(_AsmOutputKind)' == 'Objects' or ('$(_AsmArch)' == 'wasm' and '$(_AsmOutputKind)' == 'SharedLibrary' and '$(AsmStaticLibraryPath)' == '')">true</_AsmObjectsAreLinkInput>
      <!-- Checked when a referencing project asks, after this project was built: the PDB exists
           only for a Windows link with debug information. -->
      <_AsmSharedLinkSymbols Condition="'$(_AsmOs)' == 'Windows' and '$(AsmSharedLibraryPath)' != '' and Exists('$(TargetDir)$(TargetName).pdb')">$(TargetDir)$(TargetName).pdb</_AsmSharedLinkSymbols>
    </PropertyGroup>
    <ItemGroup>
      <_AsmExportedLinkInput Include="@(AsmPublicIncludeDirectory->'%(FullPath)')" AsmItemType="IncludeDirectory" AsmOrigin="Project" AsmProject="$(MSBuildProjectName)" />
      <_AsmExportedLinkInput Include="$(AsmStaticLibraryPath)" Condition="'$(AsmStaticLibraryPath)' != ''" AsmItemType="LinkInput" AsmOrigin="Project" AsmProject="$(MSBuildProjectName)" AsmImportName="$(AssemblyName)" />
      <_AsmExportedLinkInput Include="$(_AsmSharedLinkInput)" Condition="'$(AsmStaticLibraryPath)' == '' and '$(_AsmSharedLinkInput)' != ''" AsmItemType="LinkInput" AsmOrigin="Project" AsmProject="$(MSBuildProjectName)" AsmImportName="$(AssemblyName)" AsmRuntimeFile="$(AsmSharedLibraryPath)" AsmRuntimeSymbols="$(_AsmSharedLinkSymbols)" />
      <!-- ObjectToolPath, the absolute path: ObjectFile is relative to THIS project's folder,
           and a referencing project would look for it in its own (the 0.1.0 and 0.2.0 bug:
           "cannot open <referencing project>/obj/.../x.o"). -->
      <_AsmExportedLinkInput Include="@(_AsmSelectedSource->'%(ObjectToolPath)')" Condition="'$(_AsmObjectsAreLinkInput)' == 'true'" AsmItemType="LinkInput" AsmOrigin="Project" AsmProject="$(MSBuildProjectName)" AsmImportName="$(AssemblyName)" />
      <_AsmExportedLinkInput Include="@(_AsmProgramBundleFile)" AsmItemType="Program" AsmOrigin="Project" AsmProject="$(MSBuildProjectName)" />
    </ItemGroup>
  </Target>

  <!--
    _AsmComputeProgramBundle: what a program (one RID) takes along to whatever references it,
    as _AsmProgramBundleFile items: the program, its PDB when the link wrote one, and every file
    _AsmResolveProgramDependencies put next to (or below) it, the copies in this program's own
    output folder. Each has AsmBundlePath (its path relative to the program, forward slashes),
    AsmProgramName (the program's file name) and, on a PDB, AsmSymbols=true. Keeping the paths
    relative to each other is what keeps the program's run paths valid wherever a consumer puts
    it. Data files (CopyToOutputDirectory) stay behind: they are the program's own business, and
    NuGet would flatten their folders for a consumer built for one RID.
    Nothing for anything but a program, and nothing in the RID outer build.
  -->
  <Target Name="_AsmComputeProgramBundle"
          Condition="'$(_AsmRid)' != '' and '$(_AsmOutputKind)' == 'Executable'"
          DependsOnTargets="_AsmResolveProgramDependencies">
    <PropertyGroup>
      <_AsmProgramPdb Condition="'$(_AsmOs)' == 'Windows' and Exists('$(TargetDir)$(TargetName).pdb')">$(TargetDir)$(TargetName).pdb</_AsmProgramPdb>
    </PropertyGroup>
    <ItemGroup>
      <_AsmProgramBundleFile Include="$(TargetPath)" AsmBundlePath="$(TargetFileName)" />
      <_AsmProgramBundleFile Include="$(_AsmProgramPdb)" Condition="'$(_AsmProgramPdb)' != ''" AsmBundlePath="$(TargetName).pdb" AsmSymbols="true" />
      <!-- One item per dependency (batched on its TargetPath, the place it got here); the
           condition keeps an empty list from adding a bare folder (batching over nothing still
           runs once). -->
      <_AsmProgramBundleFile Include="$(TargetDir)%(_AsmProgramDependency.TargetPath)" Condition="'@(_AsmProgramDependency)' != ''" AsmBundlePath="%(_AsmProgramDependency.TargetPath)" AsmSymbols="%(_AsmProgramDependency.AsmSymbols)" />
      <_AsmProgramBundleFile AsmProgramName="$(TargetFileName)" />
    </ItemGroup>
  </Target>

  <!--
    _AsmSkipAsmReferencesInRidOuterBuild: the RID outer build links nothing, so it visits no
    referenced .asmproj; each inner build resolves them for its own RID. Build already skips
    reference resolution there (see BuildDependsOn in Build.targets), but other entry points
    still run ResolveReferences in the outer build, NuGet's pack among them
    (_GetFrameworkAssemblyReferences): it built each referenced asm project with no RID, which
    stopped a reference that names none with ASM0010 (measured). The references stay
    ProjectReference items, so pack still turns them into package dependencies.
  -->
  <Target Name="_AsmSkipAsmReferencesInRidOuterBuild" AfterTargets="_SplitProjectReferencesByFileExistence" Condition="'$(_AsmRid)' == ''">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Remove="@(_MSBuildProjectReferenceExistent)" Condition="'%(Extension)' == '.asmproj'" />
    </ItemGroup>
  </Target>

  <!--
    _AsmPassRuntimeIdentifierToAsmReferences: a RID build hands its RID to every referenced
    .asmproj, as AdditionalProperties metadata, which the MSBuild task applies to each project it
    calls: .NET's own ResolveProjectReferences and _AsmResolveProjectReferences below both take
    the referenced project from these items.
    Why: a referenced .asmproj builds the RID its caller's global properties name. An inner build
    of a RID outer build, and dotnet build -r, have RuntimeIdentifier as a global property, which
    the reference inherits; a project that names its one RID itself (<RuntimeIdentifier> in the
    project, a publish profile's, or the use-current-runtime switch's) has it as an ordinary
    property, which no reference sees. Its references were then built for their own default
    RIDs, and a program linked nothing of them (measured: a linux-x64 program referencing a
    static library failed with "undefined symbol: mul_ints", the library built for win-x64 only;
    a publish also warned ASM0013 for the library). When the RID is global, the value passed is
    the same one, so MSBuild finds the same project instance and builds nothing twice.
    After _GetProjectReferenceTargetFrameworkProperties, which sets the items' framework
    metadata last before ResolveProjectReferences.
  -->
  <Target Name="_AsmPassRuntimeIdentifierToAsmReferences"
          AfterTargets="_GetProjectReferenceTargetFrameworkProperties"
          Condition="'$(_AsmRid)' != '' and '@(_MSBuildProjectReferenceExistent)' != ''">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Condition="'%(_MSBuildProjectReferenceExistent.Extension)' == '.asmproj' and '%(_MSBuildProjectReferenceExistent.AdditionalProperties)' == ''">
        <AdditionalProperties>RuntimeIdentifier=$(RuntimeIdentifier)</AdditionalProperties>
      </_MSBuildProjectReferenceExistent>
      <_MSBuildProjectReferenceExistent Condition="'%(_MSBuildProjectReferenceExistent.Extension)' == '.asmproj' and '%(_MSBuildProjectReferenceExistent.AdditionalProperties)' != '' and !$([System.String]::Copy('%(_MSBuildProjectReferenceExistent.AdditionalProperties)').Contains('RuntimeIdentifier='))">
        <AdditionalProperties>%(_MSBuildProjectReferenceExistent.AdditionalProperties);RuntimeIdentifier=$(RuntimeIdentifier)</AdditionalProperties>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>

  <!--
    _AsmResolveProjectReferences: collects GetAsmLinkInputs from every referenced .asmproj and
    adds them to this project's AsmIncludeDirectory and NativeLibrary items (NativeAOT's name for
    link inputs; AsmLinkLibrary until 0.3.0). ProjectReference
    items to anything else (for example a .csproj holding a generator) are left alone.

    The referenced project is called exactly as ResolveProjectReferences calls it, so the
    MSBuild engine reuses that build instead of starting another one:
      - SetTargetFramework is NuGet's choice of the referenced project's target framework
        (the nearest to ours: a libc project referencing a freestanding;libc project gets
        libc). It is set only when the referenced project multi-targets.
      - UndefineProperties (item metadata, which the MSBuild task honors) removes our own
        global TargetFramework when the referenced project has a single one. Without it, the
        libc inner build of a multi-targeted project would build a freestanding-only
        reference as libc.
      - RemoveProperties drops the global properties the common targets drop.
  -->
  <Target Name="_AsmResolveProjectReferences" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_AsmReferencedProject Include="@(_MSBuildProjectReferenceExistent)" Condition="'%(Extension)' == '.asmproj'" />
    </ItemGroup>
    <MSBuild Projects="@(_AsmReferencedProject)"
             Targets="GetAsmLinkInputs"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_AsmReferencedProject.SetConfiguration);%(_AsmReferencedProject.SetPlatform);%(_AsmReferencedProject.SetTargetFramework)"
             RemoveProperties="%(_AsmReferencedProject.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'@(_AsmReferencedProject)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmReferencedOutput" />
    </MSBuild>
    <ItemGroup>
      <AsmIncludeDirectory Include="@(_AsmReferencedOutput)" Condition="'%(_AsmReferencedOutput.AsmItemType)' == 'IncludeDirectory'" />
      <NativeLibrary Include="@(_AsmReferencedOutput)" Condition="'%(_AsmReferencedOutput.AsmItemType)' == 'LinkInput'" />
      <!-- A referenced program's files: a program delivers them (_AsmResolveProgramDependencies);
           anything else ignores them. -->
      <AsmReferencedProgram Include="@(_AsmReferencedOutput)" Condition="'%(_AsmReferencedOutput.AsmItemType)' == 'Program'" />
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- .NET projects that reference this one                                                  -->
  <!-- ===================================================================================== -->

  <!--
    A .NET project that references an .asmproj gets the native library of the RID it runs on,
    the way a PackageReference gets a package's runtimes/ folder. The work is shared between
    this file (what the asm project offers) and the consumer targets in the SDK package's
    buildTransitive/ folder (what the .NET project does with it), which reach the .NET project
    through the implicit AsmFoundation.Sdk PackageReference of every .asmproj (see
    Properties.targets):
      RID-specific .NET build (-r linux-arm64, a RuntimeIdentifier in the .csproj): the consumer
        targets ask GetAsmRuntimeIdentifiers what this project builds, pick the best RID for
        theirs by NuGet's fallback order, and build that RID here; GetCopyToOutputDirectoryItems
        of that inner build hands over the library, flat, next to the app.
      Portable .NET build (no RuntimeIdentifier): this project's RID outer build builds every RID
        it lists (or the ProjectReference's RuntimeIdentifiers metadata asks for);
        GetCopyToOutputDirectoryItems hands over each RID's library as
        runtimes/<rid>/native/<file>, and the consumer targets add them to the app's deps.json
        (GetAsmNativeRuntimeAssets), so the .NET host loads the one for the machine it runs on.
  -->

  <!--
    GetAsmRuntimeIdentifiers: the RIDs this project declares, empty when it declares none (it
    then builds whatever RID it is asked for). The caller removes its own global
    RuntimeIdentifier first: a lone RuntimeIdentifier counts as the declared list, and the
    caller's must not be mistaken for it.
  -->
  <Target Name="GetAsmRuntimeIdentifiers" Returns="@(_AsmDeclaredRuntimeIdentifier)">
    <ItemGroup>
      <_AsmDeclaredRuntimeIdentifier Include="$(_AsmDeclaredRuntimeIdentifiers)" />
    </ItemGroup>
  </Target>

  <!--
    GetAsmConsumerInfo: what a referencing .NET project needs to know before it builds this
    project, as one item (the project file) with metadata:
      AsmOutputKind        SharedLibrary, StaticLibrary, Executable or Objects; a .NET app loads
                           a shared library and starts a program (Executable), and gets both;
                           a static library or object files are for asm projects to link
      RuntimeIdentifiers   the declared RIDs (as GetAsmRuntimeIdentifiers), ";"-separated
      AsmImportName        the library's name without "lib" or an extension (its AssemblyName):
                           the name [DllImport] uses, which the generated loader looks for
    The caller removes its own global RuntimeIdentifier first, as for GetAsmRuntimeIdentifiers.
  -->
  <Target Name="GetAsmConsumerInfo" Returns="@(_AsmConsumerInfo)">
    <ItemGroup>
      <_AsmConsumerInfo Include="$(MSBuildProjectFullPath)" AsmOutputKind="$(_AsmOutputKind)" RuntimeIdentifiers="$(_AsmDeclaredRuntimeIdentifiers)" AsmImportName="$(AssemblyName)" OptionalOnUnlistedRuntimes="$(OptionalOnUnlistedRuntimes)" />
    </ItemGroup>
  </Target>

  <!--
    _AsmMakeStaticLibraryReferencesPrivate: a shared library's references to static libraries
    are private by default (PrivateAssets="all"), as every reference of a program already is
    (the ItemDefinitionGroup in Properties.targets). The static library's code is linked INTO
    the shared library, so neither the shared library's package nor the projects that
    reference it need the static library. Before, NuGet made it a dependency of the package
    (its consumers failed with NU1101, the static library having no package of its own) and a
    transitive reference of every project that references the shared library.

    When: before NuGet reads the references for its restore graph
    (_GenerateProjectRestoreGraphPerFramework); dotnet pack takes a package's dependencies from
    the assets file that restore writes, and the .NET SDK its transitive project references, so
    both follow. A restore that does not run MSBuild's restore targets (one that reads only the
    evaluated project) does not see this: write PrivateAssets="all" yourself for such a tool.

    Which references: an .asmproj reference that sets no PrivateAssets, and whose project says
    it is a StaticLibrary (GetAsmConsumerInfo: its own evaluation decides, not a guess from its
    file). PrivateAssets="none" keeps a static library a dependency, for a package that ships it
    too. Not in a shared library that also produces a static library (AsmProduceStaticLibrary):
    a program that links that one statically still needs the static libraries it links; nor in
    a static library or object files, whose users link what they link.
  -->
  <Target Name="_AsmMakeStaticLibraryReferencesPrivate"
          BeforeTargets="_GenerateProjectRestoreGraphPerFramework"
          DependsOnTargets="_AsmFindReferencesToClassify;_AsmClassifyEachReference"
          Condition="'$(_AsmOutputKind)' == 'SharedLibrary' and '$(AsmProduceStaticLibrary)' != 'true'" />

  <Target Name="_AsmFindReferencesToClassify">
    <ItemGroup>
      <_AsmReferenceToClassify Include="@(ProjectReference)" Condition="'%(Extension)' == '.asmproj' and '%(ProjectReference.PrivateAssets)' == ''" />
    </ItemGroup>
  </Target>

  <!-- One batch per reference, conditioned on there being one: batching over an empty list still
       runs a target once (see the consumer targets). -->
  <Target Name="_AsmClassifyEachReference" Outputs="%(_AsmReferenceToClassify.Identity)" Condition="'@(_AsmReferenceToClassify)' != ''">
    <!-- Properties keep their values from one batch to the next: each one is set here. The
         batch's one item, as written in the project (its Include): the ProjectReference to
         update has exactly that identity. -->
    <PropertyGroup>
      <_AsmClassifiedSpec>@(_AsmReferenceToClassify)</_AsmClassifiedSpec>
      <_AsmClassifiedKind />
    </PropertyGroup>
    <!-- Asked as the consumer targets ask (GetAsmConsumerInfo needs no build), without this
         project's RuntimeIdentifier and TargetFramework: a restore passes them as global
         properties, and the referenced project may build another target framework. -->
    <MSBuild Projects="@(_AsmReferenceToClassify)"
             Targets="GetAsmConsumerInfo"
             RemoveProperties="RuntimeIdentifier;TargetFramework;%(_AsmReferenceToClassify.GlobalPropertiesToRemove)">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmClassifiedInfo" />
    </MSBuild>
    <PropertyGroup>
      <_AsmClassifiedKind>@(_AsmClassifiedInfo->'%(AsmOutputKind)')</_AsmClassifiedKind>
    </PropertyGroup>
    <!-- An item element without Include, inside a target, sets metadata on the existing items
         its condition selects: here the one reference of this batch. -->
    <ItemGroup Condition="'$(_AsmClassifiedKind)' == 'StaticLibrary'">
      <ProjectReference Condition="'%(ProjectReference.Identity)' == '$(_AsmClassifiedSpec)'">
        <PrivateAssets>all</PrivateAssets>
      </ProjectReference>
    </ItemGroup>
    <Message Condition="'$(_AsmClassifiedKind)' == 'StaticLibrary'"
             Importance="low"
             Text="$(_AsmClassifiedSpec) is a static library linked into $(MSBuildProjectName): a private reference (PrivateAssets=&quot;all&quot;), no package dependency." />
    <ItemGroup>
      <_AsmClassifiedInfo Remove="@(_AsmClassifiedInfo)" />
    </ItemGroup>
  </Target>

  <!--
    GetAsmNativeRuntimeAssets: the shared library of every RID this build covers, each with
      RelativePath       runtimes/<rid>/native/<file>: where a portable .NET app keeps it by
                         default (a referencing project's BinariesCopyPath may choose another
                         place; see the consumer targets)
      RuntimeIdentifier  the RID, as deps.json's runtimeTargets name it
      AsmLibraryName,    the library's name and version in deps.json: the project's PackageId
      AsmLibraryVersion  and PackageVersion, the names NuGet's assets file gives this project
      AsmProject         this project file: which library a file belongs to
      AsmImportName      the name [DllImport] uses (AssemblyName: calc for calc.dll, libcalc.so)
    An inner build returns its own RID's library; the RID outer build asks each inner build.
    On Windows the PDB goes along when there is one, as .NET copies a referenced project's PDB.
    A program returns its bundle (_AsmComputeProgramBundle: the program, its PDB, the libraries
    and programs it needs), each file with AsmKind=Program and AsmBundlePath, its path relative
    to the program, which a consumer keeps under whatever folder it puts the program in (so the
    program's run paths keep finding its libraries). Nothing for a static library or object
    files: nothing a .NET app can load or start. Nothing for WebAssembly either: a .NET app
    cannot load a wasm module or start a WASI program, and a .NET WebAssembly app links the
    library's archive instead (GetAsmLinkInputs, through the consumer targets), so a portable
    .NET app that references a project which also lists browser-wasm copies no .wasm file.
  -->
  <Target Name="GetAsmNativeRuntimeAssets" DependsOnTargets="_AsmComputeProgramBundle" Returns="@(_AsmNativeRuntimeAsset)">
    <PropertyGroup>
      <_AsmPdbPath Condition="'$(_AsmOs)' == 'Windows' and '$(AsmSharedLibraryPath)' != ''">$(TargetDir)$(TargetName).pdb</_AsmPdbPath>
      <_AsmNativeLibraryName>$([MSBuild]::ValueOrDefault('$(PackageId)', '$(AssemblyName)'))</_AsmNativeLibraryName>
      <_AsmNativeLibraryVersion>$([MSBuild]::ValueOrDefault('$(PackageVersion)', '$(Version)'))</_AsmNativeLibraryVersion>
    </PropertyGroup>
    <ItemGroup Condition="'$(_AsmRid)' != '' and '$(_AsmArch)' != 'wasm' and '$(AsmSharedLibraryPath)' != ''">
      <_AsmNativeRuntimeAsset Include="$(AsmSharedLibraryPath)" RelativePath="runtimes/$(RuntimeIdentifier)/native/$(TargetFileName)" />
      <_AsmNativeRuntimeAsset Include="$(_AsmPdbPath)" Condition="'$(_AsmPdbPath)' != '' and Exists('$(_AsmPdbPath)')" RelativePath="runtimes/$(RuntimeIdentifier)/native/$(TargetName).pdb" AsmSymbols="true" />
    </ItemGroup>
    <ItemGroup Condition="'$(_AsmRid)' != '' and '$(_AsmArch)' != 'wasm' and '$(_AsmOutputKind)' == 'Executable'">
      <_AsmNativeRuntimeAsset Include="@(_AsmProgramBundleFile)" RelativePath="runtimes/$(RuntimeIdentifier)/native/%(_AsmProgramBundleFile.AsmBundlePath)" AsmKind="Program" />
    </ItemGroup>
    <ItemGroup Condition="'$(_AsmRid)' != ''">
      <_AsmNativeRuntimeAsset RuntimeIdentifier="$(RuntimeIdentifier)" AsmLibraryName="$(_AsmNativeLibraryName)" AsmLibraryVersion="$(_AsmNativeLibraryVersion)" AsmProject="$(MSBuildProjectFullPath)" AsmImportName="$(AssemblyName)" />
    </ItemGroup>

    <!-- The RID outer build: each inner build, with the same global properties as the
         dispatch (_AsmInnerBuild in Build.targets: the RID, and an output folder per RID when
         the outer build's is shared), so MSBuild returns the results of the builds it already
         ran and the paths name the files those builds wrote. -->
    <ItemGroup Condition="'$(_AsmRid)' == ''">
      <_AsmRidQueryProject Include="$(MSBuildProjectFullPath)" Condition="'@(_AsmInnerBuild)' != ''">
        <AdditionalProperties>%(_AsmInnerBuild.AdditionalProperties)</AdditionalProperties>
      </_AsmRidQueryProject>
    </ItemGroup>
    <MSBuild Condition="'@(_AsmRidQueryProject)' != ''" Projects="@(_AsmRidQueryProject)" Targets="GetAsmNativeRuntimeAssets" BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmNativeRuntimeAsset" />
    </MSBuild>
  </Target>

  <!--
    GetCopyToOutputDirectoryItems: the shared library for a referencing .NET project to copy.
    Replaces the common target, which would look for managed content this project never has.
      Inner build (one RID): flat, next to the app's own files, so [DllImport("foo")] finds it in
        the app folder (foo.dll, libfoo.so or libfoo.dylib: the names of different OSes never
        collide, those of one OS's RIDs would).
      RID outer build: every RID's library under runtimes/<rid>/native/, the layout NuGet gives
        a package's native files; the consumer targets list them in deps.json.
    A program's files keep their paths relative to the program (AsmBundlePath) in an inner
    build, where a library goes flat.
  -->
  <Target Name="GetCopyToOutputDirectoryItems" DependsOnTargets="GetAsmNativeRuntimeAssets" Returns="@(_AsmCopyToOutputItem)">
    <ItemGroup>
      <_AsmCopyToOutputItem Include="@(_AsmNativeRuntimeAsset)">
        <TargetPath Condition="'$(_AsmRid)' != ''">%(Filename)%(Extension)</TargetPath>
        <TargetPath Condition="'$(_AsmRid)' != '' and '%(_AsmNativeRuntimeAsset.AsmBundlePath)' != ''">%(_AsmNativeRuntimeAsset.AsmBundlePath)</TargetPath>
        <TargetPath Condition="'$(_AsmRid)' == ''">%(RelativePath)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </_AsmCopyToOutputItem>
    </ItemGroup>
  </Target>

  <!-- The same for dotnet publish of a referencing project. -->
  <Target Name="GetCopyToPublishDirectoryItems" DependsOnTargets="GetAsmNativeRuntimeAssets" Returns="@(_AsmCopyToPublishItem)">
    <ItemGroup>
      <_AsmCopyToPublishItem Include="@(_AsmNativeRuntimeAsset)">
        <TargetPath Condition="'$(_AsmRid)' != ''">%(Filename)%(Extension)</TargetPath>
        <TargetPath Condition="'$(_AsmRid)' != '' and '%(_AsmNativeRuntimeAsset.AsmBundlePath)' != ''">%(_AsmNativeRuntimeAsset.AsmBundlePath)</TargetPath>
        <TargetPath Condition="'$(_AsmRid)' == ''">%(RelativePath)</TargetPath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </_AsmCopyToPublishItem>
    </ItemGroup>
  </Target>

  <!-- ===================================================================================== -->
  <!-- Static graph builds: dotnet build -graph, and -graph -isolate                          -->
  <!-- ===================================================================================== -->

  <!--
    MSBuild's static graph (dotnet build -graph) builds every project instance (a project file
    with its global properties) that the ProjectReference items predict, bottom up, before the
    projects that reference it. With -isolate, a project may then call only the instances the
    graph built, and only with the targets that ProjectReferenceTargets items declare; any other
    call fails with MSB4252 (MSBuild's documentation/specs/static-graph.md). The graph reads both
    when it evaluates the projects, never what targets do later: a reference's global properties
    come from the item's AdditionalProperties, GlobalPropertiesToRemove and UndefineProperties
    metadata, as the MSBuild task would apply them (ProjectInterpretation.cs).
    What an asm project adds, in graph builds only (_AsmGraphBuild: IsGraphBuild, which the graph
    sets as a global property on every node, in a build that is not a design-time build), so
    that every other build stays exactly as it was (the owner's choice of 2026-11-26: support
    -graph -isolate), but for InnerBuildProperty, which only the graph reads:
      - its framework builds as graph inner builds (InnerBuildProperty, as Microsoft.NET.Sdk
        declares it for C#), so a freestanding;libc project's frameworks are graph nodes; 0.4.0
        declared none, and -graph alone failed for a project referencing such a project (the
        graph sent the outer build a framework build's targets: MSB4057 for GetNativeManifest);
      - the targets an asm project calls on the projects it references, besides the common ones,
        for Build, Rebuild and Publish (C# gets Publish's from Microsoft.Managed.After.targets,
        which an asm project does not import), and the common ones for Build, Clean and Rebuild
        too, which the .NET 10.0.1xx SDKs' MSBuild declares in that file alone;
      - its .asmproj references without the RID builds' folders and the publish switch
        (_AsmGraphReferencePropertiesToRemove), so every view of a reference is one instance;
      - its RID inner builds as graph nodes: the RID outer build references itself once per RID,
        with the global properties its dispatch uses (_AsmInnerBuild), so the graph builds each
        RID first and the dispatch finds it built; and the instances a RID build calls, which
        inherit the RID (a program's static library of that RID), become graph nodes in turn.
        A self-build alone was exempt from isolation, but its calls were not (measured:
        MSB4252 for GetNativeManifest on a program's static library);
      - a RID build's RID on its .asmproj references at evaluation, as
        _AsmPassRuntimeIdentifierToAsmReferences adds it when it runs: for a project that names
        its one RuntimeIdentifier itself, whose RID no reference inherits;
      - in a RID build, a twin of each .asmproj reference without the RID, for the one call that
        removes it, the common targets' GetTargetFrameworks: the graph builds that instance
        before this one only if an edge from this node says so (measured: MSB4252 for
        GetTargetFrameworks on the static library, once the RID builds were nodes);
      - on the edges that need no build (the twins, the RID outer build's own references, which
        only its RID builds build), GetTargetFrameworks as the main target.
    The graph-only references (_AsmGraphOnly) are removed before any target runs
    (_AsmDropGraphOnlyReferences). .NET's own limit applies too: a build with a global
    RuntimeIdentifier (dotnet build -r) fails -isolate for a C# reference, C# projects alone
    included, at that same GetTargetFrameworks call (measured with SDK 11.0.100); asm references
    pass through the twins.
  -->
  <!-- Not in a design-time build: dotnet watch loads a static graph too (IsGraphBuild on every
       node), with DesignTimeBuild=true, to find the files it watches, and builds nothing under
       -isolate. The .NET 10 SDK's dotnet watch keys that graph's nodes by project and framework,
       and it stopped with "An item with the same key has already been added. Key:
       ProjectInstanceId" at the RID builds the RID outer build references, the same project and
       framework (measured with SDK 10.0.404); the .NET 11 SDK's ignores each such instance with
       a warning, "Ignoring project instance ... because another one already exists and only
       differs in the values of global properties" (LoadedProjectGraph.cs at sdk-11.0.100-rtm;
       WatchTests fails on it). A design-time graph keeps the nodes 0.4.0 gave it, but for the
       framework builds (InnerBuildProperty), as a multi-targeted C# project has them. -->
  <!-- _AsmGraphBuild: these additions apply (true) or not (empty). Set at evaluation, before any
       of the conditions below reads it; a property of its own so that the reason above is in
       one place. -->
  <PropertyGroup>
    <_AsmGraphBuild Condition="'$(IsGraphBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">true</_AsmGraphBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_AsmGraphBuild)' == 'true'">
    <!-- The main reference target, as the common targets compute it (_MainReferenceTargetForBuild,
         _MainReferenceTargetForPublish): the graph's marker for a reference's default targets (a
         build), or GetTargetPath when the build is told not to build references
         (BuildProjectReferences=false) and when a publish builds nothing (NoBuild). Computed
         here, under names of the SDK's own, because the MSBuild of the .NET 10.0.1xx SDKs
         defines those in Microsoft.Managed.After.targets, which an asm project does not
         import (measured with SDK 10.0.101, MSBuild 18.0.6). -->
    <_AsmMainReferenceTargetForBuild Condition="'$(BuildProjectReferences)' == '' or '$(BuildProjectReferences)' == 'true'">.projectReferenceTargetsOrDefaultTargets</_AsmMainReferenceTargetForBuild>
    <_AsmMainReferenceTargetForBuild Condition="'$(_AsmMainReferenceTargetForBuild)' == ''">GetTargetPath</_AsmMainReferenceTargetForBuild>
    <_AsmMainReferenceTargetForPublish Condition="'$(NoBuild)' == 'true'">GetTargetPath</_AsmMainReferenceTargetForPublish>
    <_AsmMainReferenceTargetForPublish Condition="'$(NoBuild)' != 'true'">$(_AsmMainReferenceTargetForBuild)</_AsmMainReferenceTargetForPublish>
    <!-- What a graph build's .asmproj references do not inherit: the folders a RID build gets
         per RID (OutputPath, OutDir, PublishDir: _AsmInnerBuild) and the publish switch. The
         graph adds transitive edges to every project with UsingMicrosoftNETSdk (asm projects
         too: ProjectInterpretation.RequiresTransitiveProjectReferences), which ask for a build;
         a reference seen with one RID build's folders was a project instance of its own, whose
         RID builds the graph then built a second time, into folders such as
         publish/linux-x64/win-x64/, racing the real instance's files and warning ASM0013
         (measured with dotnet publish -graph). Without them, every view of a reference is the
         same instance. A reference builds the same files either way, into its own bin/, as a .NET
         project's asm references already do (the consumer targets remove the same). -->
    <_AsmGraphReferencePropertiesToRemove>_IsPublishing;PublishDir;OutputPath;OutDir;_CommandLineDefinedOutputPath</_AsmGraphReferencePropertiesToRemove>
  </PropertyGroup>
  <PropertyGroup>
    <InnerBuildProperty Condition="'$(InnerBuildProperty)' == ''">TargetFramework</InnerBuildProperty>
    <InnerBuildPropertyValues Condition="'$(InnerBuildPropertyValues)' == ''">TargetFrameworks</InnerBuildPropertyValues>
  </PropertyGroup>

  <!--
    The common targets' own lists for Build, Clean and Rebuild, declared here too, before the asm
    targets below. Where MSBuild declares them moved: the .NET 10.0.1xx SDKs' MSBuild (18.0.6,
    measured with SDK 10.0.101) declares them in Microsoft.Managed.After.targets, which an asm
    project does not import, and nothing in Microsoft.Common.CrossTargeting.targets; later ones
    (SDK 10.0.404 and 11.0.100) in Microsoft.Common.CurrentVersion.targets and
    Microsoft.Common.CrossTargeting.targets, which it does. With 10.0.101 an asm project therefore
    declared no GetTargetFrameworks at all, and -isolate stopped at a program's first call into
    its static library ("called with the (GetTargetFrameworks) target(s) but the build result
    ... is not in the engine cache"). Declared on every MSBuild: where the common targets declare
    them too, a node's list names those targets twice, and MSBuild runs a target once per
    instance and build (the consumer's Publish list has done so since -isolate support). The
    order matters: the graph runs a node's targets in the order of these items, so a reference
    is built before the asm targets below ask it for its outputs. Single-framework builds as
    Microsoft.Common.CurrentVersion.targets declares them; the outer build of a multi-targeted
    project (freestanding;libc) as Microsoft.Common.CrossTargeting.targets does (".default": the
    framework builds' own default targets).
  -->
  <ItemGroup Condition="'$(_AsmGraphBuild)' == 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <ProjectReferenceTargets Include="Build" Targets="GetTargetFrameworks" OuterBuild="true" SkipNonexistentTargets="true" />
    <ProjectReferenceTargets Include="Build" Targets="$(_AsmMainReferenceTargetForBuild);GetNativeManifest;$(_RecursiveTargetForContentCopying)" />
    <ProjectReferenceTargets Include="Build" Targets="GetTargetFrameworksWithPlatformForSingleTargetFramework" SkipNonexistentTargets="true" />
    <ProjectReferenceTargets Include="Clean" Targets="GetTargetFrameworks" OuterBuild="true" SkipNonexistentTargets="true" />
    <ProjectReferenceTargets Include="Clean" Targets="Clean" />
    <ProjectReferenceTargets Include="Clean" Targets="GetTargetFrameworksWithPlatformForSingleTargetFramework" SkipNonexistentTargets="true" />
    <ProjectReferenceTargets Include="Rebuild" Targets="Clean;$(_AsmMainReferenceTargetForBuild);GetNativeManifest;$(_RecursiveTargetForContentCopying)" />
    <ProjectReferenceTargets Include="Rebuild" Targets="GetTargetFrameworksWithPlatformForSingleTargetFramework" SkipNonexistentTargets="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(_AsmGraphBuild)' == 'true' and '$(IsCrossTargetingBuild)' == 'true'">
    <ProjectReferenceTargets Include="Build" Targets=".default" />
    <ProjectReferenceTargets Include="Clean" Targets="Clean" />
    <ProjectReferenceTargets Include="Rebuild" Targets="Clean;.default" />
  </ItemGroup>

  <!-- The asm targets called on references: GetAsmLinkInputs (_AsmResolveProjectReferences,
       _AsmComputeProgramBundle) and GetAsmConsumerInfo (the reference classification). Skipped
       on a reference that does not have them (the graph asks every reference). -->
  <ItemGroup Condition="'$(_AsmGraphBuild)' == 'true'">
    <ProjectReferenceTargets Include="Build" Targets="GetAsmLinkInputs;GetAsmConsumerInfo" SkipNonexistentTargets="true" />
    <ProjectReferenceTargets Include="Rebuild" Targets="GetAsmLinkInputs;GetAsmConsumerInfo" SkipNonexistentTargets="true" />
    <!-- The common targets declare GetTargetFrameworks for Build and Clean but not for Rebuild,
         which negotiates frameworks too: -isolate failed every rebuild with references, C# alone
         included (measured with SDK 11.0.100). Declared as they declare it for Build. -->
    <ProjectReferenceTargets Include="Rebuild" Targets="GetTargetFrameworks" OuterBuild="true" SkipNonexistentTargets="true" />
    <!-- Publish: Microsoft.Managed.After.targets declares it for C#, and an asm project does not
         import that file, so a publish asked its references for nothing and -isolate failed
         (measured). The same list (GetTargetPath instead of a build with NoBuild), then the asm
         targets, in that order: the graph runs them in the order of these items. -->
    <ProjectReferenceTargets Include="Publish" Targets="GetTargetFrameworks;$(_AsmMainReferenceTargetForPublish);GetNativeManifest;GetCopyToPublishDirectoryItems" />
    <ProjectReferenceTargets Include="Publish" Targets="GetAsmLinkInputs;GetAsmConsumerInfo" SkipNonexistentTargets="true" />
    <!-- A multi-targeted reference's outer build gets only the targets marked OuterBuild, and its
         framework negotiation calls it (measured: MSB4252 for GetTargetFrameworks on a
         freestanding;libc static library in a publish). As the common targets mark it for Build. -->
    <ProjectReferenceTargets Include="Publish" Targets="GetTargetFrameworks" OuterBuild="true" SkipNonexistentTargets="true" />
  </ItemGroup>

  <!-- Every .asmproj reference of a graph build, before the graph-only references below are
       added (they keep their properties: they are this project's own RID builds).
       _AsmGraphPrepared marks the references prepared here, at evaluation, for
       _AsmPrepareTransitiveGraphReferences, which prepares those the build adds later. -->
  <ItemGroup Condition="'$(_AsmGraphBuild)' == 'true'">
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Extension', '.asmproj'))">
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);$(_AsmGraphReferencePropertiesToRemove)</GlobalPropertiesToRemove>
      <_AsmGraphPrepared>true</_AsmGraphPrepared>
    </ProjectReference>
  </ItemGroup>

  <!-- The RID outer build's edges to its own RID builds: one ProjectReference to this project
       per _AsmInnerBuild item, which keeps its AdditionalProperties (a transform keeps the
       source item's metadata). Only in a build with a framework: a freestanding;libc project's
       framework builds are the RID outer builds. _AsmGraphOnly marks them for
       _AsmDropGraphOnlyReferences (metadata elements: an attribute may not start with an
       underscore, MSB4066). In a dotnet publish (_IsPublishing) the outer build publishes each
       RID (_AsmPublishEachRuntimeIdentifier), so the edge asks for Publish: Targets replaces the
       main reference target of the edge's list (the graph's default-targets marker). -->
  <ItemGroup Condition="'$(_AsmGraphBuild)' == 'true' and '$(_AsmRid)' == '' and '$(TargetFramework)' != ''">
    <ProjectReference Include="@(_AsmInnerBuild->'$(MSBuildProjectFullPath)')">
      <_AsmGraphOnly>true</_AsmGraphOnly>
      <Targets Condition="'$(_IsPublishing)' == 'true'">Publish</Targets>
      <Private>false</Private>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- A RID build: each .asmproj reference's twin without the RID (for GetTargetFrameworks),
       taken before the RID is added below; then the RID on the reference itself, so the graph
       predicts the instance the build calls (the same value as a global RID: no other
       instance). GlobalPropertiesToRemove removes what the call removes; the graph removes it
       after adding AdditionalProperties, as the MSBuild task does. The twin's Targets makes
       GetTargetFrameworks its main target instead of a build (Targets replaces the edge's
       default-targets marker): a RID build never builds its reference without a RID, and built
       there in a publish, a reference that lists no RIDs warned ASM0013 as if it were
       published itself (measured with dotnet publish -graph). -->
  <ItemGroup Condition="'$(_AsmGraphBuild)' == 'true' and '$(_AsmRid)' != ''">
    <_AsmGraphRidlessTwin Include="@(ProjectReference->WithMetadataValue('Extension', '.asmproj'))" />
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Extension', '.asmproj'))">
      <AdditionalProperties Condition="'%(ProjectReference.AdditionalProperties)' == ''">RuntimeIdentifier=$(RuntimeIdentifier)</AdditionalProperties>
      <AdditionalProperties Condition="'%(ProjectReference.AdditionalProperties)' != '' and !$([System.String]::Copy('%(ProjectReference.AdditionalProperties)').Contains('RuntimeIdentifier='))">%(ProjectReference.AdditionalProperties);RuntimeIdentifier=$(RuntimeIdentifier)</AdditionalProperties>
    </ProjectReference>
    <!-- %(GlobalPropertiesToRemove) unqualified: the new item's own, copied from the twin; a
         reference qualified with the source item type evaluates to nothing here (measured: the
         twins lost the reference's removals and became instances of their own). -->
    <ProjectReference Include="@(_AsmGraphRidlessTwin)">
      <GlobalPropertiesToRemove>%(GlobalPropertiesToRemove);RuntimeIdentifier;SelfContained</GlobalPropertiesToRemove>
      <Targets>GetTargetFrameworks</Targets>
      <_AsmGraphOnly>true</_AsmGraphOnly>
      <Private>false</Private>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- The RID outer build's own .asmproj references: it never builds them (each RID build does,
       for its RID; _AsmSkipAsmReferencesInRidOuterBuild), so their edges ask for
       GetTargetFrameworks rather than a build without a RID, for the same reasons as the twins.
       A Targets the project wrote itself is kept. -->
  <ItemGroup Condition="'$(_AsmGraphBuild)' == 'true' and '$(_AsmRid)' == ''">
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Extension', '.asmproj'))">
      <Targets Condition="'%(ProjectReference.Targets)' == '' and '%(ProjectReference._AsmGraphOnly)' != 'true'">GetTargetFrameworks</Targets>
    </ProjectReference>
  </ItemGroup>

  <!--
    _AsmDropGraphOnlyReferences: the references above that exist for the graph alone (the RID
    outer build's to itself, a RID build's twins), which has read them by now. Removed before
    any target runs (an initial target of this project): the outer build visits no .asmproj
    reference (_AsmSkipAsmReferencesInRidOuterBuild), but a RID build would build and link a
    twin like any reference, and a target that reads ProjectReference itself, such as pack's
    dependency list, would take this project for a dependency of itself.
  -->
  <Target Name="_AsmDropGraphOnlyReferences" Condition="'$(_AsmGraphBuild)' == 'true'">
    <ItemGroup>
      <ProjectReference Remove="@(ProjectReference)" Condition="'%(ProjectReference._AsmGraphOnly)' == 'true'" />
    </ItemGroup>
  </Target>

  <!--
    _AsmDropTransitiveCopiesOfOwnReferences: a reference the .NET SDK adds while the build runs
    (IncludeTransitiveProjectReferences, from the assets file restore wrote: such items carry
    NuGetPackageId) that names a project this project references itself goes again, in every
    build. The .NET 10.0.1xx SDKs' NuGet writes an asm project's assets file so that its own
    project references come back as transitive ones (measured with SDK 10.0.101: ObjectsUser's
    one reference became two, its ProjectReference item and "..\ObjectsLib\ObjectsLib.asmproj";
    restored by 11.0.100, one), and the copy got the same outputs again: an object files
    project's objects reached the linker twice, "duplicate symbol: obj_seven", and failed the
    build (an archive twice is harmless, an object twice is not). Compared by full path, since
    the copy is written with backslashes; the project's own item, with its metadata, stays.
    Before _AsmPrepareTransitiveGraphReferences, which then sees only the true transitive ones.
    How: every added reference is taken out and those that are not the project's own are put
    back, by full path, with their metadata (a transform keeps the source item's). A Remove
    conditioned on AnyHaveMetadataValue with the batched path as its argument matched nothing
    (measured with SDK 10.0.101: both items stayed), hence the set operations.
  -->
  <Target Name="_AsmDropTransitiveCopiesOfOwnReferences" AfterTargets="IncludeTransitiveProjectReferences">
    <ItemGroup>
      <_AsmOwnReferencePath Include="@(ProjectReference->'%(FullPath)')" Condition="'%(ProjectReference.NuGetPackageId)' == ''" />
      <_AsmAddedReferencePath Include="@(ProjectReference->'%(FullPath)')" Condition="'%(ProjectReference.NuGetPackageId)' != ''" />
      <_AsmAddedReferenceKept Include="@(_AsmAddedReferencePath)" Exclude="@(_AsmOwnReferencePath)" />
      <ProjectReference Remove="@(ProjectReference)" Condition="'%(ProjectReference.NuGetPackageId)' != ''" />
      <ProjectReference Include="@(_AsmAddedReferenceKept)" />
      <_AsmOwnReferencePath Remove="@(_AsmOwnReferencePath)" />
      <_AsmAddedReferencePath Remove="@(_AsmAddedReferencePath)" />
      <_AsmAddedReferenceKept Remove="@(_AsmAddedReferenceKept)" />
    </ItemGroup>
  </Target>

  <!--
    _AsmPrepareTransitiveGraphReferences: the .asmproj references the .NET SDK adds while the
    build runs (IncludeTransitiveProjectReferences: what the project's references reference, read
    from the assets file restore wrote, such as the static library a static library links) get
    what the evaluation gave the project's own ones above, which they never saw: the RID builds'
    folders and the publish switch removed, and in a RID build its RID. Without it such a
    reference was called with the RID build's OutputPath under -o, an instance the graph never
    built: MSB4252 (measured with SDK 11.0.100 for a static library's own reference, CliGraph's
    ChainProg; and with SDK 10.0.101 for GetTargetFrameworks on a program's direct references,
    which its assets file lists among the transitive ones too, as items of their own).
    The graph predicts a transitive reference through its transitive edges, which lead to the
    instances the referenced projects' own builds reference, with these same global properties.
    Graph builds only (_AsmGraphBuild); right after the .NET SDK adds them, before any reference
    is called (it runs before AssignProjectConfiguration). The references prepared at evaluation
    carry _AsmGraphPrepared and are left as they are.
  -->
  <Target Name="_AsmPrepareTransitiveGraphReferences"
          AfterTargets="IncludeTransitiveProjectReferences"
          Condition="'$(_AsmGraphBuild)' == 'true'">
    <ItemGroup>
      <ProjectReference Condition="'%(ProjectReference.Extension)' == '.asmproj' and '%(ProjectReference._AsmGraphPrepared)' != 'true'">
        <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);$(_AsmGraphReferencePropertiesToRemove)</GlobalPropertiesToRemove>
        <AdditionalProperties Condition="'$(_AsmRid)' != '' and '%(ProjectReference.AdditionalProperties)' == ''">RuntimeIdentifier=$(RuntimeIdentifier)</AdditionalProperties>
        <AdditionalProperties Condition="'$(_AsmRid)' != '' and '%(ProjectReference.AdditionalProperties)' != '' and !$([System.String]::Copy('%(ProjectReference.AdditionalProperties)').Contains('RuntimeIdentifier='))">%(ProjectReference.AdditionalProperties);RuntimeIdentifier=$(RuntimeIdentifier)</AdditionalProperties>
        <_AsmGraphPrepared>true</_AsmGraphPrepared>
      </ProjectReference>
    </ItemGroup>
  </Target>
</Project>
