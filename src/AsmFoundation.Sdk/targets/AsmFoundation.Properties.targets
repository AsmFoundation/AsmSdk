<Project>
  <!--
    AsmFoundation.Properties.targets - imported by Sdk.targets BEFORE Microsoft.NET.Sdk's targets.

    Everything here must be decided before the managed SDK computes its own defaults from the
    same properties: TargetFramework, OutputType, TargetName and TargetFileName are read by
    Microsoft.NET.Sdk.targets and Microsoft.Common.CurrentVersion.targets with "only if empty"
    conditions, so values set here win, and values set after that import would be too late.

    An .asmproj is configured with the properties a .csproj uses. AsmSdk adds names of its own
    only where .NET has no counterpart (the toolchain, packing, AsmProduceStaticLibrary):
      TargetFramework(s)  freestanding | libc: what the code links against (see below)
      RuntimeIdentifier(s) the platforms to build: win-x64, linux-arm64, osx-arm64, ... (below)
      OutputType          Exe | Library | StaticLibrary | Objects
      AssemblyName        base name of the output, named per OS: <name>.dll, lib<name>.so,
                          lib<name>.dylib, <name>.lib or lib<name>.a, <name>.exe or <name>
      DefineConstants     assembler symbols; DEBUG or RELEASE, FREESTANDING or LIBC, and the
                          platform's WINDOWS / LINUX / MACOS, MUSL, X64 / ARM64 are added
      DebugSymbols        debug information in the objects and the output (DWARF, or CodeView
                          and a PDB on Windows); DebugType=none turns it off
      StartupObject       the executable's entry symbol
      LinkerArg items, ExportsFile
                          extra linker arguments and the exports list (NativeAOT's names)

    One pattern recurs below, "capture, then hide": the SDK copies the project's value into an
    internal _Asm* property, then gives the managed SDK the value that keeps it out of the way.
    Left alone, the managed SDK would act on these properties: OutputType=Exe builds an apphost,
    DebugType=portable promises a PDB that nothing writes, and its implicit defines would hand
    NASM -DNETSTANDARD2_0. Footgun: a target of your own that reads OutputType, DebugType or
    DebugSymbols after this file sees the hidden values, not yours.
  -->

  <!--
    The publish profile (dotnet publish -p:PublishProfile=<name>, the project's
    Properties/PublishProfiles/<name>.pubxml), imported here, before anything below reads the
    properties it may set. Microsoft.NET.Sdk imports it in Microsoft.NET.Sdk.BeforeCommon.targets,
    part of its Sdk.targets, which comes after this file: a profile's RuntimeIdentifier then
    arrived after the RID decision below and was ignored (measured: a profile naming linux-x64
    published win-x64, with ASM0013, while its PublishDir was honored). This is .NET's own file,
    imported through the Sdk attribute so that it is the one of the SDK building the project; it
    sets PublishProfileImported when it imports a profile, and BeforeCommon.targets imports it
    only when that property is not true, so a profile is never imported twice.
    Imported early only when the profile file exists, found as that file finds it (an explicit
    WebPublishProfileFile or PublishProfileFullPath, else
    <AppDesignerFolder>/PublishProfiles/<name>.pubxml beside the project): a PublishProfile on
    the command line is a global property that every referenced project sees too, and in a
    project without that profile the file resets PublishProfileImported to false, so
    BeforeCommon.targets imported it a second time (measured: MSB4011 in a referenced
    .asmproj). Where no profile exists, nothing happens here, and BeforeCommon.targets does
    what it always did.
  -->
  <PropertyGroup Condition="'$(PublishProfileImported)' != 'true'">
    <_AsmPublishProfileName Condition="'$(PublishProfileName)' != ''">$(PublishProfileName)</_AsmPublishProfileName>
    <_AsmPublishProfileName Condition="'$(_AsmPublishProfileName)' == '' and '$(PublishProfile)' != ''">$([System.IO.Path]::GetFileNameWithoutExtension('$(PublishProfile)'))</_AsmPublishProfileName>
    <_AsmPublishProfileFile>$(WebPublishProfileFile)</_AsmPublishProfileFile>
    <_AsmPublishProfileFile Condition="'$(_AsmPublishProfileFile)' == ''">$(PublishProfileFullPath)</_AsmPublishProfileFile>
    <_AsmPublishProfileFile Condition="'$(_AsmPublishProfileFile)' == '' and '$(_AsmPublishProfileName)' != ''">$(MSBuildProjectDirectory)/$([MSBuild]::ValueOrDefault('$(AppDesignerFolder)', 'Properties'))/PublishProfiles/$(_AsmPublishProfileName).pubxml</_AsmPublishProfileFile>
    <!-- Visual Studio's publish names the one project it publishes; the file skips the others. -->
    <_AsmPublishProfileFile Condition="'$(ProjectToOverrideProjectExtensionsPath)' != '' and '$(ProjectToOverrideProjectExtensionsPath)' != '$(MSBuildProjectFullPath)'"></_AsmPublishProfileFile>
  </PropertyGroup>
  <Import Project="../targets/Microsoft.NET.Sdk.ImportPublishProfile.targets" Sdk="Microsoft.NET.Sdk"
          Condition="'$(PublishProfileImported)' != 'true' and '$(_AsmPublishProfileFile)' != '' and Exists('$(_AsmPublishProfileFile)')" />

  <!-- ===================================================================================== -->
  <!-- Target framework: freestanding or libc                                                 -->
  <!-- ===================================================================================== -->
  <PropertyGroup>
    <!--
      TargetFramework names what the code is built to run on, the way net10.0 names .NET 10:
        freestanding - the code links no C library: a shared library that needs nothing where
                       it loads (no DT_NEEDED; on Windows kernel32 at most), or an executable
                       entered at _start that makes its own system calls (Linux, static) or
                       calls kernel32 (Windows, whose system call numbers are not stable).
                       macOS has no such executables (ASM0015). The default.
        libc         - the code links the platform's C library, and an executable is an
                       ordinary main(argc, argv) that the SDK's startup code enters:
                         Linux    glibc 2.34+ (libc.so.6; x64 and ARM64) or musl
                                  (libc.musl-x86_64.so.1, libc.musl-aarch64.so.1), a PIE with
                                  the C library's loader
                         macOS    libSystem, started by dyld through LC_MAIN
                         Windows  the Universal C Runtime (ucrtbase.dll, Windows 10+), with
                                  the printf family and atexit from the SDK's wrappers
                       The SDK links against stand-ins it writes itself (see
                       _AsmBuildSystemLibraries), so any build machine builds any RID.
      TargetFrameworks="freestanding;libc" builds the project once per name, into
      bin/<Configuration>/<name>/<rid>/, exactly like a multi-targeted .csproj built per RID.

      Why the default is set here and not in Sdk.props: a TargetFramework set before the
      project body would turn the project's own TargetFrameworks into a single-target build,
      because Microsoft.NET.Sdk multi-targets only when TargetFramework is empty (it decides
      IsCrossTargetingBuild in its Sdk.targets, which is imported after this file).
    -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">freestanding</TargetFramework>
  </PropertyGroup>

  <!--
    The language targets of the outer build of a multi-targeted .asmproj. Microsoft.NET.Sdk's
    Sdk.targets picks LanguageTargets by project extension: a .csproj gets
    Microsoft.CSharp.targets, which switches to its cross-targeting variant in the outer build
    (TargetFrameworks set, TargetFramework empty). Any other extension falls back to
    Microsoft.Common.targets, even in the outer build, which then runs the single-target common
    targets and fails: "Non-CrossTargeting GetTargetFrameworks target should not be used in
    cross targeting (outer) build", plus MSB3644 for .NETFramework v4.0 (measured with SDK
    11.0.100). The outer build of an .asmproj therefore gets MSBuild's own cross-targeting
    targets, the ones the C# variant imports. Inner builds keep the fallback. Set here because
    Microsoft.NET.Sdk reads LanguageTargets only when it is still empty.
  -->
  <PropertyGroup Condition="'$(LanguageTargets)' == '' and '$(TargetFrameworks)' != '' and '$(TargetFramework)' == ''">
    <LanguageTargets>$(MSBuildToolsPath)\Microsoft.Common.CrossTargeting.targets</LanguageTargets>
  </PropertyGroup>

  <!--
    Each name is an alias for a real NuGet framework. Restore, pack and project references
    compare the real frameworks, and two rules decided the mapping (measured with .NET SDK
    11.0.100):
      - The names must map to DIFFERENT frameworks. With one framework behind both, pack
        fails with NU5051 and a .csproj that references the project fails with NU1201.
      - NuGet's compatibility must say what the linker can do: a libc program can link
        freestanding code, but freestanding code cannot link libc code. netstandard1.0 sits
        below netstandard2.0, so freestanding maps to netstandard1.0 and libc to
        netstandard2.0. Then a libc project may reference a freestanding one; a freestanding
        project that references a libc-only one fails at restore with NU1201; and a .NET
        project gets the libc build of a project that targets both (its nearest framework).
    Every .NET implementation accepts both frameworks, so any .csproj can reference any
    .asmproj. Microsoft.NET.Sdk honors a TargetFrameworkIdentifier and TargetFrameworkVersion
    that are already set, so it never tries to parse the alias itself.
    MSBuild compares strings without case, so "Libc" selects libc too.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'freestanding'">
    <_AsmRuntime>Freestanding</_AsmRuntime>
    <TargetFrameworkIdentifier>.NETStandard</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v1.0</TargetFrameworkVersion>
    <!-- The folder name NuGet gives that framework: build/<it>/ and lib/<it>/ in a package. -->
    <_AsmNuGetFramework>netstandard1.0</_AsmNuGetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'libc'">
    <_AsmRuntime>Libc</_AsmRuntime>
    <TargetFrameworkIdentifier>.NETStandard</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v2.0</TargetFrameworkVersion>
    <_AsmNuGetFramework>netstandard2.0</_AsmNuGetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The alias as package folders spell it (native/linux-x64/<it>/), lower case like the
         bin/ and obj/ folders that Microsoft.NET.Sdk names after TargetFramework. -->
    <_AsmTargetFrameworkName>$(TargetFramework.ToLowerInvariant())</_AsmTargetFrameworkName>
    <!-- Microsoft.NET.Sdk warns that netstandard1.x is not recommended (TargetFrameworkIsNotRecommended).
         Nothing managed is built for it: it only stands for freestanding in NuGet's eyes. -->
    <CheckNotRecommendedTargetFramework Condition="'$(CheckNotRecommendedTargetFramework)' == ''">false</CheckNotRecommendedTargetFramework>
  </PropertyGroup>

  <!-- ===================================================================================== -->
  <!-- Output kind and file names                                                             -->
  <!-- ===================================================================================== -->
  <PropertyGroup>
    <!--
      _AsmOutputKind: what the project produces, from OutputType (internal: projects set
      OutputType, as in a .csproj).
        Exe / WinExe   -> Executable     (an ELF executable, no extension)
        Library        -> SharedLibrary  (lib<name>.so; the default, as for a .csproj)
        StaticLibrary  -> StaticLibrary  (lib<name>.a)
        Objects        -> Objects        (object files only, no link step)
      Any other value builds a shared library, as Library does.
    -->
    <_AsmOutputKind Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">Executable</_AsmOutputKind>
    <_AsmOutputKind Condition="'$(OutputType)' == 'StaticLibrary'">StaticLibrary</_AsmOutputKind>
    <_AsmOutputKind Condition="'$(OutputType)' == 'Objects'">Objects</_AsmOutputKind>
    <_AsmOutputKind Condition="'$(_AsmOutputKind)' == ''">SharedLibrary</_AsmOutputKind>

    <!--
      Hidden from the managed SDK: it must never see an executable. OutputType=Exe makes it
      generate an apphost and a runtimeconfig.json for a managed entry point that does not
      exist, and StaticLibrary and Objects are not managed output types at all. The kind is
      already captured in _AsmOutputKind above.
    -->
    <OutputType>Library</OutputType>

    <!--
      PackAsTool: dotnet pack makes a program a .NET tool (dotnet tool install), the package
      kinds the .NET 10 SDK writes for a platform-specific tool: a top-level package that lists
      one package per RID, each holding that RID's program (see AsmFoundation.Pack.targets).
      Captured, then hidden: Microsoft.NET.Sdk would import its own PackTool targets, which stop
      any project that is not .NETCoreApp (NETSDK: "DotnetToolOnlySupportNetcoreapp").
    -->
    <_AsmPackAsTool Condition="'$(PackAsTool)' == 'true'">true</_AsmPackAsTool>
    <PackAsTool Condition="'$(_AsmPackAsTool)' == 'true'">false</PackAsTool>

    <!--
      WebAssembly has no shared libraries that a program loads: a library's module (crc.wasm) is
      for JavaScript, Node or wasmtime to instantiate, while a .NET WebAssembly app links native
      code into its own runtime, statically, and another asm project links an archive too. So a
      Library built for browser-wasm or wasi-wasm also archives its objects by default (the
      archive is what GetAsmLinkInputs hands those consumers). Set AsmProduceStaticLibrary to
      false to ship the module alone. RuntimeIdentifier, not _AsmArch: the RID's facts are
      decomposed further down, and this default must come before the general one below.
    -->
    <AsmProduceStaticLibrary Condition="'$(AsmProduceStaticLibrary)' == '' and '$(_AsmOutputKind)' == 'SharedLibrary' and ('$(RuntimeIdentifier)' == 'browser-wasm' or '$(RuntimeIdentifier)' == 'wasi-wasm')">true</AsmProduceStaticLibrary>

    <!-- Also archive the objects into lib<name>.a next to a shared library, for a library
         that ships both: programs that load it (P/Invoke, dlopen) take the .so, and
         assembly consumers that link statically take the .a. -->
    <AsmProduceStaticLibrary Condition="'$(AsmProduceStaticLibrary)' == ''">false</AsmProduceStaticLibrary>

    <!-- OptionalOnUnlistedRuntimes=true: a .NET project built for a RID that this library does
         not build (and no listed RID serves, by the RID graph) goes on without it, with the
         warning ASM0049, instead of stopping with ASM0040. For code that checks for the library
         and copes without it (DllNotFoundException, NativeLibrary.TryLoad); the default keeps
         the error, so an app never ships without a library by accident. Read by the .NET
         consumer targets through GetAsmConsumerInfo (References.targets). A portable .NET
         build is unaffected: it carries the RIDs the library builds. -->
    <OptionalOnUnlistedRuntimes Condition="'$(OptionalOnUnlistedRuntimes)' == ''">false</OptionalOnUnlistedRuntimes>

    <!-- Default items (declared in Sdk.props): every *.asm (NASM) and *.s (GNU syntax,
         llvm-mc) is a Compile item, as in a .csproj every *.cs is, and every *.inc a None item
         that every source depends on. Which sources build which runtime identifier is decided
         per RID by their file-name qualifiers (see AsmPrepare). .NET's
         EnableDefaultCompileItems=false lists the sources yourself. -->
  </PropertyGroup>

  <!-- ===================================================================================== -->
  <!-- Runtime identifiers: the platforms (OS and CPU) the code is built for                  -->
  <!-- ===================================================================================== -->

  <!--
    RuntimeIdentifiers and RuntimeIdentifier mean what they mean in .NET: the platforms to build
    for, with .NET's names. AsmSdk builds these ten:
      win-x64, win-arm64          PE/COFF (lld-link): Windows PCs and servers
      linux-x64, linux-arm64      ELF (ld.lld), glibc: most servers and containers, Graviton
      linux-musl-x64,             ELF (ld.lld), musl: Alpine containers, on x64 and on ARM64
      linux-musl-arm64
      osx-x64, osx-arm64          Mach-O (ld64.lld): Intel and Apple silicon Macs
      browser-wasm                WebAssembly (wasm-ld): modules for JavaScript, and archives that
                                  a .NET WebAssembly app (Blazor) links into its runtime
      wasi-wasm                   WebAssembly with WASI (wasm-ld): commands for wasmtime and other
                                  WASI hosts, modules, and archives for .NET's WASI apps
    x86-64 code is NASM (.asm); ARM64 code is GNU syntax (.s) for the bundled llvm-mc, and so is
    WebAssembly, in LLVM's WebAssembly assembly (.s files qualified for wasm: name.wasm.s).

    What a project builds, first match wins: the one given with -r; those a referencing project
    asks for on its ProjectReference (RuntimeIdentifiers metadata, which arrives here as the
    global property AsmRequestedRuntimeIdentifiers); the RuntimeIdentifiers it lists (or the one
    RuntimeIdentifier); and with none of these, the build machine's own RID (see
    _AsmBuildMachineRid below; 0.3.0 had no default and stopped with ASM0010 here). ASM0010 is
    left for a build machine that is not one of the eight.

    One build per RID, exactly like `dotnet build -r <rid>`: an inner build with the global
    property RuntimeIdentifier, its outputs in bin/<Configuration>/<TargetFramework>/<rid>/
    (Microsoft.NET.Sdk appends the RID), so that conditions on $(RuntimeIdentifier) work in an
    .asmproj as in a .csproj. Without RuntimeIdentifier, the build is the "RID outer build":
    it builds each RID in turn (see _AsmBuildEachRuntimeIdentifier) and links nothing itself.
  -->
  <!--
    The .NET CLI's use-current-runtime switch (ucr, on dotnet build, run, test, publish, pack
    and restore) is UseCurrentRuntimeIdentifier=true: the build machine's RID, as
    -r <that RID> would give. Microsoft.NET.Sdk turns it into RuntimeIdentifier in
    Microsoft.NET.RuntimeIdentifierInference.targets, part of its Sdk.targets, after the RID
    decision below; it came too late, and the project was built as a RID outer build for its
    default RIDs (measured: a publish and a pack of a project that names no RID warned ASM0013,
    and -o got a win-x64/ folder, which -r win-x64 does not get). The same value .NET gives it,
    set here first. Only when nothing named a RID: -r, a RID-specific referencing project and
    the project's own RuntimeIdentifier keep theirs, as in .NET.
  -->
  <PropertyGroup Condition="'$(UseCurrentRuntimeIdentifier)' == 'true' and '$(RuntimeIdentifier)' == '' and '$(NETCoreSdkPortableRuntimeIdentifier)' != ''">
    <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The project's own list, captured before RuntimeIdentifiers is widened for restore
         below. A lone RuntimeIdentifier in the project counts as a list of one. -->
    <_AsmDeclaredRuntimeIdentifiers>$(RuntimeIdentifiers)</_AsmDeclaredRuntimeIdentifiers>
    <_AsmDeclaredRuntimeIdentifiers Condition="'$(_AsmDeclaredRuntimeIdentifiers)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_AsmDeclaredRuntimeIdentifiers>
    <!-- What the RID outer build builds: a referencing project's request, else the list. -->
    <!-- Commas or semicolons: the consumer targets pass commas, which need no escaping on the
         way through an MSBuild task's AdditionalProperties (a ";" there separates properties).
         Unescape: MSBuild escapes what a property function returns, so the ";" of Replace
         would be "%3B" and the list one item (measured: 1 item instead of 3). -->
    <_AsmBuildRuntimeIdentifiers Condition="'$(AsmRequestedRuntimeIdentifiers)' != ''">$([MSBuild]::Unescape($(AsmRequestedRuntimeIdentifiers.Replace(',', ';'))))</_AsmBuildRuntimeIdentifiers>
    <_AsmBuildRuntimeIdentifiers Condition="'$(_AsmBuildRuntimeIdentifiers)' == ''">$(_AsmDeclaredRuntimeIdentifiers)</_AsmBuildRuntimeIdentifiers>

    <!-- Every RID AsmSdk supports, for messages and for restore. -->
    <_AsmSupportedRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;browser-wasm;wasi-wasm</_AsmSupportedRuntimeIdentifiers>

    <!--
      Restore writes a target per RID into project.assets.json only for the RIDs listed in
      RuntimeIdentifiers, and an inner build with RuntimeIdentifier=<rid> fails with NETSDK1047
      when its target is missing. A project may name no RID and be built for whatever a
      referencing project asks, so restore always lists all ten (it costs nothing: an .asmproj
      has no runtime packs, the two WebAssembly RIDs included). The project's own list was
      captured above.
    -->
    <RuntimeIdentifiers>$(_AsmSupportedRuntimeIdentifiers)</RuntimeIdentifiers>

    <!-- Tell referencing .NET projects to pass their RuntimeIdentifier on: a RID-specific
         consumer then builds (and copies) exactly its platform's binary. -->
    <IsRidAgnostic>false</IsRidAgnostic>
  </PropertyGroup>

  <!-- The RID of this inner build, decomposed. Lower case, as in folder names. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <_AsmRid>$(RuntimeIdentifier.ToLowerInvariant())</_AsmRid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_AsmRid)' == 'win-x64'"><_AsmOs>Windows</_AsmOs><_AsmArch>x64</_AsmArch></PropertyGroup>
  <PropertyGroup Condition="'$(_AsmRid)' == 'win-arm64'"><_AsmOs>Windows</_AsmOs><_AsmArch>arm64</_AsmArch></PropertyGroup>
  <PropertyGroup Condition="'$(_AsmRid)' == 'linux-x64'"><_AsmOs>Linux</_AsmOs><_AsmArch>x64</_AsmArch></PropertyGroup>
  <PropertyGroup Condition="'$(_AsmRid)' == 'linux-arm64'"><_AsmOs>Linux</_AsmOs><_AsmArch>arm64</_AsmArch></PropertyGroup>
  <PropertyGroup Condition="'$(_AsmRid)' == 'linux-musl-x64'"><_AsmOs>Linux</_AsmOs><_AsmArch>x64</_AsmArch><_AsmMusl>true</_AsmMusl></PropertyGroup>
  <PropertyGroup Condition="'$(_AsmRid)' == 'linux-musl-arm64'"><_AsmOs>Linux</_AsmOs><_AsmArch>arm64</_AsmArch><_AsmMusl>true</_AsmMusl></PropertyGroup>
  <PropertyGroup Condition="'$(_AsmRid)' == 'osx-x64'"><_AsmOs>MacOS</_AsmOs><_AsmArch>x64</_AsmArch></PropertyGroup>
  <PropertyGroup Condition="'$(_AsmRid)' == 'osx-arm64'"><_AsmOs>MacOS</_AsmOs><_AsmArch>arm64</_AsmArch></PropertyGroup>
  <!-- WebAssembly: two "operating systems" on one virtual CPU. _AsmArch is wasm for both, the
       switch every WebAssembly-specific step tests; _AsmOs tells the browser from WASI. -->
  <PropertyGroup Condition="'$(_AsmRid)' == 'browser-wasm'"><_AsmOs>Browser</_AsmOs><_AsmArch>wasm</_AsmArch></PropertyGroup>
  <PropertyGroup Condition="'$(_AsmRid)' == 'wasi-wasm'"><_AsmOs>Wasi</_AsmOs><_AsmArch>wasm</_AsmArch></PropertyGroup>
  <!-- The RID's pointer size in bytes, which lays out STRUCT fields of pointers and of size_t and
       its kin (AsmReadStructs, AsmReadApi): 4 on wasm32, 8 on every other RID. -->
  <PropertyGroup Condition="'$(_AsmArch)' != ''">
    <_AsmPointerSize Condition="'$(_AsmArch)' == 'wasm'">4</_AsmPointerSize>
    <_AsmPointerSize Condition="'$(_AsmArch)' != 'wasm'">8</_AsmPointerSize>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      File names per OS, from AssemblyName, the way a .csproj names foo.dll after it
      (Microsoft.NET.Sdk.props has already defaulted AssemblyName to the project name):
        Windows      foo.dll (+ the import library foo.dll.lib), foo.lib, foo.exe
        Linux        libfoo.so, libfoo.a, foo
        macOS        libfoo.dylib, libfoo.a, foo
        WebAssembly  foo.wasm (+ the archive foo.a), foo.a, foo.wasm (browser-wasm, wasi-wasm)
      Unix libraries get the lib prefix because "-lfoo" and .NET's [DllImport("foo")] look for
      it there; Windows looks for foo.dll. The import library of a DLL is foo.dll.lib, as Rust
      names it, so that a project producing both a DLL and a static library (foo.lib) never
      writes two files of one name. TargetFileName is set explicitly because an empty TargetExt
      would otherwise be filled with ".dll" by the common targets. The RID outer build has no
      OS: it gets the Linux names, which nothing there uses.
      WebAssembly names carry no prefix, for .NET: a WebAssembly app's build names a P/Invoke
      module after each NativeFileReference's file name without its extension (.NET 10's
      WasmApp.Common.targets, _GenerateManagedToNative) and matches it against [DllImport] as
      written, so a hand-wired foo.a serves the [DllImport("foo")] that loads foo.dll and
      libfoo.so elsewhere, where libfoo.a would need [DllImport("libfoo")]. (The SDK's own
      consumer targets name the module after AssemblyName whatever the file is called.) A
      module is fetched by its own name (foo.wasm), so it has no prefix either.
    -->
    <_AsmLibraryPrefix Condition="'$(_AsmOs)' != 'Windows' and '$(_AsmArch)' != 'wasm'">lib</_AsmLibraryPrefix>
    <_AsmSharedExtension Condition="'$(_AsmOs)' == 'Windows'">.dll</_AsmSharedExtension>
    <_AsmSharedExtension Condition="'$(_AsmOs)' == 'MacOS'">.dylib</_AsmSharedExtension>
    <_AsmSharedExtension Condition="'$(_AsmArch)' == 'wasm'">.wasm</_AsmSharedExtension>
    <_AsmSharedExtension Condition="'$(_AsmSharedExtension)' == ''">.so</_AsmSharedExtension>
    <_AsmStaticExtension Condition="'$(_AsmOs)' == 'Windows'">.lib</_AsmStaticExtension>
    <_AsmStaticExtension Condition="'$(_AsmStaticExtension)' == ''">.a</_AsmStaticExtension>
    <_AsmExecutableExtension Condition="'$(_AsmOs)' == 'Windows'">.exe</_AsmExecutableExtension>
    <_AsmExecutableExtension Condition="'$(_AsmArch)' == 'wasm'">.wasm</_AsmExecutableExtension>

    <TargetName Condition="'$(TargetName)' == '' and ('$(_AsmOutputKind)' == 'SharedLibrary' or '$(_AsmOutputKind)' == 'StaticLibrary')">$(_AsmLibraryPrefix)$(AssemblyName)</TargetName>
    <TargetName Condition="'$(TargetName)' == ''">$(AssemblyName)</TargetName>
    <TargetFileName Condition="'$(TargetFileName)' == '' and '$(_AsmOutputKind)' == 'SharedLibrary'">$(TargetName)$(_AsmSharedExtension)</TargetFileName>
    <TargetFileName Condition="'$(TargetFileName)' == '' and '$(_AsmOutputKind)' == 'StaticLibrary'">$(TargetName)$(_AsmStaticExtension)</TargetFileName>
    <TargetFileName Condition="'$(TargetFileName)' == ''">$(TargetName)$(_AsmExecutableExtension)</TargetFileName>
  </PropertyGroup>

  <!-- ===================================================================================== -->
  <!-- Preprocessor symbols: DefineConstants                                                  -->
  <!-- ===================================================================================== -->

  <!--
    The configuration symbol, composed exactly as Microsoft.NET.Sdk.CSharp.targets composes
    C#'s: the configuration name in upper case (DEBUG, RELEASE), with "-", "." and " " made
    "_", appended AFTER the project body. So <DefineConstants>FOO</DefineConstants> keeps
    DEBUG, and DisableImplicitConfigurationDefines=true drops it, as in a .csproj. C#'s TRACE
    is not added: it means nothing to assembly code.
  -->
  <PropertyGroup Condition="'$(DisableImplicitConfigurationDefines)' != 'true'">
    <ImplicitConfigurationDefine>$(Configuration.ToUpperInvariant())</ImplicitConfigurationDefine>
    <ImplicitConfigurationDefine>$(ImplicitConfigurationDefine.Replace('-', '_'))</ImplicitConfigurationDefine>
    <ImplicitConfigurationDefine>$(ImplicitConfigurationDefine.Replace('.', '_'))</ImplicitConfigurationDefine>
    <ImplicitConfigurationDefine>$(ImplicitConfigurationDefine.Replace(' ', '_'))</ImplicitConfigurationDefine>
    <DefineConstants>$(DefineConstants);$(ImplicitConfigurationDefine)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The target framework symbol, FREESTANDING or LIBC, the counterpart of the NET10_0 or
      NETSTANDARD2_0 that a .csproj gets: one source can serve both frameworks with
      %ifdef LIBC. DisableImplicitFrameworkDefines=true turns it off, as in .NET.
    -->
    <_AsmImplicitFrameworkDefine Condition="'$(DisableImplicitFrameworkDefines)' != 'true' and '$(_AsmRuntime)' != ''">$(TargetFramework.ToUpperInvariant())</_AsmImplicitFrameworkDefine>
    <DefineConstants Condition="'$(_AsmImplicitFrameworkDefine)' != ''">$(DefineConstants);$(_AsmImplicitFrameworkDefine)</DefineConstants>

    <!--
      The platform symbols of the RID being built, the owner's "And Defines": WINDOWS, LINUX or
      MACOS, MUSL on linux-musl-x64 and linux-musl-arm64 (LINUX too), and X64 or ARM64. They are for what truly
      differs per platform (system calls, the C library's names); the calling convention has the
      SDK's macros instead (asmsdk.inc). The same switch as the framework symbol turns them off.
      WebAssembly gets BROWSER or WASI, and WASM, the same way. They reach a WebAssembly source
      as labels rather than llvm-mc's defsym constants (see AsmPrepare: llvm-mc's wasm object
      writer stops on any constant symbol), so .ifdef WASI works there as everywhere, but a
      define with a value cannot (ASM0018).
    -->
    <_AsmImplicitRuntimeDefines Condition="'$(DisableImplicitFrameworkDefines)' != 'true' and '$(_AsmOs)' != ''">$(_AsmOs.ToUpperInvariant());$(_AsmArch.ToUpperInvariant())</_AsmImplicitRuntimeDefines>
    <_AsmImplicitRuntimeDefines Condition="'$(_AsmImplicitRuntimeDefines)' != '' and '$(_AsmMusl)' == 'true'">$(_AsmImplicitRuntimeDefines);MUSL</_AsmImplicitRuntimeDefines>
    <DefineConstants Condition="'$(_AsmImplicitRuntimeDefines)' != ''">$(DefineConstants);$(_AsmImplicitRuntimeDefines)</DefineConstants>

    <!--
      The SDK's own symbols, also kept apart from DefineConstants, for AsmPrepare to add to
      whatever DefineConstants holds. A DefineConstants given on the command line
      (-p:DefineConstants=X, or a CI script's global property) is read-only: MSBuild silently
      ignores the appends above, and the assemblers got X alone. NASM's asmsdk.inc recognizes
      the platform from the output format, but asmsdk-gnu.inc depends on WINDOWS and MACOS, and
      took the ELF branch on Windows on Arm ("expected absolute expression" at .type, measured
      on CI, 2026-11-23). C# has the same trap (DEBUG and TRACE are lost); for assembly it
      breaks the platform layer, so the SDK keeps its symbols either way.
    -->
    <_AsmImplicitDefineConstants>$(ImplicitConfigurationDefine);$(_AsmImplicitFrameworkDefine);$(_AsmImplicitRuntimeDefines)</_AsmImplicitDefineConstants>

    <!-- Hidden from the managed SDK: its AddImplicitDefineConstants target would append
         NETSTANDARD;NETSTANDARD2_0;... to DefineConstants during the build, and NASM would
         receive every one of them as -D. -->
    <DisableImplicitFrameworkDefines>true</DisableImplicitFrameworkDefines>
  </PropertyGroup>

  <!-- ===================================================================================== -->
  <!-- The platform layer in every source: ImplicitUsings                                     -->
  <!-- ===================================================================================== -->

  <!--
    ImplicitUsings, .NET's switch for "the common imports come for free", the owner's choice for
    plug-and-play sources (2026-11-23). On (enable or true, the default in an .asmproj), every
    source gets the SDK's platform layer before its first line, so a source file is just code:
      NASM (.asm)     include/asmsdk-implicit.inc, as NASM's pre-include (-P): asmsdk.inc (the
                      FUNCTION, ARG1, RETURN, PLT, ... macros), "default rel", and on Linux the
                      .note.GNU-stack section that marks the stack non-executable
      GNU (.s)        include/asmsdk-gnu-implicit.inc, the same for llvm-mc, which has no
                      pre-include option: the SDK assembles a generated file in obj/ that includes
                      it and then the source (see _AsmWriteSourceWrappers). For WebAssembly the
                      file includes asmsdk-wasm.inc instead (FUNCTION with a signature,
                      IMPORT_FUNCTION, ...)
    disable (or false) gives raw sources back: nothing is added, and each file includes what
    it uses, as in 0.3.0 and before. That is the way out for a codebase whose own macros share
    a name with the layer's (FUNCTION, RETURN, ARG1, ...).

    Safe to combine with an explicit %include "asmsdk.inc" or .include "asmsdk-gnu.inc" in a
    source: both files have include guards, so the second inclusion adds nothing. An explicit
    .note.GNU-stack declaration at a file's end is the same declaration again.

    Why the .NET name means something else here: in Microsoft.NET.Sdk, ImplicitUsings adds
    Using items in Microsoft.NET.Sdk.CSharp.props and generates global usings in targets that
    are imported for C# only (Language C#), so in an .asmproj the property is free; this SDK
    gives it the same meaning for assembly.
  -->
  <PropertyGroup>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <_AsmImplicitUsings Condition="'$(ImplicitUsings)' == 'enable' or '$(ImplicitUsings)' == 'true'">true</_AsmImplicitUsings>
  </PropertyGroup>

  <!-- ===================================================================================== -->
  <!-- Debug information: DebugSymbols and DebugType                                          -->
  <!-- ===================================================================================== -->
  <PropertyGroup>
    <!--
      Debug information when DebugSymbols is true and DebugType is not none: DWARF (-g -F dwarf)
      in ELF and Mach-O objects and output, CodeView (-g -F cv8) in Windows objects, from which
      lld-link writes a PDB next to the DLL or EXE. Microsoft.NET.Sdk.props sets
      DebugSymbols=true for Debug, so Debug builds carry it and Release builds do not, unless
      the project says otherwise. Unlike .NET, whose Release builds still write a PDB, Release
      output stays free of debug information by default: the sections only cost size, and a
      shipped binary rarely wants them.
    -->
    <_AsmDebugSymbols Condition="'$(DebugSymbols)' == 'true' and '$(DebugType)' != 'none'">true</_AsmDebugSymbols>
    <_AsmDebugSymbols Condition="'$(_AsmDebugSymbols)' == ''">false</_AsmDebugSymbols>

    <!-- Hidden from the managed SDK: with debug symbols on, it expects a PDB next to the
         output and would try to copy or publish one that nothing writes. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- ===================================================================================== -->
  <!-- Toolchain                                                                              -->
  <!-- ===================================================================================== -->
  <PropertyGroup>
    <!--
      AsmToolchain:
        Bundled - NASM, lld (all three of its linkers), llvm-ar and, from toolchain 0.2.0 on,
                  llvm-mc, from the AsmFoundation.Toolchain.<host> package, downloaded by
                  restore (the default; nothing to install). It builds every supported RID on
                  every build machine.
        System  - nasm, llvm-mc, ld and ar from PATH, or the commands AsmNasmCommand,
                  AsmLlvmMcCommand, AsmLinkerCommand and AsmArchiverCommand name. Needed only
                  for links that require a real sysroot, such as a static glibc executable.
                  GNU ld links Linux output only; Windows and macOS RIDs need
                  AsmLinkerCommand=lld-link or ld64.lld (ASM0005).
    -->
    <AsmToolchain Condition="'$(AsmToolchain)' == ''">Bundled</AsmToolchain>

    <!-- The toolchain package version this SDK release was tested with (generated into the
         package at pack time; see AsmFoundation.Sdk.Version.props). -->
    <AsmToolchainVersion Condition="'$(AsmToolchainVersion)' == ''">$(AsmFoundationDefaultToolchainVersion)</AsmToolchainVersion>

    <!--
      The build machine's RID picks the toolchain package. NETCoreSdkRuntimeIdentifier is the
      .NET SDK's own RID; distribution-built SDKs report it with a distro prefix
      ("ubuntu.24.04-x64"), so it is normalized to the portable form here.
    -->
    <_AsmSdkRid>$(NETCoreSdkRuntimeIdentifier)</_AsmSdkRid>
    <_AsmSdkArch Condition="'$(_AsmSdkRid)' != ''">$(_AsmSdkRid.Substring($([MSBuild]::Add($(_AsmSdkRid.LastIndexOf('-')), 1))))</_AsmSdkArch>
    <!-- A musl machine (Alpine; its own SDK packages report alpine.3.x-x64) keeps "musl" in
         its host RID: LLVM's Linux binaries need glibc and do not run there, so it must not
         be mistaken for linux-x64 (see ASM0006). -->
    <_AsmSdkRidIsMusl Condition="$(_AsmSdkRid.Contains('musl')) or $(_AsmSdkRid.StartsWith('alpine'))">true</_AsmSdkRidIsMusl>
    <AsmHostRid Condition="'$(AsmHostRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-$(_AsmSdkArch)</AsmHostRid>
    <AsmHostRid Condition="'$(AsmHostRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-$(_AsmSdkArch)</AsmHostRid>
    <AsmHostRid Condition="'$(AsmHostRid)' == '' and '$(_AsmSdkRidIsMusl)' == 'true'">linux-musl-$(_AsmSdkArch)</AsmHostRid>
    <AsmHostRid Condition="'$(AsmHostRid)' == ''">linux-$(_AsmSdkArch)</AsmHostRid>

    <!--
      The build machines a toolchain package exists for: those LLVM publishes release binaries
      for. No osx-x64 (LLVM 23.1.5 has no Intel Mac build) and no musl (its Linux binaries need
      glibc): such machines build with AsmToolchain=System, and ASM0006 says so before restore
      fails on a package that does not exist. A project may set AsmHostRid itself, for example
      to linux-x64 on an Alpine machine that has gcompat.
    -->
    <_AsmBundledHostRids>;win-x64;win-arm64;linux-x64;linux-arm64;osx-arm64;</_AsmBundledHostRids>
    <_AsmHostHasBundledToolchain Condition="$(_AsmBundledHostRids.Contains(';$(AsmHostRid);'))">true</_AsmHostHasBundledToolchain>

    <AsmToolchainPackageId>AsmFoundation.Toolchain.$(AsmHostRid)</AsmToolchainPackageId>
    <_AsmExe Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</_AsmExe>
  </PropertyGroup>

  <!--
    The default RID: the build machine's own platform, for a project that names none and that
    nothing asks for. The owner's choice for plug and play (2026-11-23), replacing 0.3.0's
    "no default RID": a bare <Project Sdk="AsmFoundation.Sdk"> now builds, runs and tests on
    the machine at hand, the way a C++ project reference builds for the machine you are on.
    Measured with 0.3.0 before the change, on a new solution: the bare library stopped with
    ASM0010, `dotnet run` of a C# app referencing it too, and a solution build went green while
    the app got no native library at all.

    It is the last fallback, after a referencing project's request and the project's own list
    (see _AsmBuildRuntimeIdentifiers above), so -r, RuntimeIdentifiers and a RID-specific
    consumer decide exactly as before. Computed from the .NET SDK's own RID, normalized like the
    toolchain's host RID, but never from a project's AsmHostRid: that property picks the tools
    (linux-x64 tools on an Alpine machine with gcompat, for one), while the code built by
    default must run on the machine itself (linux-musl-x64 there). A build machine that is not
    one of the eight RIDs (FreeBSD, 32-bit Arm) gets no default, and ASM0010 says so.

    Footgun, warned about: the default ships one platform. A portable "dotnet publish" of a .NET
    app, or "dotnet pack", that carries an asm project built this way warns with ASM0013 (see
    _AsmCheckRuntimeIdentifiers), because the result would lack every other OS's library.
  -->
  <PropertyGroup>
    <_AsmBuildMachineRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-$(_AsmSdkArch)</_AsmBuildMachineRid>
    <_AsmBuildMachineRid Condition="'$(_AsmBuildMachineRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-$(_AsmSdkArch)</_AsmBuildMachineRid>
    <_AsmBuildMachineRid Condition="'$(_AsmBuildMachineRid)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and '$(_AsmSdkRidIsMusl)' == 'true'">linux-musl-$(_AsmSdkArch)</_AsmBuildMachineRid>
    <_AsmBuildMachineRid Condition="'$(_AsmBuildMachineRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-$(_AsmSdkArch)</_AsmBuildMachineRid>
    <_AsmBuildMachineRidSupported Condition="'$(_AsmBuildMachineRid)' != '' and $([System.String]::Copy(';$(_AsmSupportedRuntimeIdentifiers);').Contains(';$(_AsmBuildMachineRid);'))">true</_AsmBuildMachineRidSupported>
    <!-- Recorded, for ASM0013 and the messages: the RIDs below are the default, not a choice. -->
    <_AsmRidsFromBuildMachine Condition="'$(_AsmBuildRuntimeIdentifiers)' == '' and '$(_AsmBuildMachineRidSupported)' == 'true'">true</_AsmRidsFromBuildMachine>
    <_AsmBuildRuntimeIdentifiers Condition="'$(_AsmRidsFromBuildMachine)' == 'true'">$(_AsmBuildMachineRid)</_AsmBuildRuntimeIdentifiers>
  </PropertyGroup>

  <!--
    The implicit reference to this SDK's own package: how a .NET project that references an
    .asmproj gets the consumer targets (buildTransitive/AsmFoundation.Sdk.targets) that copy the
    right native library and list it in deps.json. NuGet carries a referenced project's package
    references to the referencing project, and a package's buildTransitive/ targets with them,
    so the .NET project needs no setup. The package is already in the NuGet cache: the SDK
    resolver put it there to load this very file.
    - The asm project imports the same targets (NuGet imports buildTransitive/ for a direct
      reference too); they do nothing where UsingAsmFoundationSdk is true.
    - Packing removes the dependency again (AsmFoundation.Pack.targets): it would tie every
      consumer of the package to this SDK version (NU1605 on an older one).
    - No version, no reference: an SDK used from a source folder rather than its package has no
      generated version props, and then .NET consumers get no consumer targets.
    - DisableAsmConsumerTargets=true leaves the reference out, for a project whose .NET
      consumers wire the native files themselves; they then get the 0.2.0 behavior back only
      for RID-specific builds (the flat copy), and nothing in deps.json.
  -->
  <ItemGroup Condition="'$(AsmFoundationSdkVersion)' != '' and '$(DisableAsmConsumerTargets)' != 'true'">
    <!-- PrivateAssets spelled out, NuGet's own default: a program makes every other reference
         private (the ItemDefinitionGroup below), and this one must still flow, or a .NET
         project that references only a program would get no consumer targets, and so not the
         program either. -->
    <PackageReference Include="AsmFoundation.Sdk" Version="$(AsmFoundationSdkVersion)" IsImplicitlyDefined="true" PrivateAssets="contentfiles;analyzers;build" />
  </ItemGroup>

  <!--
    A program's references are private by default (PrivateAssets="all", what a ProjectReference
    or PackageReference may say itself): a program takes the libraries and programs it needs
    along (its bundle; see _AsmComputeProgramBundle), so neither a project that references it nor
    its package needs them. Without this, NuGet's transitive project references made a .NET app
    that references a program also reference the program's asm libraries, and deliver them a
    second time, by its own layout (measured: libcalc.so in runtimes/<rid>/native/ besides the
    program's own copy in tools/<rid>/), and the program's package depended on packages whose
    files it already holds. A reference that writes PrivateAssets itself keeps its value.
    MSBuild evaluates item definitions after every property, so _AsmOutputKind is final here.
    A shared library makes only its static library references private, which depends on what
    each referenced project is, so it is decided by a target instead
    (_AsmMakeStaticLibraryReferencesPrivate in References.targets).
  -->
  <ItemDefinitionGroup Condition="'$(_AsmOutputKind)' == 'Executable'">
    <ProjectReference>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <PackageReference>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemDefinitionGroup>

  <!-- Restore downloads the toolchain for this build machine. PackageDownload (not
       PackageReference) because the tools are not a dependency of the project's output. -->
  <ItemGroup Condition="'$(AsmToolchain)' == 'Bundled' and '$(AsmToolchainDirectory)' == '' and '$(AsmToolchainVersion)' != '' and '$(_AsmHostHasBundledToolchain)' == 'true'">
    <PackageDownload Include="$(AsmToolchainPackageId)" Version="[$(AsmToolchainVersion)]" />
  </ItemGroup>

  <!-- ===================================================================================== -->
  <!-- Project checks                                                                         -->
  <!-- ===================================================================================== -->

  <!--
    _AsmCheckProject: fails early, with the fix, on a target framework AsmSdk does not know and
    on settings that AsmFoundation.Sdk 0.1.0 had and 0.2.0 replaced with the .NET properties
    above. There is no compatibility layer: a removed setting would otherwise be ignored
    without a word, and the project would build something else (a forgotten AsmRuntime=Libc
    surfaces only as "undefined symbol: printf" at link time).

    Runs before restore takes the project's package references (CollectPackageReferences runs
    once per target framework during restore) and before the build's configuration check, so
    the error comes first in both "dotnet restore" and "dotnet build". In the outer build of a
    multi-targeted project TargetFramework is empty: the inner builds check each name.

    Errors:
      ASM0003  TargetFramework is neither freestanding nor libc.
      ASM0006  no bundled toolchain exists for this build machine (Intel Mac, musl Linux).
      ASM0100  AsmLibraryName      -> AssemblyName
      ASM0101  AsmRuntime          -> TargetFramework
      ASM0102  AsmDefineConstants  -> DefineConstants
      ASM0103  AsmDefine items     -> DefineConstants
      ASM0104  AsmDebugInfo        -> DebugSymbols / DebugType
      ASM0105  AsmEntryPoint       -> StartupObject
      ASM0106  AsmLinkFlags        -> LinkerArg items and ExportsFile
      ASM0107  AsmOutputKind       -> OutputType
      ASM0109  AsmLinkLibrary items -> NativeLibrary items (NativeAOT's name), after 0.3.0;
               also raised for items a package's props add, which means that package was
               packed by AsmFoundation.Sdk 0.3.0 or older and must be packed again
      ASM0110  AsmSource items     -> Compile items, after 0.3.0
      ASM0111  AsmInclude items    -> None items (an include file is a None item ending in
               .inc; any other extra input of the assembler a CustomAdditionalCompileInputs
               item), after 0.3.0
      ASM0112  EnableDefaultAsmItems -> EnableDefaultCompileItems, after 0.3.0
      ASM0108  the summary that stops the build after any of ASM0100 to ASM0107 or ASM0109 to
               ASM0112 (0108 was the last of the 0.2.0 series, so the later renames went on
               from 0109)
      ASM0025  a Compile item that is not an asm source (.asm for NASM, .s for llvm-mc): an
               .asmproj compiles nothing else, and NASM would read a .c or .cs file as NASM

    The renames after 0.3.0 follow the owner's rule of 2026-11-23: "We discard unnecessary
    *Asm* in favor of preexisting in the ecosystem. No backwards compatibility." An old name is
    an error that shows the new one, never an alias.

    The removed-setting errors use ContinueOnError="ErrorAndContinue" so that one build lists
    every setting to change, instead of one per attempt (an Error task otherwise ends the
    target at the first failure). ErrorAndContinue would also let the build go on to assemble
    and link with the wrong settings, so ASM0108, a plain Error, stops it right after them.
  -->
  <Target Name="_AsmCheckProject"
          BeforeTargets="_CheckForInvalidConfigurationAndPlatform;Restore;CollectPackageReferences">
    <Error Code="ASM0003"
           Condition="'$(TargetFramework)' != '' and '$(_AsmRuntime)' == ''"
           Text="TargetFramework '$(TargetFramework)' is not an AsmSdk target framework. Use freestanding (no C library; the default) or libc (the code links the platform's C library: glibc or musl, libSystem, the UCRT), or TargetFrameworks=freestanding;libc to build both." />
    <Error Code="ASM0006"
           Condition="'$(AsmToolchain)' == 'Bundled' and '$(AsmToolchainDirectory)' == '' and '$(_AsmHostHasBundledToolchain)' != 'true'"
           Text="There is no bundled toolchain for $(AsmHostRid) build machines: LLVM publishes no release binaries for Intel Macs, and its Linux binaries need glibc. Build with &lt;AsmToolchain&gt;System&lt;/AsmToolchain&gt; and the system's nasm, llvm-mc, lld and llvm-ar (Homebrew: nasm llvm lld; Alpine: nasm llvm lld), or set AsmHostRid to a supported machine whose tools run here: win-x64, win-arm64, linux-x64, linux-arm64 or osx-arm64." />

    <PropertyGroup>
      <!-- Any removed setting at all: their values concatenated are empty only when none is set. -->
      <_AsmUsesRemovedSettings Condition="'$(AsmLibraryName)$(AsmRuntime)$(AsmDefineConstants)@(AsmDefine)$(AsmDebugInfo)$(AsmEntryPoint)$(AsmLinkFlags)$(AsmOutputKind)@(AsmLinkLibrary)@(AsmSource)@(AsmInclude)$(EnableDefaultAsmItems)' != ''">true</_AsmUsesRemovedSettings>
    </PropertyGroup>
    <ItemGroup>
      <!-- The packages whose props added AsmLinkLibrary items (AsmPackage metadata, written by
           0.3.0's pack step): named in ASM0109, so the message says which package to repack. -->
      <_AsmStalePackage Include="@(AsmLinkLibrary->'%(AsmPackage)')" Condition="'%(AsmLinkLibrary.AsmPackage)' != ''" />
      <!-- Compile items an asm project cannot assemble, as the project listed them (this runs
           before any target of the build could add one). -->
      <_AsmForeignCompileItem Include="@(Compile)" Condition="'%(Extension)' != '.asm' and '%(Extension)' != '.s'" />
    </ItemGroup>
    <Error Code="ASM0025"
           Condition="'@(_AsmForeignCompileItem)' != ''"
           Text="@(_AsmForeignCompileItem->'%(Identity)', ', ') cannot be compiled by an .asmproj: its Compile items are asm sources, .asm (NASM, x64) or .s (GNU syntax for llvm-mc: ARM64, x64, and WebAssembly in name.wasm.s files). Keep another file in the project as a None item (&lt;None Include=&quot;...&quot; /&gt;), and build C or C# in a project of its own." />

    <Error Code="ASM0100"
           ContinueOnError="ErrorAndContinue"
           Condition="'$(AsmLibraryName)' != ''"
           Text="AsmLibraryName was removed in AsmFoundation.Sdk 0.2.0. Use &lt;AssemblyName&gt;$(AsmLibraryName)&lt;/AssemblyName&gt;: libraries are still named lib&lt;AssemblyName&gt;.so and .a." />
    <Error Code="ASM0101"
           ContinueOnError="ErrorAndContinue"
           Condition="'$(AsmRuntime)' != ''"
           Text="AsmRuntime was removed in AsmFoundation.Sdk 0.2.0. Use &lt;TargetFramework&gt;$(AsmRuntime.ToLowerInvariant())&lt;/TargetFramework&gt; (freestanding or libc), or &lt;TargetFrameworks&gt;freestanding;libc&lt;/TargetFrameworks&gt; to build both." />
    <Error Code="ASM0102"
           ContinueOnError="ErrorAndContinue"
           Condition="'$(AsmDefineConstants)' != ''"
           Text="AsmDefineConstants was removed in AsmFoundation.Sdk 0.2.0. Use &lt;DefineConstants&gt;%24(DefineConstants);$(AsmDefineConstants)&lt;/DefineConstants&gt;. DEBUG or RELEASE, and FREESTANDING or LIBC, are added for you." />
    <Error Code="ASM0103"
           ContinueOnError="ErrorAndContinue"
           Condition="'@(AsmDefine)' != ''"
           Text="AsmDefine items were removed in AsmFoundation.Sdk 0.2.0. Add the symbols to DefineConstants instead: &lt;DefineConstants&gt;%24(DefineConstants);@(AsmDefine)&lt;/DefineConstants&gt;." />
    <Error Code="ASM0104"
           ContinueOnError="ErrorAndContinue"
           Condition="'$(AsmDebugInfo)' != ''"
           Text="AsmDebugInfo was removed in AsmFoundation.Sdk 0.2.0. Use &lt;DebugSymbols&gt;$(AsmDebugInfo)&lt;/DebugSymbols&gt;. Debug builds have it on already, and &lt;DebugType&gt;none&lt;/DebugType&gt; turns it off." />
    <Error Code="ASM0105"
           ContinueOnError="ErrorAndContinue"
           Condition="'$(AsmEntryPoint)' != ''"
           Text="AsmEntryPoint was removed in AsmFoundation.Sdk 0.2.0. Use &lt;StartupObject&gt;$(AsmEntryPoint)&lt;/StartupObject&gt;." />
    <Error Code="ASM0106"
           ContinueOnError="ErrorAndContinue"
           Condition="'$(AsmLinkFlags)' != ''"
           Text="AsmLinkFlags was removed in AsmFoundation.Sdk 0.2.0. Pass each linker argument as a LinkerArg item (&lt;LinkerArg Include=&quot;-z defs&quot; /&gt;), and a version script as &lt;ExportsFile&gt;file.map&lt;/ExportsFile&gt;. AsmLinkFlags was: $(AsmLinkFlags)" />
    <Error Code="ASM0107"
           ContinueOnError="ErrorAndContinue"
           Condition="'$(AsmOutputKind)' != ''"
           Text="AsmOutputKind was removed in AsmFoundation.Sdk 0.2.0. Use OutputType: Exe, Library (a shared library, the default), StaticLibrary or Objects." />
    <Error Code="ASM0109"
           ContinueOnError="ErrorAndContinue"
           Condition="'@(AsmLinkLibrary)' != '' and '@(_AsmStalePackage)' == ''"
           Text="AsmLinkLibrary items were replaced after AsmFoundation.Sdk 0.3.0 by NativeLibrary items, NativeAOT's name for the same link inputs: &lt;NativeLibrary Include=&quot;@(AsmLinkLibrary->'%(Identity)', ';')&quot; /&gt;." />
    <Error Code="ASM0109"
           ContinueOnError="ErrorAndContinue"
           Condition="'@(_AsmStalePackage)' != ''"
           Text="The package @(_AsmStalePackage->Distinct(), ', ') was packed by AsmFoundation.Sdk 0.3.0 or older: its props add AsmLinkLibrary items, which later SDKs replaced with NativeLibrary items. Pack it again with this SDK and reference the new version." />
    <Error Code="ASM0110"
           ContinueOnError="ErrorAndContinue"
           Condition="'@(AsmSource)' != ''"
           Text="AsmSource items were replaced after AsmFoundation.Sdk 0.3.0 by Compile items, .NET's name for the files a project compiles: &lt;Compile Include=&quot;@(AsmSource->'%(Identity)', ';')&quot; /&gt; (and Compile Remove or Update, as in a .csproj). Every *.asm and *.s of the project folder is one already." />
    <Error Code="ASM0111"
           ContinueOnError="ErrorAndContinue"
           Condition="'@(AsmInclude)' != ''"
           Text="AsmInclude items were replaced after AsmFoundation.Sdk 0.3.0 by None items: every source depends on each None item ending in .inc, so an include file from another folder is &lt;None Include=&quot;@(AsmInclude->'%(Identity)', ';')&quot; /&gt;, and any other file a source reads is a CustomAdditionalCompileInputs item. Every *.inc of the project folder is a None item already." />
    <Error Code="ASM0112"
           ContinueOnError="ErrorAndContinue"
           Condition="'$(EnableDefaultAsmItems)' != ''"
           Text="EnableDefaultAsmItems was replaced after AsmFoundation.Sdk 0.3.0 by .NET's EnableDefaultCompileItems: &lt;EnableDefaultCompileItems&gt;$(EnableDefaultAsmItems)&lt;/EnableDefaultCompileItems&gt; turns the default *.asm and *.s Compile items off (the *.inc files are None items, under EnableDefaultNoneItems)." />
    <Error Code="ASM0108"
           Condition="'$(_AsmUsesRemovedSettings)' == 'true'"
           Text="This project uses settings that AsmFoundation.Sdk replaced with the .NET names of the same purpose; the errors above name each replacement. The CHANGELOG lists them all: https://github.com/AsmFoundation/AsmSdk/blob/main/CHANGELOG.md" />
  </Target>
</Project>
