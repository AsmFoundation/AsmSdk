<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Packs AsmFoundation.Sdk, the MSBuild SDK behind <Project Sdk="AsmFoundation.Sdk">.
    Nothing is compiled: the package is MSBuild files (Sdk/, targets/) and assembly stubs
    (stubs/), plus a generated props file that records the toolchain version this SDK release
    was tested with.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>AsmFoundation.Sdk</PackageId>
    <!-- MSBuildSdk: NuGet's SDK resolver will load it for <Project Sdk="..."> and global.json
         "msbuild-sdks"; it is never added as a dependency of anything. -->
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CS2008: nothing to compile (the package is MSBuild files and stubs).
         NU5100: the tasks assembly sits under tasks/, not lib/, on purpose: MSBuild loads it
         with UsingTask, and no project that uses the SDK may reference it. The bindings
         generator sits under bindings/ for the same reason: the consumer targets add it as an
         Analyzer item, and NuGet's own analyzers/ folder would not reach a .NET consumer (the
         implicit SDK reference keeps analyzers private). -->
    <NoWarn>$(NoWarn);NU5128;CS2008;NU5100</NoWarn>
    <Description>Enterprise-grade project, dependency and build management for assembly, on MSBuild and NuGet. The SDK behind .asmproj projects: x64 (NASM) and ARM64 (GNU syntax) assembly built into shared libraries, static libraries and programs for Windows, Linux and macOS with dotnet build, consumed through PackageReference and ProjectReference, and packed with dotnet pack. A C# project that references an .asmproj gets the binary of its platform by .NET's runtime identifier rules. Ships with a bundled NASM + LLVM toolchain, so no assembler or linker needs to be installed.</Description>
    <PackageTags>assembly;nasm;asm;asmproj;msbuild;sdk;native;x86-64;x64;arm64;aarch64;windows;linux;macos;cross-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The AsmFoundation A (src/icon.png, shared by every package of this repository): nuget.org, the IDEs'
         package managers and a nuget.org link's preview show it instead of NuGet's default box. -->
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The toolchain package version comes from toolchain/versions.json, the single source of
      truth that the fetch script uses too. Read with a regular expression because MSBuild has
      no JSON reader; the file's format is under this repository's control.
    -->
    <_ToolchainVersionsJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../toolchain/versions.json'))</_ToolchainVersionsJson>
    <AsmToolchainPackageVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ToolchainVersionsJson), '"packageVersion"\s*:\s*"([^"]+)"').Result('$1'))</AsmToolchainPackageVersion>
    <!-- BaseIntermediateOutputPath (obj/), not IntermediateOutputPath: the latter is only defined
         by the common targets, after this project body, and would be empty here. -->
    <_VersionPropsPath>$(BaseIntermediateOutputPath)AsmFoundation.Sdk.Version.props</_VersionPropsPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Sdk/Sdk.props;Sdk/Sdk.targets" Pack="true" PackagePath="Sdk/" />
    <None Include="targets/*.targets" Pack="true" PackagePath="targets/" />
    <!-- stubs/: the startup code and support sources (.asm for x64, .s for ARM64) and the symbol
         lists the C library stand-ins are written from (*.symbols). -->
    <None Include="stubs/*.asm;stubs/*.s;stubs/*.symbols" Pack="true" PackagePath="stubs/" />
    <!-- include/: asmsdk.inc and its GNU-syntax counterpart; every asm project searches it last. -->
    <None Include="include/*.inc" Pack="true" PackagePath="include/" />
    <None Include="buildTransitive/*.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    The SDK's tasks (AsmFoundation.Sdk.Tasks): built first through the reference, which adds no
    assembly reference (nothing here is compiled), then packed under tasks/netstandard2.0/,
    where the targets' UsingTask looks for them.
  -->
  <ItemGroup>
    <ProjectReference Include="../AsmFoundation.Sdk.Tasks/AsmFoundation.Sdk.Tasks.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="_PackSdkTasks" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <MSBuild Projects="../AsmFoundation.Sdk.Tasks/AsmFoundation.Sdk.Tasks.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmSdkTasksAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_AsmSdkTasksAssembly)" Pack="true" PackagePath="tasks/netstandard2.0/" />
    </ItemGroup>
  </Target>

  <!--
    The C# bindings generator (AsmFoundation.Sdk.Bindings), built the same way and packed under
    bindings/netstandard2.0/, where the consumer targets (buildTransitive) find it. Its
    Microsoft.CodeAnalysis references are the compiler's own at run time: not packed.
  -->
  <ItemGroup>
    <ProjectReference Include="../AsmFoundation.Sdk.Bindings/AsmFoundation.Sdk.Bindings.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="_PackSdkBindings" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <MSBuild Projects="../AsmFoundation.Sdk.Bindings/AsmFoundation.Sdk.Bindings.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_AsmSdkBindingsAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_AsmSdkBindingsAssembly)" Pack="true" PackagePath="bindings/netstandard2.0/" />
    </ItemGroup>
  </Target>

  <!--
    WriteVersionProps: generates Sdk/AsmFoundation.Sdk.Version.props for the package. Sdk.targets
    imports it, so a project that names no AsmToolchainVersion gets the toolchain this SDK was
    released and tested with.
    Error SDK0001: versions.json has no packageVersion.
  -->
  <Target Name="WriteVersionProps" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <Error Code="SDK0001" Condition="'$(AsmToolchainPackageVersion)' == ''" Text="toolchain/versions.json has no &quot;packageVersion&quot;." />
    <PropertyGroup>
      <_VersionProps><![CDATA[<Project>
  <!-- Generated when AsmFoundation.Sdk $(PackageVersion) was packed. -->
  <PropertyGroup>
    <AsmFoundationSdkVersion>$(PackageVersion)</AsmFoundationSdkVersion>
    <AsmFoundationDefaultToolchainVersion>$(AsmToolchainPackageVersion)</AsmFoundationDefaultToolchainVersion>
  </PropertyGroup>
</Project>
]]></_VersionProps>
    </PropertyGroup>
    <WriteLinesToFile File="$(_VersionPropsPath)" Lines="$(_VersionProps)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_VersionPropsPath)" Pack="true" PackagePath="Sdk/AsmFoundation.Sdk.Version.props" />
      <FileWrites Include="$(_VersionPropsPath)" />
    </ItemGroup>
  </Target>
</Project>
