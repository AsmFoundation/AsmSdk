<!--
  TreatAsLocalProperty: the .NET app's publish switches, given on the command line
  (dotnet publish -p:PublishAot=true, -p:PublishTrimmed=true, -p:PublishSingleFile=true,
  -p:PublishReadyToRun=true, the self-contained switch), are global properties, and NuGet's restore
  evaluates every project of the graph with them, asm projects included, where no consumer
  target can remove them first. Microsoft.NET.Sdk then judges them against the asm project's
  netstandard framework and stops the restore: NETSDK1207 "Ahead-of-time compilation is not
  supported for the target framework" for PublishAot, NETSDK1124 "Trimming assemblies requires
  .NET Core 3.0 or higher" for PublishTrimmed (both measured with the .NET 11 SDK). Declared
  here, on the first file of the SDK, the names stop being global for this project from this
  point on: the PropertyGroup below sets them to false, and every later import (all of
  Microsoft.NET.Sdk) sees false. Projects this one builds still inherit the original global
  values; each asm project resets them the same way, and .NET projects keep them.
-->
<Project TreatAsLocalProperty="PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;SelfContained">
  <!--
    AsmFoundation.Sdk - Sdk.props.

    Imported at the top of every project that says <Project Sdk="AsmFoundation.Sdk">, before
    the project's own properties. It turns an .asmproj into a project that behaves like a
    .csproj for everything MSBuild and NuGet already do well (restore, PackageReference,
    ProjectReference, Version, dotnet pack), and switches off everything that assumes a managed
    assembly. The assembling and linking themselves live in Sdk.targets, which runs after the
    project body so that the project's settings are visible there.

    Why ride on Microsoft.NET.Sdk instead of starting from Microsoft.Common.props: restore,
    pack and the solution-level build orchestration are implemented there, and Microsoft's own
    NoTargets SDK shows the pattern is stable across SDK versions. The cost is a handful of
    managed-build switches that must be turned off below, each one documented.
  -->

  <PropertyGroup>
    <!-- Lets packages and Directory.Build.* files detect an asm project. -->
    <UsingAsmFoundationSdk>true</UsingAsmFoundationSdk>

    <!-- The .NET publish switches, made local by TreatAsLocalProperty above: an asm project
         builds native code either way, and these would only make Microsoft.NET.Sdk check (and
         reject) its netstandard framework. A project body that sets one again gets what it
         asked for. -->
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <!-- Root of this SDK package (the folder that holds Sdk/, targets/ and stubs/). -->
    <AsmFoundationSdkDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</AsmFoundationSdkDirectory>

    <!--
      No TargetFramework default here, on purpose. The project's TargetFramework (freestanding
      or libc) or TargetFrameworks is read after the project body, in
      targets/AsmFoundation.Properties.targets, which also defaults it to freestanding. A
      default set here, before the body, would turn a project's TargetFrameworks into a
      single-target build (Microsoft.NET.Sdk multi-targets only when TargetFramework is empty).
      Footgun, as in any .NET project: Directory.Build.props, imported below, sees
      $(TargetFramework) empty unless the project or the command line set it globally.
    -->

    <!-- Item globs of the managed SDK (Compile, EmbeddedResource, None) are not wanted:
         AsmFoundation.Build.targets declares the asm items (AsmSource, AsmInclude) and a None
         glob of its own for every other file. The managed None glob cannot be reused: with
         no language source extension it removes every file it just included. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- No NETStandard.Library reference, no reference assemblies, no assembly info. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <UseAppHost>false</UseAppHost>
    <!--
      DebugType and DebugSymbols are left to Microsoft.NET.Sdk.props and the project, as in a
      .csproj (DebugSymbols=true in Debug). Properties.targets reads them after the project
      body to decide on DWARF, then hides them from the managed SDK so it never expects a PDB.
      Forcing them here, before the body, would also force Debug builds to have no DWARF.
    -->

    <!-- The managed build output does not exist; the native outputs are copied by the
         targets in this SDK, and packed by its own pack step. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <SkipCopyBuildProduct>true</SkipCopyBuildProduct>

    <!--
      Output folders follow .NET: bin/<Configuration>/<TargetFramework>/<RuntimeIdentifier>/
      and obj/<Configuration>/<TargetFramework>/<RuntimeIdentifier>/
      (AppendTargetFrameworkToOutputPath and AppendRuntimeIdentifierToOutputPath keep
      Microsoft.NET.Sdk's defaults). The target framework means something (freestanding or
      libc), every output is built for one RID, and a project built for several needs one
      folder per pair anyway, exactly like `dotnet build -r` of a multi-targeted .csproj.
    -->

    <!--
      NU5128: "some target frameworks of the dependency groups have no exact match in lib/".
      A native package's payload is include/, native/ and runtimes/, which NuGet's framework
      check does not know about; the SDK's pack step adds only an empty lib/<framework>/_._
      marker per framework (see AsmFoundation.Pack.targets).
    -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
</Project>
