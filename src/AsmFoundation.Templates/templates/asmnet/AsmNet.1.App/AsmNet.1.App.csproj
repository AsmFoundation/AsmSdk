<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- [LibraryImport] generates its marshalling code as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds the assembly library and delivers it where .NET loads it from: under
         runtimes/<rid>/native/ in bin/, next to the app in a RID-specific publish. -->
    <ProjectReference Include="../AsmNet.1.Native/AsmNet.1.Native.asmproj" />
  </ItemGroup>

</Project>
