<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds the assembly library and delivers it where .NET loads it from: under
         runtimes/<rid>/native/ in bin/, next to the app in a RID-specific publish. Its PROTO
         lines give this project C# bindings, written by the SDK at build time
         (obj/.../AsmBindings/): nothing to declare by hand, and the SDK turns on the unsafe
         code they need. -->
    <ProjectReference Include="../AsmNet.1.Native/AsmNet.1.Native.asmproj" />
    <!-- The bindings' namespace. Without it, the library's name in PascalCase; named here so
         that it is exactly the one Program.cs uses, whatever the solution is called.
         https://asmfoundation.github.io/AsmSdk/guide/interop.html#generated-bindings -->
    <AsmBindings Include="AsmNet.1.Native" Namespace="AsmNet._1.Native" />
  </ItemGroup>

</Project>
